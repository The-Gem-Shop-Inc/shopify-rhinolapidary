{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rhino-quotation-drafts",
  "main": "../server/epic-k-draft-order/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "vars": {
    "SHOPIFY_SHOP_DOMAIN": "rhino-lapidary.myshopify.com",
    "SHOPIFY_API_VERSION": "2026-10",
    "SHOPIFY_APP_CLIENT_ID": "REPLACE_WITH_DEV_DASHBOARD_CLIENT_ID"
  },
  "d1_databases": [
    {
      "binding": "QUOTE_DB",
      "database_name": "rhino-quotation-drafts",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../migrations/epic-k-draft-order"
    }
  ]
}
