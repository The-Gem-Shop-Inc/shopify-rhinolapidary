{
  "$schema": "../schemas/theme-environments.schema.json",
  "environments": [
    {
      "name": "local",
      "purpose": "Developer local validation",
      "requiresThemeId": false,
      "requiresPreviewUrl": false,
      "production": false
    },
    {
      "name": "preview",
      "purpose": "Shopify preview theme validation",
      "requiresThemeId": true,
      "requiresPreviewUrl": true,
      "production": false
    },
    {
      "name": "production",
      "purpose": "Published customer-facing theme",
      "requiresThemeId": true,
      "requiresPreviewUrl": false,
      "production": true
    }
  ]
}