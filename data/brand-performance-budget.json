{
  "schemaVersion": 1,
  "static": {
    "rhinoCssGzipBytes": 30720,
    "rhinoJsGzipBytes": 10240,
    "rhinoIconSvgBytes": 2048,
    "textureAssetBytes": 30720,
    "externalFontHostCount": 0,
    "synchronousThirdPartyScriptCount": 0,
    "immediateVideoEmbedCount": 0,
    "autoplayMediaCount": 0
  },
  "runtime": {
    "settleMs": 1500,
    "interRunDelayMs": 2500,
    "lcpMs": 2500,
    "cls": 0.1,
    "tbtMs": 200,
    "mobileInitialImageBytes": 512000,
    "desktopInitialImageBytes": 921600,
    "mobileMaxImageBytes": 358400,
    "desktopMaxImageBytes": 512000,
    "immediateVideoIframeCount": 0,
    "autoplayMediaCount": 0,
    "thirdPartyScriptHostCount": 0
  },
  "homepage": {
    "static": {
      "immediateVideoEmbedCount": 0,
      "autoplayMediaCount": 0,
      "synchronousThirdPartyScriptCount": 0
    },
    "runtime": {
      "route": "/",
      "settleMs": 1500,
      "interRunDelayMs": 2500,
      "lcpMs": 2500,
      "cls": 0.1,
      "tbtMs": 200,
      "mobileInitialTransferBytes": 2097152,
      "desktopInitialTransferBytes": 2097152,
      "mobileRequestCount": 130,
      "desktopRequestCount": 130,
      "mobileImageBytes": 512000,
      "desktopImageBytes": 921600,
      "mobileFirstScreenMediaBytes": 358400,
      "desktopFirstScreenMediaBytes": 512000,
      "immediateVideoIframeCount": 0,
      "autoplayMediaCount": 0,
      "thirdPartyScriptHostCount": 0,
      "firstScreenMediaRequiresDimensions": true,
      "noncriticalMediaMustLazyLoad": true
    }
  },
  "globalChrome": {
    "static": {
      "rhinoCssGzipBytes": 30720,
      "rhinoJsGzipBytes": 10240,
      "headerFooterCssGzipBytes": 18432,
      "headerFooterJsGzipBytes": 6144,
      "iconSvgBytes": 20480,
      "iconAssetCount": 30,
      "mediaAssetBytes": 0,
      "localAssetCount": 40,
      "externalResourceHostCount": 0,
      "synchronousThirdPartyScriptCount": 0,
      "immediateVideoEmbedCount": 0,
      "autoplayMediaCount": 0
    },
    "runtime": {
      "mobileMaxResourceCount": 120,
      "desktopMaxResourceCount": 140,
      "maxCssRequestCount": 40,
      "maxJsRequestCount": 40,
      "thirdPartyScriptHostCount": 0,
      "totalTransferBytes": 2097152
    }
  },
  "allowedHostSuffixes": [
    ".myshopify.com",
    ".shopify.com",
    ".shopifycdn.com",
    ".shopifysvc.com"
  ],
  "routes": [
    {
      "name": "homepage",
      "path": "/",
      "required": true
    },
    {
      "name": "collection",
      "env": "TEST_COLLECTION_PATH",
      "fallback": "/collections/all",
      "required": true
    },
    {
      "name": "search",
      "env": "TEST_SEARCH_PATH",
      "fallback": "/search?q=rhino",
      "required": true
    },
    {
      "name": "product",
      "env": "TEST_PRODUCT_PATH",
      "required": true
    },
    {
      "name": "machine-product",
      "env": "TEST_MACHINE_PRODUCT_PATH",
      "required": false
    },
    {
      "name": "consumable-product",
      "env": "TEST_CONSUMABLE_PRODUCT_PATH",
      "required": false
    },
    {
      "name": "replacement-product",
      "env": "TEST_REPLACEMENT_PRODUCT_PATH",
      "required": false
    },
    {
      "name": "cart",
      "path": "/cart",
      "required": true
    },
    {
      "name": "contact",
      "env": "TEST_CONTACT_PATH",
      "fallback": "/pages/contact",
      "required": true
    },
    {
      "name": "policy",
      "env": "TEST_POLICY_PATH",
      "fallback": "/policies/privacy-policy",
      "required": true
    }
  ],
  "machineProduct": {
    "policySource": "docs/qa/rhino-brand-media-performance-budget.md",
    "thresholds": {
      "lcpMs": [
        "runtime.lcpMs"
      ],
      "cls": [
        "runtime.cls"
      ],
      "tbtMs": [
        "runtime.tbtMs"
      ],
      "mobileInitialTransferBytes": [
        "homepage.runtime.mobileInitialTransferBytes",
        "globalChrome.runtime.totalTransferBytes"
      ],
      "desktopInitialTransferBytes": [
        "homepage.runtime.desktopInitialTransferBytes",
        "globalChrome.runtime.totalTransferBytes"
      ],
      "mobileImageBytes": [
        "runtime.mobileInitialImageBytes"
      ],
      "desktopImageBytes": [
        "runtime.desktopInitialImageBytes"
      ],
      "mobileMaxImageBytes": [
        "runtime.mobileMaxImageBytes"
      ],
      "desktopMaxImageBytes": [
        "runtime.desktopMaxImageBytes"
      ],
      "mobileFirstScreenMediaBytes": [
        "homepage.runtime.mobileFirstScreenMediaBytes"
      ],
      "desktopFirstScreenMediaBytes": [
        "homepage.runtime.desktopFirstScreenMediaBytes"
      ],
      "mobileRequestCount": [
        "homepage.runtime.mobileRequestCount",
        "globalChrome.runtime.mobileMaxResourceCount"
      ],
      "desktopRequestCount": [
        "homepage.runtime.desktopRequestCount",
        "globalChrome.runtime.desktopMaxResourceCount"
      ],
      "immediateVideoIframeCount": [
        "runtime.immediateVideoIframeCount"
      ],
      "autoplayMediaCount": [
        "runtime.autoplayMediaCount"
      ],
      "thirdPartyScriptHostCount": [
        "runtime.thirdPartyScriptHostCount"
      ],
      "synchronousThirdPartyScriptCount": [
        "static.synchronousThirdPartyScriptCount"
      ]
    },
    "derivation": "Minimum of referenced approved limits; no threshold exception.",
    "localPolicy": {
      "environment": "local-fixture",
      "runs": 1,
      "throttling": "none-local-fixture",
      "cache": "cold-no-store",
      "settleMsSource": "runtime.settleMs",
      "releaseCertification": false
    },
    "releasePolicy": {
      "minimumMobileRuns": 3,
      "source": "docs/qa/rhino-brand-media-performance-budget.md",
      "throttling": "Slow 4G or explicitly approved mobile profile; record exact parameters",
      "cache": "record cold and warm where supported",
      "settleMsSource": "runtime.settleMs",
      "aggregation": "median",
      "actualThemeIdentityRequired": true,
      "authorizationRequired": true
    }
  }
}
