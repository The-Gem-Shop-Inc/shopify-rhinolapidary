{
  "schemaVersion": "2.2.0",
  "contractId": "EPIC-L-POLICY2-REGISTRATION",
  "status": "PROPOSED",
  "authoritativeSource": "Revision 3 Product Owner decision receipt 2026-11-25; L-DEC-003, L-DEC-004, and L-DEC-009 historical context",
  "runtimeConsumer": "scripts/lib/epic-l-policy2/registration.js; future private registration adapter",
  "customerFacingAuthority": false,
  "identifier": {
    "name": "registrationId",
    "kind": "opaque_random",
    "minimumEntropyBits": 128,
    "format": "CSPRNG_BASE64URL_MIN_16_BYTES",
    "minimumRandomBytes": 16,
    "uuidV4SatisfiesMinimumEntropy": false,
    "mustNotContain": [
      "customer ID",
      "email",
      "order number",
      "serial number",
      "Product GID"
    ],
    "publiclyReadable": true
  },
  "record": {
    "required": [
      "registrationId",
      "customerReference",
      "productGid",
      "variantGid",
      "productVersion",
      "registeredAt",
      "policyVersion",
      "firstUseDeclaration",
      "registrationPath",
      "purchaseEvidence",
      "firstUseEvidence",
      "instructionDeliveryEvidence"
    ],
    "private": [
      "customerReference",
      "ownershipVerification",
      "serialNumber",
      "legacyPhysicalSerialEvidence",
      "purchaseEvidence",
      "firstUseEvidence",
      "instructionDeliveryEvidence",
      "auditTrail"
    ],
    "serialNumber": {
      "meaning": "Historical B02 compatibility field only; Rhino machines do not have physical serial numbers",
      "sameAsRegistrationId": false,
      "normalRequirement": false,
      "duplicateDetectionAuthority": false
    },
    "legacyPhysicalSerialEvidence": {
      "nullable": true,
      "historicalEvidenceOnly": true,
      "duplicateDetectionAuthority": false,
      "requiredFieldsWhenPresent": ["value", "source", "verificationStatus"]
    },
    "registrationPath": {
      "values": ["NEW_REGISTRATION", "PRIOR_PURCHASE_EXCEPTION", "PRIOR_REGISTRATION_EXCEPTION"],
      "exceptionsRemainDistinct": true
    },
    "evidenceCollections": {
      "purchaseEvidence": {
        "acceptedBusinessSource": "THE_GEM_SHOP_PURCHASE_ORDER",
        "shopifyCustomerIdentityAloneIsProof": false
      },
      "firstUseEvidence": {
        "acceptedPotentialSource": "REMOTE_INSPECTION",
        "registrationDateInferredAsFirstUse": false,
        "remoteInspectionRequiredFields": ["inspectionId", "inspectionDate", "reviewerReference", "evidenceReference"]
      },
      "verificationStates": ["SUPPLIED", "PENDING_VERIFICATION", "ACCEPTED_BY_AUTHORIZED_REVIEW", "DISPUTED", "UNAVAILABLE", "EXCEPTION_REVIEW_REQUIRED"],
      "acceptedStateRequiresHumanReview": true
    },
    "firstUseDeclaration": {
      "values": [
        "NOT_STARTED",
        "DECLARED_DATE",
        "UNKNOWN"
      ],
      "legalEffect": "No automatic eligibility denial"
    },
    "instructionDeliveryEvidence": {
      "required": [
        "resourceId",
        "revisionId",
        "deliveredAt",
        "deliveryChannel",
        "deliveryStatus"
      ]
    }
  },
  "states": [
    "RECEIVED",
    "IDENTITY_VERIFICATION_REQUIRED",
    "DUPLICATE_REVIEW",
    "ACKNOWLEDGED",
    "RESOURCE_DELIVERY_PENDING",
    "COMPLETE",
    "RECOVERY_REQUIRED",
    "REJECTED_INVALID_INPUT"
  ],
  "duplicateHandling": {
    "keyCandidates": [
      "explicit prior registration evidence reference",
      "owner-reviewed conflicting ownership evidence"
    ],
    "physicalSerialAuthority": false,
    "sharedPurchaseEvidenceConflatesMachines": false,
    "sameCustomerMayOwnMultipleRegistrations": true,
    "automaticOverwrite": false,
    "idempotentAcknowledgement": true
  },
  "eligibility": {
    "registrationAbsentAutomaticDenial": false,
    "missingPurchaseEvidenceAutomaticDenial": false,
    "registrationCompletionProvesWarrantyEligibility": false,
    "status": "BLOCKED_PENDING_LEGAL_REVIEW"
  },
  "acknowledgement": {
    "contains": [
      "opaque registration ID",
      "recorded machine identity",
      "resource delivery status",
      "support entry point"
    ],
    "finalPolicyLanguagePublished": false
  },
  "qrHandout": {
    "status": "PROPOSED",
    "contentContract": [
      "registration entry URL placeholder",
      "privacy summary placeholder",
      "exact supported machine identity",
      "resource revision pointer",
      "support contact route"
    ],
    "publishAuthorized": false
  },
  "tests": [
    "opaque identifier",
    "explicit prior registration evidence enters review",
    "historical serial does not create a duplicate",
    "multiple registrations may share one customer",
    "migration is idempotent",
    "unverified ownership does not overwrite",
    "delivery failure enters recovery",
    "registration absence does not deny"
  ],
  "contractMigration": {
    "fromVersion": "2.1.0",
    "toVersion": "2.2.0",
    "recordedAt": "2026-11-25",
    "reason": "Apply Revision 3 registration evidence direction without deleting B02 historical fields or changing registration IDs.",
    "supersededText": "Physical serial and verified order-line signals could initiate duplicate review.",
    "replacementText": "Physical serial data is nullable historical evidence; explicit registration evidence and authorized ownership review govern duplicate handling.",
    "businessIntentChanged": true,
    "additive": true,
    "idempotent": true,
    "registrationIdsPreserved": true,
    "historicalDataDiscarded": false,
    "customerFacingAuthorityChanged": false
  }
}
