{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-temporary-quote-mode.schema.json",
  "title": "Epic K temporary shipping quotation checkout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "version", "status", "batch", "parentPbi", "temporaryUntil", "shipping", "pickup", "storefront", "authority"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-temporary-quote-mode" },
    "version": { "const": "1.1.0" },
    "status": { "const": "activation_authorized_operational_evidence_separate" },
    "batch": { "const": "K1C-02-R" },
    "parentPbi": { "const": "K-PBI-003" },
    "temporaryUntil": { "const": "cartonization_and_calculated_shipping_available" },
    "shipping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "intake", "payment", "shippingPriceAtIntake", "freeShippingAllowed", "internationalAllowed", "invoiceBeforeApprovalAllowed"],
      "properties": {
        "route": { "const": "whole_cart_quote_before_payment" },
        "intake": { "const": "shopify_native_contact_form" },
        "payment": { "const": "staff_created_shopify_draft_order_invoice_after_shipping_approval" },
        "shippingPriceAtIntake": { "const": "not_calculated" },
        "freeShippingAllowed": { "const": false },
        "internationalAllowed": { "const": false },
        "invoiceBeforeApprovalAllowed": { "const": false }
      }
    },
    "pickup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationLabel", "shopifyLocationName", "preparationTime", "cartRule", "unknownEligibility", "eligibilityMode", "explicitExclusionsTakePrecedence", "excludedVariantIds", "excludedProductHandles", "inventoryTransferBehavior", "unavailablePreparationBehavior", "eligibilityEvidenceRequirement", "locationReadinessEvidenceRequirement", "currentReadiness"],
      "properties": {
        "locationLabel": { "const": "Grafton" },
        "shopifyLocationName": { "const": "1411 6th Ave" },
        "preparationTime": { "const": "one_business_day_excluding_weekends" },
        "cartRule": { "const": "all_items_require_active_product_live_grafton_availability_and_no_explicit_exclusion" },
        "unknownEligibility": { "const": "blocked" },
        "eligibilityMode": { "const": "active_product_live_grafton_availability_with_explicit_exclusions" },
        "explicitExclusionsTakePrecedence": { "const": true },
        "excludedVariantIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+$" } },
        "excludedProductHandles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "inventoryTransferBehavior": { "const": "not_eligible_for_immediate_pickup" },
        "unavailablePreparationBehavior": { "const": "not_eligible_for_immediate_pickup" },
        "eligibilityEvidenceRequirement": { "const": "K-EVID-001" },
        "locationReadinessEvidenceRequirement": { "const": "K-EVID-002" },
        "currentReadiness": { "const": "live_configuration_must_be_verified_per_cart_operational_receipts_remain_blocked" }
      }
    },
    "storefront": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceleratedCheckoutSuppressed", "cartNotificationRoutesToCart", "cartDrawerRoutesToCart", "emptyCartSubmissionAllowed", "duplicateProtection", "customerDataStorage", "publishedLocaleScope", "unpublishedLocaleWarningsRetained"],
      "properties": {
        "acceleratedCheckoutSuppressed": { "const": true },
        "cartNotificationRoutesToCart": { "const": true },
        "cartDrawerRoutesToCart": { "const": true },
        "emptyCartSubmissionAllowed": { "const": false },
        "duplicateProtection": { "const": "browser_session_reference_and_cart_signature" },
        "customerDataStorage": { "const": "shopify_contact_submission_only" },
        "publishedLocaleScope": { "const": ["en"] },
        "unpublishedLocaleWarningsRetained": { "const": true }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productOwnerApprovalDate", "businessRequirementsAuthorized", "operationalEvidencePromoted", "shopifyMutationAuthorized", "themePublicationAuthorized", "liveCheckoutEnforcementVerified"],
      "properties": {
        "productOwnerApprovalDate": { "const": "2026-10-27" },
        "businessRequirementsAuthorized": { "const": true },
        "operationalEvidencePromoted": { "const": false },
        "shopifyMutationAuthorized": { "const": true },
        "themePublicationAuthorized": { "const": true },
        "liveCheckoutEnforcementVerified": { "const": false }
      }
    }
  }
}
