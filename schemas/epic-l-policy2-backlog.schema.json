{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-backlog.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "authoritativeSource",
    "milestonePolicy",
    "firstImplementationBatch",
    "subsequentEngineeringAuthorizations",
    "engineeringBatches",
    "firstOperationalMilestone",
    "activationGate",
    "remainingBacklog",
    "deferredBoundaries",
    "boundaries",
    "requiredNegativeFixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.3.0"
    },
    "status": {
      "const": "PROPOSED"
    },
    "firstImplementationBatch": {
      "type": "object",
      "required": [
        "mode",
        "allowedPbis",
        "mayBeginBeforeFinalLegalWording",
        "realCustomerDataAllowed",
        "customerPromisePublicationAllowed",
        "activationClaimAllowed"
      ],
      "properties": {
        "mode": {
          "const": "PRIVATE_SYNTHETIC_DATA_ONLY"
        },
        "realCustomerDataAllowed": {
          "const": false
        },
        "customerPromisePublicationAllowed": {
          "const": false
        },
        "activationClaimAllowed": {
          "const": false
        }
      }
    },
    "subsequentEngineeringAuthorizations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["authorizationId", "batchId", "authorizedPbis", "mode", "authorityContract", "originalFirstImplementationBatchUnchanged", "realCustomerDataAllowed", "operationalDecisionIssuanceAllowed", "customerNotificationAllowed"],
            "properties": {
              "authorizationId": { "const": "EPIC-L-POLICY2-B04-AUTHORIZATION-2026-11-23" }, "batchId": { "const": "EPIC-L-POLICY2-B04" }, "authorizedPbis": { "const": ["L-PBI-013"] }, "mode": { "const": "PRIVATE_SYNTHETIC_DATA_ONLY" }, "authorityContract": { "const": "data/epic-l-policy2-warranty-review-contract.json" }, "originalFirstImplementationBatchUnchanged": { "const": true }, "realCustomerDataAllowed": { "const": false }, "operationalDecisionIssuanceAllowed": { "const": false }, "customerNotificationAllowed": { "const": false }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["authorizationId", "batchId", "authorizedPbis", "mode", "authorityContract", "originalFirstImplementationBatchUnchanged", "realCustomerDataAllowed", "operationalDecisionIssuanceAllowed", "customerNotificationAllowed"],
            "properties": {
              "authorizationId": { "const": "EPIC-L-POLICY2-B05-AUTHORIZATION-2026-11-24" }, "batchId": { "const": "EPIC-L-POLICY2-B05" }, "authorizedPbis": { "const": ["L-PBI-009"] }, "mode": { "const": "PRIVATE_SYNTHETIC_DATA_ONLY" }, "authorityContract": { "const": "data/epic-l-policy2-technical-guidance-contract.json" }, "originalFirstImplementationBatchUnchanged": { "const": true }, "realCustomerDataAllowed": { "const": false }, "operationalDecisionIssuanceAllowed": { "const": false }, "customerNotificationAllowed": { "const": false }
            }
          }
        ]
      }
    },
    "engineeringBatches": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["batchId", "status", "progressReceipt", "pbiIds", "testsPassing", "productionInfrastructureSelected", "securityReviewComplete", "operationalOwnerApproval", "legalApproval", "customerActivationPermitted"],
            "properties": {
              "batchId": { "const": "EPIC-L-POLICY2-B01" },
              "status": { "const": "ENGINEERING_FOUNDATION_IMPLEMENTED_SYNTHETIC_ONLY" },
              "progressReceipt": { "const": "data/epic-l-policy2-b01-progress.json" },
              "pbiIds": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["L-PBI-006", "L-PBI-012", "L-PBI-014", "L-PBI-016"] } },
              "testsPassing": { "const": true },
              "productionInfrastructureSelected": { "const": false },
              "securityReviewComplete": { "const": false },
              "operationalOwnerApproval": { "const": false },
              "legalApproval": { "const": false },
              "customerActivationPermitted": { "const": false }
            }
          },
          {
            "type": "object",
            "required": ["batchId", "status", "progressReceipt", "pbiIds", "testsPassing", "productionInfrastructureSelected", "securityReviewComplete", "operationalOwnerApproval", "legalApproval", "customerActivationPermitted"],
            "properties": {
              "batchId": { "const": "EPIC-L-POLICY2-B02" },
              "status": { "const": "ENGINEERING_REGISTRATION_IMPLEMENTED_SYNTHETIC_ONLY" },
              "progressReceipt": { "const": "data/epic-l-policy2-b02-progress.json" },
              "pbiIds": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["L-PBI-004", "L-PBI-005"] } },
              "testsPassing": { "const": true },
              "productionInfrastructureSelected": { "const": false },
              "securityReviewComplete": { "const": false },
              "operationalOwnerApproval": { "const": false },
              "legalApproval": { "const": false },
              "customerActivationPermitted": { "const": false }
            }
          },
          {
            "type": "object",
            "required": ["batchId", "status", "progressReceipt", "pbiIds", "testsPassing", "productionInfrastructureSelected", "securityReviewComplete", "operationalOwnerApproval", "legalApproval", "customerActivationPermitted"],
            "properties": {
              "batchId": { "const": "EPIC-L-POLICY2-B03" },
              "status": { "const": "ENGINEERING_SUPPORT_INTAKE_IMPLEMENTED_SYNTHETIC_ONLY" },
              "progressReceipt": { "const": "data/epic-l-policy2-b03-progress.json" },
              "pbiIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "L-PBI-008" } },
              "testsPassing": { "const": true },
              "productionInfrastructureSelected": { "const": false },
              "securityReviewComplete": { "const": false },
              "operationalOwnerApproval": { "const": false },
              "legalApproval": { "const": false },
              "customerActivationPermitted": { "const": false }
            }
          },
          {
            "type": "object",
            "required": ["batchId", "status", "progressReceipt", "pbiIds", "testsPassing", "productionInfrastructureSelected", "securityReviewComplete", "operationalOwnerApproval", "legalApproval", "customerActivationPermitted"],
            "properties": {
              "batchId": { "const": "EPIC-L-POLICY2-B04" },
              "status": { "const": "ENGINEERING_WARRANTY_REVIEW_GOVERNANCE_IMPLEMENTED_SYNTHETIC_ONLY" },
              "progressReceipt": { "const": "data/epic-l-policy2-b04-progress.json" },
              "pbiIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "L-PBI-013" } },
              "testsPassing": { "const": true },
              "productionInfrastructureSelected": { "const": false },
              "securityReviewComplete": { "const": false },
              "operationalOwnerApproval": { "const": false },
              "legalApproval": { "const": false },
              "customerActivationPermitted": { "const": false }
            }
          },
          {
            "type": "object",
            "required": ["batchId", "status", "progressReceipt", "pbiIds", "testsPassing", "productionInfrastructureSelected", "securityReviewComplete", "operationalOwnerApproval", "legalApproval", "customerActivationPermitted"],
            "properties": {
              "batchId": { "const": "EPIC-L-POLICY2-B05" },
              "status": { "const": "ENGINEERING_TECHNICAL_GUIDANCE_IMPLEMENTED_SYNTHETIC_ONLY" },
              "progressReceipt": { "const": "data/epic-l-policy2-b05-progress.json" },
              "pbiIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "L-PBI-009" } },
              "testsPassing": { "const": true },
              "productionInfrastructureSelected": { "const": false },
              "securityReviewComplete": { "const": false },
              "operationalOwnerApproval": { "const": false },
              "legalApproval": { "const": false },
              "customerActivationPermitted": { "const": false }
            }
          }
        ]
      }
    },
    "firstOperationalMilestone": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "required": [
          "pbiId",
          "sequence",
          "title",
          "status",
          "milestone",
          "minimumOperationalRequirement",
          "syntheticBuildAllowed",
          "realCustomerActivationBlocked",
          "blockingDependencies",
          "activationEvidence"
        ],
        "properties": {
          "pbiId": {
            "pattern": "^L-PBI-\\d{3}$"
          },
          "milestone": {
            "const": "M1_MINIMUM_OPERATIONAL_POLICY2"
          },
          "minimumOperationalRequirement": {
            "const": true
          },
          "realCustomerActivationBlocked": {
            "const": true
          },
          "blockingDependencies": {
            "type": "array",
            "items": {
              "pattern": "^L-PBI-\\d{3}$"
            }
          }
        }
      }
    },
    "activationGate": {
      "type": "object",
      "required": [
        "status",
        "requiredPbis",
        "requiredConditions"
      ],
      "properties": {
        "status": {
          "const": "BLOCKED"
        },
        "requiredPbis": {
          "type": "array",
          "minItems": 17,
          "uniqueItems": true
        }
      }
    },
    "deferredBoundaries": {
      "type": "object",
      "required": [
        "epicOAccountHistory",
        "dealerDirectoryPublication",
        "analytics",
        "comprehensiveRecallInfrastructure",
        "mandatorySeriousSafetyHandling"
      ],
      "properties": {
        "mandatorySeriousSafetyHandling": {
          "const": "M1_REQUIRED"
        }
      }
    },
    "requiredNegativeFixtures": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true
    }
  }
}
