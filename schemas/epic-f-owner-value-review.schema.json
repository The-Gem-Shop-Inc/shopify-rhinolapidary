{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Epic F 006B exact owner-value review; no mutation authority",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "DECISION_PREPARATION_ONLY"
    },
    "mutationAuthorized": {
      "const": false
    },
    "approvalMode": {
      "const": "delegated_development_override"
    },
    "observedAt": {
      "type": "string"
    },
    "sourceBindingSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "label": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "assigned": {
            "type": "boolean"
          }
        },
        "required": [
          "productGid",
          "label",
          "handle",
          "assigned"
        ]
      },
      "minItems": 11,
      "maxItems": 11
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "label"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
