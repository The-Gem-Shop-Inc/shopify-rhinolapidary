        "required": [
          "rowId",
          "decisionId",
          "productGid",
          "productDiagnosticLabel",
          "domain",
          "planId",
          "fieldKey",
          "fieldLabel",
          "canonicalType",
          "canonicalUnit",
          "humanUnit",
          "physicalState",
          "customerReadable",
          "applicability",
          "candidateValues",
          "sourceIds",
          "conflictIds",
          "sourceState",
          "currentOwnerDecision",
          "decisionState",
          "reviewedAt",
          "reviewerRole",
          "decisionOptions",
          "reviewerResponse",
          "notes"
        ]
      }
