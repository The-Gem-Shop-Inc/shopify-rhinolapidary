          },
          "currentOwnerDecision": {
            "type": [
              "string",
              "null"
            ]
          },
          "decisionState": {
            "enum": [
              "PENDING_OWNER",
              "OWNER_CONFIRMED",
              "NOT_APPLICABLE",
              "UNKNOWN_DEFER"
            ]
