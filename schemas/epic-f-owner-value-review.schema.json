                "enum": [
                  null,
                  "APPROVE_CANDIDATE",
                  "SELECT_CANDIDATE",
                  "CORRECT_VALUE",
                  "NOT_APPLICABLE",
                  "UNKNOWN_DEFER"
                ]
              },
              "candidateId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "canonicalValue": {
                "anyOf": [
                  {
                    "type": "null"
