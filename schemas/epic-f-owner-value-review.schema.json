          "reviewedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewerRole": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "decisionOptions": {
            "type": "array",
            "items": {
              "enum": [
                "APPROVE_CANDIDATE",
                "SELECT_CANDIDATE",
                "CORRECT_VALUE",
                "NOT_APPLICABLE",
                "UNKNOWN_DEFER"
              ]
            }
          },
          "reviewerResponse": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": [
                  "string",
                  "null"
