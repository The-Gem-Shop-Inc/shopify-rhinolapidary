          "decisionId": {
            "enum": [
              "B3B-D03",
              "B3B-D05"
            ]
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "productDiagnosticLabel": {
            "type": "string"
