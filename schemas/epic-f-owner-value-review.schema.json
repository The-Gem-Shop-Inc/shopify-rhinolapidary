                },
                "rawValue": {
                  "type": "string"
                },
                "sourceUnit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourceId": {
                  "type": "string"
                },
                "sourceLocation": {
                  "type": "string"
                },
                "canonicalValue": {
                  "anyOf": [
                    {
                      "type": "null"
