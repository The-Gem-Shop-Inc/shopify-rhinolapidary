    "conditionalNotRequested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "fieldKey": {
            "type": "string"
          },
          "applicability": {
            "const": "CONDITIONAL_NOT_ESTABLISHED"
          },
          "reason": {
            "type": "string"
          },
          "decisionState": {
            "const": "UNKNOWN_DEFER"
          },
          "customerActivation": {
            "const": false
          }
        },
        "required": [
          "productGid",
          "fieldKey",
          "applicability",
          "reason",
          "decisionState",
          "customerActivation"
        ]
      }
    },
    "conflictSummaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "conflictId": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "sourceObservations": {
            "type": "string"
          },
          "sourceReferences": {
            "type": "string"
          }
        },
        "required": [
          "conflictId",
          "model",
          "subject",
          "sourceObservations",
          "sourceReferences"
        ]
      }
    },
    "questionsRequired": {
      "type": "integer",
      "minimum": 0
    },
    "ownerConfirmedRows": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "mode",
    "mutationAuthorized",
    "approvalMode",
    "observedAt",
    "sourceBindingSha256",
    "inputs",
    "machines",
    "sources",
    "rows",
    "conditionalNotRequested",
    "conflictSummaries",
    "questionsRequired",
    "ownerConfirmedRows",
    "notes"
