          },
          "planId": {
            "type": "string",
            "pattern": "^E-MUT-0(2[6-9]|3[01])$"
          },
          "fieldKey": {
            "type": "string"
          },
          "fieldLabel": {
            "type": "string"
          },
          "canonicalType": {
            "type": "string"
          },
          "canonicalUnit": {
            "type": [
              "string",
              "null"
            ]
          },
          "humanUnit": {
            "type": "string"
          },
          "physicalState": {
            "type": "string"
          },
          "customerReadable": {
            "type": "boolean"
