            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflictIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3}$"
            }
          },
          "sourceState": {
            "enum": [
              "SINGLE_CONSISTENT_CANDIDATE",
              "MULTIPLE_CONSISTENT_SOURCES",
              "CONFLICT",
              "MISSING",
              "NOT_APPLICABLE",
              "OWNER_CONFIRMED"
