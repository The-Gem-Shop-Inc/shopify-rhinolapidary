                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "volts",
                          "hertz",
                          "horsepower",
                          "revolutions_per_minute",
                          "inches",
                          "pounds",
                          "us_gallons"
                        ]
                      }
                    },
                    "required": [
                      "value",
                      "unit"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "const": "hertz"
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ]
                    }
                  }
                ]
              },
              "applicabilityConfirmed": {
                "type": "boolean"
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewerRole": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": [
                        "Technical",
                        "Operations",
                        "Product Owner"
                      ]
                    }
                  }
                ]
              },
              "reviewedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidenceRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "configurationId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "configurationLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unitQualification": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "physicalStateConfirmed": {
                "type": "boolean"
              },
              "conflictsResolved": {
                "type": "boolean"
              },
              "axisMapping": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "length": {
                        "type": "string"
                      },
                      "width": {
                        "type": "string"
                      },
                      "height": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "length",
                      "width",
                      "height"
                    ]
                  }
                ]
              },
              "includedAssemblies": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fluidState": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "packingRevision": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "action",
              "candidateId",
              "canonicalValue",
              "applicabilityConfirmed",
              "reviewer",
              "reviewerRole",
              "reviewedAt",
              "evidenceRef",
              "sourceId",
              "configurationId",
              "configurationLabel",
              "unitQualification",
              "physicalStateConfirmed",
              "conflictsResolved",
              "axisMapping",
              "includedAssemblies",
              "fluidState",
              "packingRevision"
            ]
          },
          "notes": {
            "type": "string"
          }
