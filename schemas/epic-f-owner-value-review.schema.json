                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "value": {
                          "type": "number",
                          "minimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "volts",
                            "hertz",
                            "horsepower",
                            "revolutions_per_minute",
                            "inches",
                            "pounds",
                            "us_gallons"
                          ]
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "unit": {
                            "const": "hertz"
                          }
                        },
                        "required": [
                          "value",
                          "unit"
                        ]
                      }
                    }
                  ]
                }
