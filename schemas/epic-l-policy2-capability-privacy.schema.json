{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-capability-privacy.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditId",
    "status",
    "auditDate",
    "mode",
    "shopifyMutationPerformed",
    "shop",
    "installedApplications",
    "capabilities",
    "retentionArchitecture",
    "officialReferences",
    "proposedFutureMutations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "status": {
      "const": "COMPLETE"
    },
    "mode": {
      "const": "READ_ONLY"
    },
    "shopifyMutationPerformed": {
      "const": false
    },
    "shop": {
      "type": "object",
      "required": [
        "plan",
        "isPlus"
      ],
      "properties": {
        "plan": {
          "const": "Basic"
        },
        "isPlus": {
          "const": false
        }
      }
    },
    "retentionArchitecture": {
      "type": "object",
      "required": [
        "period",
        "status",
        "recordClasses",
        "marketingConsentSeparate",
        "notificationFailureCannotCloseCase"
      ],
      "properties": {
        "period": {
          "const": "P7Y"
        },
        "marketingConsentSeparate": {
          "const": true
        },
        "notificationFailureCannotCloseCase": {
          "const": true
        }
      }
    }
  }
}
