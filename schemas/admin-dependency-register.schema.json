{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["lastReviewed", "dependencies"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "name",
          "owner",
          "shopifyLocation",
          "purpose",
          "verification",
          "releaseImpact",
          "rollback",
          "relatedPbis",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ADM-\\d{3}$" },
          "area": { "type": "string", "minLength": 2 },
          "name": { "type": "string", "minLength": 2 },
          "owner": { "type": "string", "minLength": 2 },
          "shopifyLocation": { "type": "string", "minLength": 5 },
          "purpose": { "type": "string", "minLength": 10 },
          "verification": {
            "type": "object",
            "required": ["method", "command"],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": ["script", "manual-admin-plus-script", "manual"]
              },
              "command": { "type": "string", "minLength": 2 }
            }
          },
          "releaseImpact": {
            "enum": ["low", "medium", "high", "launch-blocking"]
          },
          "rollback": { "type": "string", "minLength": 10 },
          "relatedPbis": {
            "type": "array",
            "items": { "type": "string", "pattern": "^A-\\d{3}$" }
          },
          "status": {
            "enum": ["proposed", "active", "deferred", "retired"]
          }
        }
      }
    }
  }
}