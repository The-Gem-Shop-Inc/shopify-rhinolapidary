{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Batch 3B persisted artifact shape. Cross-contract identity, provenance and approval invariants are enforced by scripts/lib/epic-e-batch-3b-validation.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputs",
    "mutationAuthorized",
    "facts",
    "conflictCoverage"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "generatedAt": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "mutationAuthorized": {
      "const": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factId",
          "domain",
          "candidateProductModel",
          "physicalState",
          "value",
          "unit",
          "sourceIds",
          "sourceLocation",
          "evidenceDateOrRevision",
          "decisionState",
          "conflictIds",
          "humanReviewRequired",
          "productGid",
          "valueApproved"
        ],
        "properties": {
          "factId": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "candidateProductModel": {
            "type": "string"
          },
          "physicalState": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceLocation": {
            "type": "string"
          },
          "evidenceDateOrRevision": {
            "type": [
              "string",
              "null"
            ]
          },
          "decisionState": {
            "type": "string"
          },
          "conflictIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "humanReviewRequired": {
            "type": "boolean"
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "valueApproved": {
            "type": "boolean"
          }
        }
      }
    },
    "conflictCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflictId",
          "entity",
          "subject",
          "normalizedFamilies",
          "domain",
          "source",
          "fieldKeys",
          "disposition"
        ],
        "properties": {
          "conflictId": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "normalizedFamilies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domain": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "fieldKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "type": "string"
          }
        }
      }
    }
  }
}
