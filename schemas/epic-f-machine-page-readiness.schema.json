{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Epic F source-bound repository readiness; no release grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "assessedAt",
    "scope",
    "repositoryRevision",
    "repositoryRevisionScope",
    "repositoryAggregatePassed",
    "liveReleaseState",
    "evidenceProvenance",
    "machines",
    "domainMatrix",
    "realGrants",
    "adminEvidence",
    "epicE",
    "claims",
    "jsonLd",
    "accessibility",
    "performance",
    "measurement",
    "rollout",
    "historicalDiagnostics",
    "pbiStates",
    "authorizations",
    "actionsPerformed",
    "delta",
    "regression",
    "activationBlockers",
    "releaseBlockers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "assessedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT"
    },
    "scope": {
      "const": "F-PBI-018A repository/static/local-fixture aggregation only"
    },
    "repositoryRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repositoryRevisionScope": {
      "type": "string"
    },
    "repositoryAggregatePassed": {
      "type": "boolean"
    },
    "liveReleaseState": {
      "const": "not_ready_not_authorized"
    },
    "evidenceProvenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "sourceObservedAt",
          "observationKind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceObservedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "observationKind": {
            "enum": [
              "historical_admin",
              "repository_artifact"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "machines": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "productGid",
          "displayLabel",
          "governedClass",
          "classification",
          "evidence",
          "rolloutAssessment",
          "template",
          "historicalProductState",
          "modules",
          "customerPresentation",
          "blockers"
        ],
        "properties": {
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "displayLabel": {
            "type": "string"
          },
          "governedClass": {
            "const": "machine"
          },
          "modules": {
            "type": "array",
            "minItems": 7,
            "items": {
              "$ref": "#/$defs/dimensions"
            },
            "maxItems": 7
          }
        }
      },
      "maxItems": 11
    },
    "domainMatrix": {
      "type": "array",
      "minItems": 19,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/dimensions"
          },
          {
            "type": "object",
            "required": [
              "id",
              "owningPbis",
              "governedFact",
              "decisionIds",
              "upstreamDomains",
              "upstreamPlans",
              "evidenceReferences",
              "presentationScope"
            ],
            "properties": {
              "id": {
                "enum": [
                  "machine_shell",
                  "native_purchase",
                  "contact",
                  "media",
                  "specifications",
                  "contents",
                  "contextual",
                  "delivery",
                  "warranty",
                  "resources",
                  "payment_decision",
                  "accessibility",
                  "performance",
                  "measurement_contract",
                  "measurement_instrumentation",
                  "rollout_plan",
                  "rollout_execution",
                  "claim_containment",
                  "product_json_ld"
                ]
              },
              "owningPbis": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "governedFact": {
                "type": "boolean"
              },
              "decisionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceReferences": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "maxItems": 19
    },
    "realGrants": {
      "type": "object",
      "required": [
        "counts",
        "consumerTotalBefore",
        "consumerTotalCurrent",
        "unexpectedGrants",
        "scope"
      ],
      "properties": {
        "counts": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": [
              "domain",
              "before",
              "current",
              "source"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "before": {
                "type": "integer",
                "minimum": 0
              },
              "current": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "consumerTotalBefore": {
          "type": "integer",
          "minimum": 0
        },
        "consumerTotalCurrent": {
          "type": "integer",
          "minimum": 0
        },
        "unexpectedGrants": {
          "type": "array"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "adminEvidence": {
      "type": "object",
      "required": [
        "state",
        "assessedAt",
        "snapshots",
        "currentAudit",
        "dependentDomains",
        "note"
      ],
      "properties": {
        "state": {
          "enum": [
            "unavailable",
            "stale",
            "current"
          ]
        },
        "snapshots": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "path",
              "observedAt",
              "expiresAt",
              "freshnessRule",
              "coverage",
              "state"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "observedAt": {
                "type": "string"
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "enum": [
                  "unavailable",
                  "stale",
                  "current"
                ]
              }
            }
          }
        }
      }
    },
    "epicE": {
      "type": "object"
    },
    "claims": {
      "type": "object"
    },
    "jsonLd": {
      "type": "object"
    },
    "accessibility": {
      "type": "object"
    },
    "performance": {
      "type": "object"
    },
    "measurement": {
      "type": "object"
    },
    "rollout": {
      "type": "object"
    },
    "historicalDiagnostics": {
      "type": "object"
    },
    "pbiStates": {
      "type": "object"
    },
    "authorizations": {
      "type": "object"
    },
    "actionsPerformed": {
      "type": "object"
    },
    "delta": {
      "type": "object"
    },
    "regression": {
      "type": "array",
      "minItems": 1
    },
    "activationBlockers": {
      "type": "array",
      "minItems": 1
    },
    "releaseBlockers": {
      "type": "array",
      "minItems": 1
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": [
        "implementation",
        "valueState",
        "adminEvidence",
        "migrationReconciliation",
        "activationAuthorization",
        "customerPresentation",
        "shopifyParity",
        "releaseCertification"
      ],
      "properties": {
        "implementation": {
          "enum": [
            "not_started",
            "partial",
            "complete"
          ]
        },
        "valueState": {
          "enum": [
            "not_applicable",
            "missing",
            "proposed",
            "blocked",
            "approved"
          ]
        },
        "adminEvidence": {
          "enum": [
            "not_applicable",
            "unavailable",
            "stale",
            "current"
          ]
        },
        "migrationReconciliation": {
          "enum": [
            "not_applicable",
            "not_started",
            "blocked",
            "unreconciled",
            "reconciled"
          ]
        },
        "activationAuthorization": {
          "enum": [
            "not_applicable",
            "not_granted",
            "granted"
          ]
        },
        "customerPresentation": {
          "enum": [
            "not_applicable",
            "suppressed",
            "active"
          ]
        },
        "shopifyParity": {
          "enum": [
            "not_applicable",
            "unverified",
            "partial",
            "verified"
          ]
        },
        "releaseCertification": {
          "enum": [
            "not_applicable",
            "deferred",
            "blocked",
            "complete"
          ]
        }
      }
    }
  }
}
