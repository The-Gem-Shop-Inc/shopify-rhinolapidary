{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "source",
    "menus",
    "unresolvedDependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved_plan",
        "approved",
        "needs_review"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "menus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/menu"
      }
    },
    "unresolvedDependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    }
  },
  "$defs": {
    "sourceType": {
      "enum": [
        "shopify_navigation",
        "shopify_policy",
        "dynamic_policy",
        "repository_route",
        "theme_route",
        "theme_setting",
        "shopify_account",
        "shopify_localization",
        "external_social",
        "external_shopify_platform",
        "external_business"
      ]
    },
    "itemStatus": {
      "enum": [
        "verified_current",
        "approved",
        "approved_for_launch",
        "planned",
        "blocked",
        "unresolved",
        "deferred",
        "not_approved_current"
      ]
    },
    "menu": {
      "type": "object",
      "required": [
        "id",
        "label",
        "owner",
        "sourceType",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "$ref": "#/$defs/sourceType"
        },
        "adminHandle": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "label",
        "status",
        "owner",
        "targetPath",
        "source",
        "sourceType",
        "requiredForLaunch",
        "dependencies"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/itemStatus"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "targetPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "$ref": "#/$defs/sourceType"
        },
        "requiredForLaunch": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockerId": {
          "type": "string"
        },
        "routeContractId": {
          "type": "string"
        },
        "expectedInRenderedChrome": {
          "type": "boolean"
        },
        "expectedLocations": {
          "type": "array",
          "items": {
            "enum": [
              "header",
              "drawer",
              "mega-menu",
              "footer",
              "policy",
              "utility"
            ]
          }
        },
        "externalAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "footerGroup": {
          "enum": [
            "shop",
            "support",
            "company",
            "policies",
            "utility",
            "platform"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CLAIM-[0-9]{3}$"
          }
        },
        "policyObjectType": {
          "enum": [
            "PRIVACY_POLICY",
            "REFUND_POLICY",
            "TERMS_OF_SERVICE",
            "SHIPPING_POLICY",
            "LEGAL_NOTICE",
            "CONTACT_INFORMATION",
            "ACCESSIBILITY"
          ]
        },
        "supportResourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "id",
        "label",
        "status",
        "owner",
        "description",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "blocked",
            "needs_admin",
            "needs_content",
            "needs_legal",
            "needs_business_review",
            "needs_technical_review"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "blockedItems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
