{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-l-warranty-decision-packet.schema.json",
  "title": "Epic L warranty decision packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "packetVersion",
    "preparedAt",
    "status",
    "authorityEffect",
    "publicationAuthorized",
    "historicalTextApproved",
    "decisionFields",
    "policyVersions",
    "productMappings",
    "unmappedDisposition",
    "requiredApprovals"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packetId": { "const": "epic-l-warranty-decision-packet" },
    "packetVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+-unresolved$" },
    "preparedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["unresolved", "partially_approved", "approved", "retired"] },
    "authorityEffect": { "const": "none_until_owner_approval" },
    "publicationAuthorized": { "const": false },
    "historicalTextApproved": { "const": false },
    "decisionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "administrator",
        "manufacturerSellerRoles",
        "coveredScope",
        "coverageTrigger",
        "duration",
        "effectiveDates",
        "remedies",
        "exclusions",
        "transferability",
        "geography",
        "proofRequirements",
        "registrationEffect",
        "transportResponsibility",
        "supersessionAndReview"
      ],
      "properties": {
        "issuer": { "$ref": "#/$defs/decision" },
        "administrator": { "$ref": "#/$defs/decision" },
        "manufacturerSellerRoles": { "$ref": "#/$defs/decision" },
        "coveredScope": { "$ref": "#/$defs/decision" },
        "coverageTrigger": { "$ref": "#/$defs/decision" },
        "duration": { "$ref": "#/$defs/decision" },
        "effectiveDates": { "$ref": "#/$defs/decision" },
        "remedies": { "$ref": "#/$defs/decision" },
        "exclusions": { "$ref": "#/$defs/decision" },
        "transferability": { "$ref": "#/$defs/decision" },
        "geography": { "$ref": "#/$defs/decision" },
        "proofRequirements": { "$ref": "#/$defs/decision" },
        "registrationEffect": { "$ref": "#/$defs/decision" },
        "transportResponsibility": { "$ref": "#/$defs/decision" },
        "supersessionAndReview": { "$ref": "#/$defs/decision" }
      }
    },
    "policyVersions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/policyVersion" }
    },
    "productMappings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/productMapping" }
    },
    "unmappedDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "publicClaimAllowed", "customerSafeBehavior"],
      "properties": {
        "state": { "const": "blocked" },
        "publicClaimAllowed": { "const": false },
        "customerSafeBehavior": { "type": "string", "minLength": 20 }
      }
    },
    "requiredApprovals": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/approval" }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "status", "value", "requiredOwners", "evidenceRefs", "blockingReason"],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^L-WAR-[0-9]{3}$" },
        "status": { "enum": ["unresolved", "proposed", "approved", "rejected", "retired"] },
        "value": { "type": ["string", "number", "boolean", "array", "object", "null"] },
        "requiredOwners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "blockingReason": { "type": ["string", "null"] }
      }
    },
    "policyVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "version", "status", "effectiveFrom", "effectiveTo", "issuer", "administrator", "evidenceRefs", "approvalIds"],
      "properties": {
        "policyId": { "type": "string", "pattern": "^L-WPOL-[0-9]{3}$" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved", "expired", "revoked", "retired"] },
        "effectiveFrom": { "type": ["string", "null"], "format": "date" },
        "effectiveTo": { "type": ["string", "null"], "format": "date" },
        "issuer": { "type": ["string", "null"] },
        "administrator": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "approvalIds": { "type": "array", "items": { "type": "string", "pattern": "^L-WAPP-[0-9]{3}$" } }
      }
    },
    "productMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingId", "status", "productGid", "variantGids", "policyId", "effectiveFrom", "effectiveTo", "evidenceRefs", "approvalIds"],
      "properties": {
        "mappingId": { "type": "string", "pattern": "^L-WMAP-[0-9]{3}$" },
        "status": { "enum": ["proposed", "approved", "expired", "revoked", "retired"] },
        "productGid": { "type": "string", "pattern": "^gid://shopify/Product/[0-9]+$" },
        "variantGids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^gid://shopify/ProductVariant/[0-9]+$" } },
        "policyId": { "type": "string", "pattern": "^L-WPOL-[0-9]{3}$" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": ["string", "null"], "format": "date" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "approvalIds": { "type": "array", "items": { "type": "string", "pattern": "^L-WAPP-[0-9]{3}$" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "role", "status", "approvedBy", "approvedAt", "evidenceRef"],
      "properties": {
        "approvalId": { "type": "string", "pattern": "^L-WAPP-[0-9]{3}$" },
        "role": { "enum": ["Business", "Legal", "Product Data", "Support", "Product Owner"] },
        "status": { "enum": ["missing", "approved", "rejected", "expired", "revoked"] },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidenceRef": { "type": ["string", "null"] }
      }
    }
  }
}
