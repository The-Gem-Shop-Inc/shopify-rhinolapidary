{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-b03-progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "status",
    "recordedAt",
    "mode",
    "customerFacingAuthority",
    "authoritativeContracts",
    "pbiProgress",
    "testEvidence",
    "readinessBlockers",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "const": "EPIC-L-POLICY2-B03" },
    "status": { "const": "ENGINEERING_SUPPORT_INTAKE_IMPLEMENTED_SYNTHETIC_ONLY" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mode": { "const": "PRIVATE_SYNTHETIC_DATA_ONLY" },
    "customerFacingAuthority": { "const": false },
    "authoritativeContracts": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pbiProgress": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pbiId",
          "engineeringComponentImplemented",
          "testsPassing",
          "productionProcessorApproved",
          "securityReviewApproved",
          "realStaffRoutesApproved",
          "publishedHoursApproved",
          "notificationProviderApproved",
          "customerCopyApproved",
          "operationalOwnerApproval",
          "legalApproval",
          "customerActivationPermitted",
          "deliveredScope",
          "remainingScope"
        ],
        "properties": {
          "pbiId": { "const": "L-PBI-008" },
          "engineeringComponentImplemented": { "const": true },
          "testsPassing": { "const": true },
          "productionProcessorApproved": { "const": false },
          "securityReviewApproved": { "const": false },
          "realStaffRoutesApproved": { "const": false },
          "publishedHoursApproved": { "const": false },
          "notificationProviderApproved": { "const": false },
          "customerCopyApproved": { "const": false },
          "operationalOwnerApproval": { "const": false },
          "legalApproval": { "const": false },
          "customerActivationPermitted": { "const": false },
          "deliveredScope": { "type": "string", "minLength": 1 },
          "remainingScope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactChecks", "domainScenarios", "invalidOperationsRejected", "supportCategoriesExercised", "safetyInterruptionStatesPreserved", "liveProviderCalls"],
      "properties": {
        "artifactChecks": { "type": "integer", "minimum": 10 },
        "domainScenarios": { "type": "integer", "minimum": 30 },
        "invalidOperationsRejected": { "type": "integer", "minimum": 22 },
        "supportCategoriesExercised": { "const": 5 },
        "safetyInterruptionStatesPreserved": { "const": 10 },
        "liveProviderCalls": { "const": 0 }
      }
    },
    "readinessBlockers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
