{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fixtures"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixtureId", "path", "owner", "requiredForLaunch", "source", "validatedBy"],
        "additionalProperties": false,
        "properties": {
          "fixtureId": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" },
          "path": { "type": "string", "pattern": "^/" },
          "owner": { "type": "string", "minLength": 2 },
          "requiredForLaunch": { "type": "boolean" },
          "source": { "enum": ["theme", "shopify-admin", "product-data", "app", "external"] },
          "validatedBy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}