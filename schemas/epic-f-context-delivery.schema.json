{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded F/G relationship and F operational projection input; not an approval registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "machineProductGid",
    "edges",
    "operations",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "machineProductGid": {
      "type": "string",
      "pattern": "^gid://shopify/Product/[0-9]+$"
    },
    "edges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approvalDecisionId",
          "state",
          "audience",
          "lifecycle",
          "activation",
          "sourceIds",
          "effectiveAt",
          "expiresAt",
          "conflictIds",
          "edgeId",
          "dependentProductGid",
          "targetMachineProductGid",
          "meaning",
          "scope",
          "sourceRowId"
        ],
        "properties": {
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "state": {
            "enum": [
              "approved",
              "proposed",
              "blocked"
            ]
          },
          "audience": {
            "enum": [
              "customer",
              "internal"
            ]
          },
          "lifecycle": {
            "enum": [
              "current",
              "stale",
              "deleted"
            ]
          },
          "activation": {
            "enum": [
              "fixture-only",
              "inactive"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "effectiveAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "expiresAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "conflictIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "edgeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "dependentProductGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "targetMachineProductGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "meaning": {
            "enum": [
              "contextual_accessory",
              "contextual_consumable",
              "compatible"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "variantGid",
              "configurationId",
              "label"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "PRODUCT",
                  "PRODUCTVARIANT",
                  "CONFIGURATION"
                ]
              },
              "variantGid": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^gid://shopify/ProductVariant/[0-9]+$"
              },
              "configurationId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          },
          "sourceRowId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approvalDecisionId",
          "state",
          "audience",
          "lifecycle",
          "activation",
          "sourceIds",
          "effectiveAt",
          "expiresAt",
          "conflictIds",
          "recordId",
          "productGid",
          "kind",
          "scope",
          "value"
        ],
        "properties": {
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "state": {
            "enum": [
              "approved",
              "proposed",
              "blocked"
            ]
          },
          "audience": {
            "enum": [
              "customer",
              "internal"
            ]
          },
          "lifecycle": {
            "enum": [
              "current",
              "stale",
              "deleted"
            ]
          },
          "activation": {
            "enum": [
              "fixture-only",
              "inactive"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "effectiveAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "expiresAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "conflictIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "kind": {
            "enum": [
              "region",
              "timing",
              "handling",
              "pickup_scope"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "variantGid",
              "configurationId",
              "label"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "PRODUCT",
                  "PRODUCTVARIANT",
                  "CONFIGURATION"
                ]
              },
              "variantGid": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^gid://shopify/ProductVariant/[0-9]+$"
              },
              "configurationId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          },
          "value": {
            "type": "object"
          }
        }
      }
    },
    "policy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedRoute",
            "resolvedRoute",
            "status",
            "identity",
            "observedAt",
            "expiresAt",
            "environment"
          ],
          "properties": {
            "requestedRoute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "resolvedRoute": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "status": {
              "type": "integer"
            },
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "observedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "expiresAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "environment": {
              "enum": [
                "local-fixture",
                "preview",
                "production"
              ]
            }
          }
        }
      ]
    }
  }
}
