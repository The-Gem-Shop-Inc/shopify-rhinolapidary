{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "successor", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "J1-PRIVATE-EVIDENCE-V1-2026-10-20" },
    "successor": { "const": "J1-EVIDENCE-PORTABILITY-V1-2026-10-20" },
    "entries": {
      "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "originalSha256", "historicalRunIdentifier", "classification", "reason", "mustExistLocally", "absencePermittedInPortableValidation", "safeSummary", "governingSuccessor"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "originalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "historicalRunIdentifier": { "type": "string", "minLength": 1 },
          "classification": { "const": "PRIVATE_AUTHENTICATION_EVIDENCE" },
          "reason": { "type": "string", "minLength": 1 },
          "mustExistLocally": { "const": true },
          "absencePermittedInPortableValidation": { "const": true },
          "safeSummary": { "type": "string", "minLength": 1 },
          "governingSuccessor": { "const": "J1-EVIDENCE-PORTABILITY-V1-2026-10-20" }
        }
      }
    }
  }
}
