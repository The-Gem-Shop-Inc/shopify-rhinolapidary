{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-provisional-decisions.schema.json",
  "title": "Epic K provisional decision contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "version",
    "status",
    "recordedAt",
    "authority",
    "boundPbis",
    "decisions",
    "boundaries",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-provisional-decisions" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+-provisional$" },
    "status": { "const": "provisional" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceDate", "approvalEffect"],
      "properties": {
        "sourceType": { "const": "user_supplied_provisional_decision_record" },
        "sourceDate": { "type": "string", "format": "date" },
        "approvalEffect": { "const": "does_not_constitute_final_business_approval" }
      }
    },
    "boundPbis": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["K-PBI-001", "K-PBI-002"] }
    },
    "decisions": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "statement", "owners", "dependencies", "implementationEffect"],
        "properties": {
          "id": { "type": "string", "pattern": "^K-DEC-[0-9]{3}$" },
          "status": { "const": "provisional" },
          "statement": { "type": "string", "minLength": 12 },
          "owners": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "implementationEffect": { "const": "repository_policy_input_only" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shopifyMutationAuthorized",
        "themeMutationAuthorized",
        "customerFacingChangeAuthorized",
        "checkoutEnforcementEstablished",
        "operationalReadinessEstablished"
      ],
      "properties": {
        "shopifyMutationAuthorized": { "const": false },
        "themeMutationAuthorized": { "const": false },
        "customerFacingChangeAuthorized": { "const": false },
        "checkoutEnforcementEstablished": { "const": false },
        "operationalReadinessEstablished": { "const": false }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["Epic E", "Epic F", "Epic J", "Epic L"] }
    }
  }
}
