{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authority",
        "mode",
        "grants",
        "note"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "authority": {
          "const": "F-DEC-002"
        },
        "mode": {
          "const": "suppressed"
        },
        "grants": {
          "type": "array",
          "maxItems": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authority",
        "mode",
        "observedAt",
        "grants",
        "note"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "authority": {
          "const": "F-DEC-002-DEV"
        },
        "mode": {
          "const": "development-current-product"
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productGid",
              "mediaGid",
              "mediaType",
              "status",
              "fileStatus",
              "sourceUrl",
              "width",
              "height",
              "alt",
              "mediaUpdatedAt",
              "audience",
              "approvalMode",
              "observedAt",
              "decisionId",
              "visualReview",
              "finalLaunchApproved"
            ],
            "properties": {
              "productGid": {
                "type": "string",
                "pattern": "^gid://shopify/Product/[0-9]+$"
              },
              "mediaGid": {
                "type": "string",
                "pattern": "^gid://shopify/MediaImage/[0-9]+$"
              },
              "mediaType": {
                "const": "IMAGE"
              },
              "status": {
                "const": "READY"
              },
              "fileStatus": {
                "const": "READY"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://cdn\\.shopify\\.com/"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "mediaUpdatedAt": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "const": "customer-development"
              },
              "approvalMode": {
                "const": "delegated_development_override"
              },
              "observedAt": {
                "type": "string",
                "minLength": 1
              },
              "decisionId": {
                "const": "F-DEC-002-DEV"
              },
              "visualReview": {
                "const": "docs/qa/evidence/epic-f/004b-live-media-2026-10-10/visual-media-review.json"
              },
              "finalLaunchApproved": {
                "const": false
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
