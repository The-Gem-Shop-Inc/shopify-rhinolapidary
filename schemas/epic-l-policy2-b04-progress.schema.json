{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-b04-progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "status", "recordedAt", "mode", "customerFacingAuthority", "engineeringAuthorization", "authoritativeContracts", "pbiProgress", "testEvidence", "readinessBlockers", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "const": "EPIC-L-POLICY2-B04" },
    "status": { "const": "ENGINEERING_WARRANTY_REVIEW_GOVERNANCE_IMPLEMENTED_SYNTHETIC_ONLY" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mode": { "const": "PRIVATE_SYNTHETIC_DATA_ONLY" },
    "customerFacingAuthority": { "const": false },
    "engineeringAuthorization": { "const": "EPIC-L-POLICY2-B04-AUTHORIZATION-2026-11-23" },
    "authoritativeContracts": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "pbiProgress": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pbiId", "engineeringComponentImplemented", "testsPassing", "productionProcessorApproved", "productionAuthorityResolverApproved", "realHumanAuthorityApproved", "policyApplicabilityApproved", "coverageApprovalComplete", "securityReviewApproved", "operationalOwnerApproval", "legalApproval", "customerDecisionIssuancePermitted", "customerNotificationPermitted", "customerActivationPermitted", "deliveredScope", "remainingScope"],
        "properties": {
          "pbiId": { "const": "L-PBI-013" },
          "engineeringComponentImplemented": { "const": true },
          "testsPassing": { "const": true },
          "productionProcessorApproved": { "const": false },
          "productionAuthorityResolverApproved": { "const": false },
          "realHumanAuthorityApproved": { "const": false },
          "policyApplicabilityApproved": { "const": false },
          "coverageApprovalComplete": { "const": false },
          "securityReviewApproved": { "const": false },
          "operationalOwnerApproval": { "const": false },
          "legalApproval": { "const": false },
          "customerDecisionIssuancePermitted": { "const": false },
          "customerNotificationPermitted": { "const": false },
          "customerActivationPermitted": { "const": false },
          "deliveredScope": { "type": "string", "minLength": 1 },
          "remainingScope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactChecks", "domainScenarios", "invalidOperationsRejected", "reviewStates", "explicitTransitions", "liveProviderCalls", "customerDecisionsIssued", "customerNotificationsSent"],
      "properties": {
        "artifactChecks": { "const": 12 },
        "domainScenarios": { "minimum": 34 },
        "invalidOperationsRejected": { "minimum": 33 },
        "reviewStates": { "const": 11 },
        "explicitTransitions": { "const": 47 },
        "liveProviderCalls": { "const": 0 },
        "customerDecisionsIssued": { "const": 0 },
        "customerNotificationsSent": { "const": 0 }
      }
    },
    "readinessBlockers": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 9, "items": { "type": "string", "minLength": 1 } }
  }
}
