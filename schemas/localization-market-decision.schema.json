{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "evidenceDate",
    "source",
    "themeIds",
    "themeSelectorSettings",
    "adminEvidence",
    "decision",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "approved_plan",
        "blocked_needs_business_review",
        "needs_review"
      ]
    },
    "evidenceDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "themeIds": {
      "type": "object",
      "required": [
        "preview",
        "production"
      ],
      "additionalProperties": false,
      "properties": {
        "preview": {
          "const": "158631198917"
        },
        "production": {
          "const": "158579622085"
        }
      }
    },
    "themeSelectorSettings": {
      "type": "object",
      "required": [
        "header",
        "footer"
      ],
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/selectorSettings"
        },
        "footer": {
          "$ref": "#/$defs/selectorSettings"
        }
      }
    },
    "adminEvidence": {
      "type": "object",
      "required": [
        "currencyCode",
        "enabledPresentmentCurrencies",
        "shipsToCountries",
        "publishedLanguages",
        "webPresences",
        "customerAccounts"
      ],
      "additionalProperties": false,
      "properties": {
        "currencyCode": {
          "type": "string",
          "minLength": 3
        },
        "enabledPresentmentCurrencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "shipsToCountries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "publishedLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "webPresences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "defaultLocale",
              "alternateLocales",
              "rootUrlHosts",
              "markets"
            ],
            "additionalProperties": false,
            "properties": {
              "defaultLocale": {
                "$ref": "#/$defs/locale"
              },
              "alternateLocales": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/locale"
                }
              },
              "rootUrlHosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "markets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "handle",
                    "status",
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "handle": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "customerAccounts": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "countrySelectorLaunchState",
        "languageSelectorLaunchState",
        "visibleInternationalWordingApproved",
        "approvedInternationalWording",
        "marketSafeLabelRule",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "countrySelectorLaunchState": {
          "enum": [
            "conditional_shopify_rendered_only",
            "disabled",
            "blocked_pending_market_safety_review"
          ]
        },
        "languageSelectorLaunchState": {
          "enum": [
            "conditional_shopify_rendered_only",
            "disabled",
            "blocked_pending_market_safety_review"
          ]
        },
        "visibleInternationalWordingApproved": {
          "type": "boolean"
        },
        "approvedInternationalWording": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marketSafeLabelRule": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "selectorSettings": {
      "type": "object",
      "required": [
        "enableCountrySelector",
        "enableLanguageSelector",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "enableCountrySelector": {
          "type": "boolean"
        },
        "enableLanguageSelector": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locale": {
      "type": "object",
      "required": [
        "locale",
        "name",
        "primary",
        "published"
      ],
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        }
      }
    }
  }
}
