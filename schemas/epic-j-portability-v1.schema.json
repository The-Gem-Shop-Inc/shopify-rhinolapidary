{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "predecessor", "privateManifest", "privateSchema", "requiredFiles", "disposableFiles", "implementation", "evidenceDirectory", "executionOutputRoot", "receiptExpiresAt", "authorization"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "J1-EVIDENCE-PORTABILITY-V1-2026-10-20" },
    "predecessor": { "$ref": "#/definitions/identity" },
    "privateManifest": { "$ref": "#/definitions/identity" },
    "privateSchema": { "$ref": "#/definitions/identity" },
    "evidenceDirectory": { "type": "string", "minLength": 1 },
    "executionOutputRoot": { "type": "string", "minLength": 1 },
    "receiptExpiresAt": { "const": "2026-10-22T20:26:37.102Z" },
    "authorization": { "const": "REPOSITORY_GOVERNANCE_AND_TESTING_ONLY_NO_GIT_OR_SHOPIFY_WRITES" },
    "requiredFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/requiredFile" } },
    "disposableFiles": { "type": "array", "items": { "$ref": "#/definitions/disposable" } },
    "implementation": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/identity" } }
  },
  "definitions": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "requiredFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "classification", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "classification": { "enum": ["PROTECTED_APPLICATION_SOURCE", "PUBLIC_REPOSITORY_EVIDENCE"] }, "reason": { "type": "string", "minLength": 1 }
      }
    },
    "disposable": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "classification", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "classification": { "const": "DISPOSABLE_EXECUTION_OUTPUT" }, "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
