{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "contentItems"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "contentItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "moduleId",
          "contentClass",
          "proposedPurpose",
          "source",
          "sourceOwner",
          "approver",
          "approvalStatus",
          "sensitivities",
          "legalClaimIds",
          "safeNeutralFallback",
          "blocker"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "moduleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "contentClass": {
            "enum": [
              "current_intro",
              "first_screen_hero_promise",
              "why_rhino_proof",
              "machine_product_statement",
              "support",
              "warranty",
              "freight",
              "shipping",
              "pickup",
              "financing",
              "testimonial",
              "review",
              "video_demo_description",
              "dealer",
              "institutional",
              "education_buying_guide",
              "cta_label"
            ]
          },
          "proposedPurpose": { "type": "string", "minLength": 2 },
          "source": { "type": "string", "minLength": 2 },
          "sourceOwner": { "type": "string" },
          "approver": { "type": "string" },
          "approvalStatus": {
            "enum": [
              "approved",
              "observed",
              "draft",
              "blocked",
              "unknown"
            ]
          },
          "sensitivities": {
            "type": "array",
            "items": {
              "enum": [
                "legal",
                "operational",
                "product",
                "support",
                "media",
                "privacy",
                "performance",
                "none"
              ]
            },
            "minItems": 1
          },
          "legalClaimIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CLAIM-[0-9]{3}$" }
          },
          "safeNeutralFallback": {
            "type": ["string", "null"]
          },
          "blocker": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
