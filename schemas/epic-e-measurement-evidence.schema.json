{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Batch 3B persisted artifact shape. Cross-contract identity, provenance and approval invariants are enforced by scripts/lib/epic-e-batch-3b-validation.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputs",
    "mutationAuthorized",
    "packingObservations",
    "coverage",
    "nativeShippingWeights",
    "statistics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "generatedAt": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "mutationAuthorized": {
      "const": false
    },
    "packingObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "location",
          "productGid",
          "rawCells",
          "physicalColumns",
          "state",
          "blocker"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "rawCells": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cell",
                "value"
              ],
              "properties": {
                "cell": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "physicalColumns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "C",
              "D",
              "E",
              "F",
              "G"
            ],
            "properties": {
              "C": {
                "type": "string"
              },
              "D": {
                "type": "string"
              },
              "E": {
                "type": "string"
              },
              "F": {
                "type": "string"
              },
              "G": {
                "type": "string"
              }
            }
          },
          "state": {
            "type": "string"
          },
          "blocker": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productGid",
          "handle",
          "productClass",
          "variantGids",
          "factIds",
          "packingLocations",
          "missingApprovedStates",
          "packages",
          "descriptionMeasurementExcerpts",
          "missingEvidenceStates"
        ],
        "properties": {
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "handle": {
            "type": "string"
          },
          "productClass": {
            "type": "string"
          },
          "variantGids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packingLocations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missingApprovedStates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packages": {
            "type": "array",
            "items": {}
          },
          "descriptionMeasurementExcerpts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "excerpt",
                "sourceLocation",
                "physicalState"
              ],
              "properties": {
                "excerpt": {
                  "type": "string"
                },
                "sourceLocation": {
                  "type": "string"
                },
                "physicalState": {
                  "const": "unspecified_lower_authority"
                }
              }
            }
          },
          "missingEvidenceStates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "net",
                "assembled",
                "operating_footprint",
                "packaged",
                "crate_outer",
                "package_count",
                "multi_package"
              ]
            }
          }
        }
      }
    },
    "nativeShippingWeights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variantGid",
          "productGid",
          "weight",
          "state",
          "approvedByBatch"
        ],
        "properties": {
          "variantGid": {
            "type": "string"
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "weight": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {},
              "unit": {
                "type": "string"
              }
            }
          },
          "state": {
            "type": "string"
          },
          "approvedByBatch": {
            "type": "boolean"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "variants",
        "positiveNativeWeights",
        "missingNativeWeights",
        "productsWithPackingObservations",
        "approvedCustomMeasurements",
        "packageRecords"
      ],
      "properties": {
        "products": {
          "type": "integer"
        },
        "variants": {
          "type": "integer"
        },
        "positiveNativeWeights": {
          "type": "integer"
        },
        "missingNativeWeights": {
          "type": "integer"
        },
        "productsWithPackingObservations": {
          "type": "integer"
        },
        "approvedCustomMeasurements": {
          "type": "integer"
        },
        "packageRecords": {
          "type": "integer"
        }
      }
    }
  }
}
