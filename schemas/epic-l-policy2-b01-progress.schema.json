{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-b01-progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "status",
    "recordedAt",
    "mode",
    "customerFacingAuthority",
    "authoritativeContracts",
    "pbiProgress",
    "readinessBlockers",
    "technicalClarifications",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "const": "EPIC-L-POLICY2-B01" },
    "status": { "const": "ENGINEERING_FOUNDATION_IMPLEMENTED_SYNTHETIC_ONLY" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mode": { "const": "PRIVATE_SYNTHETIC_DATA_ONLY" },
    "customerFacingAuthority": { "const": false },
    "authoritativeContracts": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pbiProgress": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pbiId",
          "engineeringComponentImplemented",
          "testsPassing",
          "productionInfrastructureSelected",
          "securityReviewComplete",
          "operationalOwnerApproval",
          "legalApproval",
          "customerActivationPermitted",
          "deliveredScope",
          "remainingScope"
        ],
        "properties": {
          "pbiId": { "enum": ["L-PBI-006", "L-PBI-012", "L-PBI-014", "L-PBI-016"] },
          "engineeringComponentImplemented": { "const": true },
          "testsPassing": { "const": true },
          "productionInfrastructureSelected": { "const": false },
          "securityReviewComplete": { "const": false },
          "operationalOwnerApproval": { "const": false },
          "legalApproval": { "const": false },
          "customerActivationPermitted": { "const": false },
          "deliveredScope": { "type": "string", "minLength": 1 },
          "remainingScope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "readinessBlockers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "technicalClarifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic", "clarification", "businessIntentChanged"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "clarification": { "type": "string", "minLength": 1 },
          "businessIntentChanged": { "const": false }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
