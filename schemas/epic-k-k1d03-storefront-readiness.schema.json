{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-k-k1d03-storefront-readiness.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batch", "asOf", "state", "acceptance", "preview", "production", "authorization"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batch": { "const": "K1D-03" },
    "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "state": { "enum": ["IMPLEMENTED_AWAITING_PREVIEW", "PREVIEW_DEPLOYED_AWAITING_LIVE_BROWSER_ACCEPTANCE"] },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backendIntegrationAccepted", "authenticAppProxyAccepted", "controlledDraftOrderAccepted", "customerStorefrontFormIntegrated", "mockedBrowserSubmissionAccepted", "actualBrowserSubmissionAccepted"],
      "properties": {
        "backendIntegrationAccepted": { "const": true },
        "authenticAppProxyAccepted": { "const": true },
        "controlledDraftOrderAccepted": { "const": true },
        "customerStorefrontFormIntegrated": { "const": true },
        "mockedBrowserSubmissionAccepted": { "const": true },
        "actualBrowserSubmissionAccepted": { "const": false }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "automationEnabled", "published", "mockedOnly"],
      "properties": {
        "themeId": { "const": "158631198917" },
        "automationEnabled": { "type": "boolean" },
        "published": { "const": false },
        "mockedOnly": { "const": true }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "automationEnabled", "themeChanged", "activated"],
      "properties": {
        "themeId": { "const": "158579622085" },
        "automationEnabled": { "const": false },
        "themeChanged": { "const": false },
        "activated": { "const": false }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveDraftOrderCreationAuthorized", "invoiceAuthorized", "paymentAuthorized", "productionPublicationAuthorized"],
      "properties": {
        "liveDraftOrderCreationAuthorized": { "const": false },
        "invoiceAuthorized": { "const": false },
        "paymentAuthorized": { "const": false },
        "productionPublicationAuthorized": { "const": false }
      }
    }
  }
}
