{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "provenance", "fixtureOnly", "mode", "factEligibilityExpiresAt", "routes", "grants"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "epic-f-batch-f1"},
    "fixtureOnly": {"const": false},
    "mode": {"const": "shell_only"},
    "factEligibilityExpiresAt": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "version", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(data|docs|scripts)/"},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "routes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["productGid", "productClass"],
        "properties": {
          "productGid": {"type": "string", "pattern": "^gid://shopify/Product/[0-9]+$"},
          "productClass": {"enum": ["machine", "replacement_part", "consumable", "accessory"]}
        }
      }
    },
    "grants": {"type": "array", "maxItems": 0}
  }
}
