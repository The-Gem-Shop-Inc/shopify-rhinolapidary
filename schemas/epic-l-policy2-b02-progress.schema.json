{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-b02-progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "status",
    "recordedAt",
    "mode",
    "customerFacingAuthority",
    "authoritativeContracts",
    "pbiProgress",
    "contractMigration",
    "testEvidence",
    "readinessBlockers",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "const": "EPIC-L-POLICY2-B02" },
    "status": { "const": "ENGINEERING_REGISTRATION_IMPLEMENTED_SYNTHETIC_ONLY" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mode": { "const": "PRIVATE_SYNTHETIC_DATA_ONLY" },
    "customerFacingAuthority": { "const": false },
    "authoritativeContracts": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pbiProgress": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pbiId",
          "engineeringComponentImplemented",
          "testsPassing",
          "productionInfrastructureSelected",
          "securityReviewComplete",
          "operationalOwnerApproval",
          "legalApproval",
          "customerActivationPermitted",
          "deliveredScope",
          "remainingScope"
        ],
        "properties": {
          "pbiId": { "enum": ["L-PBI-004", "L-PBI-005"] },
          "engineeringComponentImplemented": { "const": true },
          "testsPassing": { "const": true },
          "productionInfrastructureSelected": { "const": false },
          "securityReviewComplete": { "const": false },
          "operationalOwnerApproval": { "const": false },
          "legalApproval": { "const": false },
          "customerActivationPermitted": { "const": false },
          "deliveredScope": { "type": "string", "minLength": 1 },
          "remainingScope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contractMigration": {
      "type": "object",
      "required": ["contractId", "fromVersion", "toVersion", "change", "businessIntentChanged", "customerFacingAuthorityChanged"],
      "properties": {
        "contractId": { "const": "EPIC-L-POLICY2-REGISTRATION" },
        "fromVersion": { "const": "2.0.0" },
        "toVersion": { "const": "2.1.0" },
        "businessIntentChanged": { "const": false },
        "customerFacingAuthorityChanged": { "const": false }
      }
    },
    "testEvidence": {
      "type": "object",
      "required": ["artifactChecks", "domainScenarios", "invalidOperationsRejected", "supportedLifecycleTransitionsExercised", "liveProviderCalls"],
      "properties": {
        "artifactChecks": { "minimum": 10 },
        "domainScenarios": { "minimum": 35 },
        "invalidOperationsRejected": { "minimum": 31 },
        "supportedLifecycleTransitionsExercised": { "minimum": 22 },
        "liveProviderCalls": { "const": 0 }
      }
    },
    "readinessBlockers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
