{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-policy-scenarios.schema.json",
  "title": "Epic K synthetic policy scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureType", "operationalEvidence", "realProductClaimsAllowed", "routingCases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureType": { "const": "synthetic_only" },
    "operationalEvidence": { "const": false },
    "realProductClaimsAllowed": { "const": false },
    "routingCases": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cart", "request", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^K-SYN-[A-Z0-9-]+$" },
          "cart": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "kind", "quantity", "pickupEligibility"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^SYNTHETIC-[A-Z0-9-]+$" },
                    "kind": { "enum": ["machine", "part", "accessory", "supply"] },
                    "quantity": { "type": "integer", "minimum": 1 },
                    "pickupEligibility": { "enum": ["approved", "rejected", "unknown"] }
                  }
                }
              }
            }
          },
          "request": {
            "type": "object",
            "additionalProperties": true,
            "required": ["intent", "destination"],
            "properties": {
              "intent": { "enum": ["shipment", "pickup", "rhino_delivery"] },
              "destination": {
                "type": "object",
                "additionalProperties": false,
                "required": ["countryCode", "subdivisionCode"],
                "properties": {
                  "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
                  "subdivisionCode": { "type": "string", "minLength": 2, "maxLength": 3 },
                  "postalCode": { "type": "string", "minLength": 3 },
                  "city": { "type": "string", "minLength": 2 },
                  "address1": { "type": "string", "minLength": 3 },
                  "address2": { "type": ["string", "null"] }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "policyEligible"],
            "properties": {
              "route": { "enum": ["ordinary_paid_shipping", "whole_cart_quotation_required", "ordinary_grafton_pickup", "blocked_by_policy", "operational_evidence_required"] },
              "policyEligible": { "type": ["boolean", "null"] }
            }
          }
        }
      }
    }
  }
}
