{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-registration.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "status",
    "authoritativeSource",
    "runtimeConsumer",
    "customerFacingAuthority",
    "identifier",
    "record",
    "states",
    "duplicateHandling",
    "eligibility",
    "acknowledgement",
    "qrHandout",
    "tests",
    "contractMigration"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.2.0"
    },
    "status": {
      "const": "PROPOSED"
    },
    "customerFacingAuthority": {
      "const": false
    },
    "identifier": {
      "type": "object",
      "required": [
        "kind",
        "minimumEntropyBits",
        "format",
        "minimumRandomBytes",
        "uuidV4SatisfiesMinimumEntropy",
        "mustNotContain"
      ],
      "properties": {
        "kind": {
          "const": "opaque_random"
        },
        "minimumEntropyBits": {
          "minimum": 128
        },
        "format": {
          "const": "CSPRNG_BASE64URL_MIN_16_BYTES"
        },
        "minimumRandomBytes": {
          "minimum": 16
        },
        "uuidV4SatisfiesMinimumEntropy": {
          "const": false
        }
      }
    },
    "eligibility": {
      "type": "object",
      "required": [
        "registrationAbsentAutomaticDenial"
      ],
      "properties": {
        "registrationAbsentAutomaticDenial": {
          "const": false
        }
      }
    },
    "contractMigration": {
      "type": "object",
      "required": [
        "fromVersion",
        "toVersion",
        "reason",
        "supersededText",
        "replacementText",
        "businessIntentChanged",
        "customerFacingAuthorityChanged"
      ],
      "properties": {
        "fromVersion": { "const": "2.1.0" },
        "toVersion": { "const": "2.2.0" },
        "businessIntentChanged": { "const": true },
        "customerFacingAuthorityChanged": { "const": false }
      }
    }
  }
}
