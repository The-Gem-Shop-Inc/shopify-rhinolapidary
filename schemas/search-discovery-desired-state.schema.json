{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["filters", "synonyms", "boosts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filterId", "enabled", "label"],
        "additionalProperties": false,
        "properties": {
          "filterId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "enabled": { "type": "boolean" },
          "label": { "type": "string", "minLength": 2 }
        }
      }
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["terms", "owner", "reason"],
        "additionalProperties": false,
        "properties": {
          "terms": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "owner": { "type": "string", "minLength": 2 },
          "reason": { "type": "string", "minLength": 5 }
        }
      }
    },
    "boosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "productHandle", "owner", "reason"],
        "additionalProperties": false,
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "productHandle": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 2 },
          "reason": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}