{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["filters"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "source", "customerFacing", "requiredForLaunch", "adminDependency"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 2 },
          "source": {
            "enum": [
              "shopify-native",
              "product-type",
              "vendor",
              "tag",
              "variant-option",
              "product-metafield",
              "variant-metafield"
            ]
          },
          "namespace": { "type": "string" },
          "key": { "type": "string" },
          "optionName": { "type": "string" },
          "customerFacing": { "type": "boolean" },
          "requiredForLaunch": { "type": "boolean" },
          "adminDependency": { "type": "string", "pattern": "^ADM-\\d{3}$" },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "enum": ["product-metafield", "variant-metafield"]
                }
              }
            },
            "then": {
              "required": ["namespace", "key"]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "variant-option"
                }
              }
            },
            "then": {
              "required": ["optionName"]
            }
          }
        ]
      }
    }
  }
}