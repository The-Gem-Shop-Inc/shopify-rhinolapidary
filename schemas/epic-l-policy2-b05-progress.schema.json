          "technicalAuthorityBindingApproved": { "const": false }, "approvedResourcesAvailable": { "const": false }, "realStaffRoutingApproved": { "const": false }, "productionProcessorApproved": { "const": false }, "securityReviewApproved": { "const": false }, "operationalOwnerApproval": { "const": false }, "legalApproval": { "const": false }, "customerGuidancePermitted": { "const": false }, "resourcePublicationPermitted": { "const": false }, "customerActivationPermitted": { "const": false },
