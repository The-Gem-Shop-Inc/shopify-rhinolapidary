{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["media"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "owner", "source", "status", "altTextRequired"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "type": { "enum": ["theme-ui", "product-media", "support-file", "manual", "diagram", "video", "other"] },
          "owner": { "type": "string", "minLength": 2 },
          "source": { "enum": ["rhino-owned", "vendor", "shopify-admin", "external-approved", "unknown"] },
          "status": { "enum": ["proposed", "active", "deprecated", "remove"] },
          "altTextRequired": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "shopifyFilesAudit": {
      "type": "object",
      "required": [
        "snapshotDate",
        "store",
        "sourceAuditPath",
        "scope",
        "status",
        "totals",
        "storage",
        "sourceOfTruthDecisions",
        "gates",
        "duplicateFindings",
        "reviewQueues",
        "referenceScan",
        "followUpSequence"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshotDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "store": { "type": "string", "minLength": 1 },
        "sourceAuditPath": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "evidence_only",
            "governance_blocked",
            "ready_for_governed_use"
          ]
        },
        "totals": {
          "type": "object",
          "required": [
            "totalFiles",
            "images",
            "shopifyHostedVideos",
            "documentsAndGenericFiles",
            "readyNoFileErrors",
            "missingAltText",
            "productMediaAssociated",
            "notProductMediaAssociated"
          ],
          "additionalProperties": false,
          "properties": {
            "totalFiles": { "type": "integer", "minimum": 0 },
            "images": { "type": "integer", "minimum": 0 },
            "shopifyHostedVideos": { "type": "integer", "minimum": 0 },
            "documentsAndGenericFiles": { "type": "integer", "minimum": 0 },
            "readyNoFileErrors": { "type": "integer", "minimum": 0 },
            "missingAltText": { "type": "integer", "minimum": 0 },
            "productMediaAssociated": { "type": "integer", "minimum": 0 },
            "notProductMediaAssociated": { "type": "integer", "minimum": 0 }
          }
        },
        "storage": {
          "type": "object",
          "required": [
            "imagesOriginalBytes",
            "shopifyHostedVideosOriginalBytes",
            "documentsAndGenericFilesOriginalBytes",
            "totalOriginalBytes",
            "shopifyHostedVideosDurationMs"
          ],
          "additionalProperties": false,
          "properties": {
            "imagesOriginalBytes": { "type": "integer", "minimum": 0 },
            "shopifyHostedVideosOriginalBytes": { "type": "integer", "minimum": 0 },
            "documentsAndGenericFilesOriginalBytes": { "type": "integer", "minimum": 0 },
            "totalOriginalBytes": { "type": "integer", "minimum": 0 },
            "shopifyHostedVideosDurationMs": { "type": "integer", "minimum": 0 }
          }
        },
        "sourceOfTruthDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assetClass", "canonicalLocation", "repositoryPolicy"],
            "additionalProperties": false,
            "properties": {
              "assetClass": { "type": "string", "minLength": 1 },
              "canonicalLocation": { "type": "string", "minLength": 1 },
              "repositoryPolicy": { "type": "string", "minLength": 1 }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "appliesTo", "requirement", "blocking"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "appliesTo": { "type": "string", "minLength": 1 },
              "requirement": { "type": "string", "minLength": 1 },
              "blocking": { "type": "boolean" }
            }
          }
        },
        "duplicateFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "count", "evidence", "requiredAction"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "kind": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 0 },
              "evidence": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "requiredAction": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reviewQueues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "count", "requiredAction"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "kind": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 0 },
              "sourceRows": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 }
              },
              "files": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "notes": { "type": "string" },
              "requiredAction": { "type": "string", "minLength": 1 }
            }
          }
        },
        "referenceScan": {
          "type": "object",
          "required": ["themeSourceHasDirectShopifyFileReferences", "notes"],
          "additionalProperties": false,
          "properties": {
            "themeSourceHasDirectShopifyFileReferences": { "type": "boolean" },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "followUpSequence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "homepageInventory": {
      "type": "object",
      "required": ["auditDate", "candidates", "moduleMediaRequirements"],
      "additionalProperties": false,
      "properties": {
        "auditDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "sourceLocation",
              "ownership",
              "usageRightsStatus",
              "dimensions",
              "format",
              "intendedModuleIds",
              "role",
              "altTextOwner",
              "altTextGuidance",
              "cropSafety",
              "mobileCropConcern",
              "performanceConcern",
              "launchReadiness",
              "blocker"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "sourceLocation": { "type": "string", "minLength": 1 },
              "mediaManifestPath": { "type": "string" },
              "ownership": {
                "enum": [
                  "rhino-owned",
                  "shopify-admin",
                  "external",
                  "unknown",
                  "not_available"
                ]
              },
              "usageRightsStatus": {
                "enum": [
                  "approved",
                  "owned_or_controlled_needs_confirmation",
                  "reuse_permission_required",
                  "unknown",
                  "not_applicable"
                ]
              },
              "dimensions": {
                "type": "object",
                "required": ["known"],
                "additionalProperties": false,
                "properties": {
                  "known": { "type": "boolean" },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 },
                  "notes": { "type": "string" }
                }
              },
              "format": { "enum": ["svg", "png", "jpeg", "jpg", "video", "mixed", "unknown", "not_applicable"] },
              "intendedModuleIds": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              },
              "role": {
                "enum": [
                  "informative",
                  "decorative",
                  "poster",
                  "brand_fallback",
                  "missing"
                ]
              },
              "altTextOwner": { "type": "string" },
              "altTextGuidance": { "type": "string" },
              "cropSafety": {
                "enum": [
                  "approved",
                  "needs_review",
                  "blocked",
                  "unknown",
                  "not_applicable"
                ]
              },
              "mobileCropConcern": { "type": "string" },
              "performanceConcern": { "type": "string" },
              "launchReadiness": {
                "enum": [
                  "ready",
                  "fallback_only",
                  "needs_review",
                  "blocked",
                  "not_required"
                ]
              },
              "blocker": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "moduleMediaRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["moduleId", "launchNeed", "notes"],
            "additionalProperties": false,
            "properties": {
              "moduleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "launchNeed": {
                "enum": [
                  "can_launch_without_media",
                  "requires_media_before_launch",
                  "can_use_governed_fallback"
                ]
              },
              "governedFallbackCandidateId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "blocker": { "type": "string" },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
