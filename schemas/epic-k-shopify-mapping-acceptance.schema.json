{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-shopify-mapping-acceptance.schema.json",
  "title": "Epic K full Shopify mapping design acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "version",
    "receiptId",
    "mappingDesignAcceptanceStatus",
    "authority",
    "sourceLinks",
    "classificationSummary",
    "acceptedMappingDefinitions",
    "evidenceLimitations",
    "application",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-shopify-mapping-acceptance" },
    "version": { "const": "1.1.0" },
    "receiptId": { "const": "K1B03B-MAPPING-ACCEPTANCE-2026-10-24" },
    "mappingDesignAcceptanceStatus": { "const": "accepted" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "confirmationDate", "source", "scope", "newBusinessDecisionCreated", "additionalProductOwnerApprovalRequired"],
      "properties": {
        "role": { "const": "Product Owner" },
        "confirmationDate": { "const": "2026-10-24" },
        "source": { "const": "Product Owner clarification confirming review and approval of all 24 mapping definitions" },
        "scope": { "const": "complete_mapping_design_acceptance" },
        "newBusinessDecisionCreated": { "const": false },
        "additionalProductOwnerApprovalRequired": { "const": false }
      }
    },
    "sourceLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMapping", "sanitizedSnapshot", "auditProvenance"],
      "properties": {
        "sourceMapping": { "$ref": "#/$defs/sourceMappingLink" },
        "sanitizedSnapshot": { "$ref": "#/$defs/snapshotLink" },
        "auditProvenance": { "$ref": "#/$defs/provenanceLink" }
      }
    },
    "classificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "partial", "requiresOperationalEvidence", "unavailable", "total"],
      "properties": {
        "verified": { "const": 13 },
        "partial": { "const": 3 },
        "requiresOperationalEvidence": { "const": 5 },
        "unavailable": { "const": 3 },
        "total": { "const": 24 }
      }
    },
    "acceptedMappingDefinitions": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/acceptedMappingDefinition" }
    },
    "evidenceLimitations": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/evidenceLimitation" }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritativeMappingVersion",
        "appliesTo",
        "historicalSnapshotAcceptanceStatus",
        "historicalAuditProvenanceAcceptanceStatus",
        "historicalReportsRewritten"
      ],
      "properties": {
        "authoritativeMappingVersion": { "const": "1.2.0" },
        "appliesTo": { "const": "future_assessments_using_mapping_version_1.2.0_or_this_explicit_acceptance_receipt" },
        "historicalSnapshotAcceptanceStatus": { "const": "pending" },
        "historicalAuditProvenanceAcceptanceStatus": { "const": "pending" },
        "historicalReportsRewritten": { "const": false }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designApprovalComplete",
        "operationalEvidenceStatus",
        "operationalEvidenceRequirementCount",
        "liveCheckoutEnforcement",
        "parentPbiStatus",
        "shopifyAccessAuthorized",
        "shopifyMutationsAuthorized",
        "shopifyOperationsPerformed",
        "businessDecisionsChanged",
        "excludedClaims",
        "departmentalDecisionContext"
      ],
      "properties": {
        "designApprovalComplete": { "const": true },
        "operationalEvidenceStatus": { "const": "BLOCKED" },
        "operationalEvidenceRequirementCount": { "const": 8 },
        "liveCheckoutEnforcement": { "const": "UNVERIFIED" },
        "parentPbiStatus": { "const": "partial" },
        "shopifyAccessAuthorized": { "const": false },
        "shopifyMutationsAuthorized": { "const": false },
        "shopifyOperationsPerformed": { "const": false },
        "businessDecisionsChanged": { "const": false },
        "excludedClaims": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "shipping_prices_or_regional_service_availability",
              "product_classification_or_pickup_eligibility",
              "packed_weight_accuracy",
              "package_characteristics",
              "insurance_pricing",
              "warehouse_readiness",
              "machine_quotation_enforcement",
              "checkout_compliance"
            ]
          }
        },
        "departmentalDecisionContext": {
          "const": "Previously communicated Epic K business decisions were obtained from the relevant departmental authorities and are not reopened by outstanding operational evidence."
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "canonical-json-sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "sourceMappingLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contractId", "version", "fingerprint"],
      "properties": {
        "path": { "const": "data/epic-k-shopify-source-mapping.json" },
        "contractId": { "const": "epic-k-shopify-source-mapping" },
        "version": { "const": "1.2.0" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "snapshotLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contractId", "version", "fingerprint"],
      "properties": {
        "path": { "const": "data/epic-k-shopify-config-snapshot-2026-10-24.json" },
        "contractId": { "const": "epic-k-normalized-shopify-config-snapshot" },
        "version": { "const": "1.2.0" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "provenanceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contractId", "auditId", "fingerprint"],
      "properties": {
        "path": { "const": "data/epic-k-shopify-audit-provenance-2026-10-24.json" },
        "contractId": { "const": "epic-k-shopify-audit-provenance" },
        "auditId": { "const": "K1B02-AUDIT-2026-10-24" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "acceptedMappingDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedPath", "designAcceptance", "sourceVerificationStatus"],
      "properties": {
        "normalizedPath": { "type": "string", "minLength": 2 },
        "designAcceptance": { "const": "accepted" },
        "sourceVerificationStatus": { "enum": ["verified", "partial", "requires_operational_evidence", "unavailable"] }
      }
    },
    "evidenceLimitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedPath", "designAcceptance", "sourceVerificationStatus", "limitationStatus"],
      "properties": {
        "normalizedPath": { "type": "string", "minLength": 2 },
        "designAcceptance": { "const": "accepted" },
        "sourceVerificationStatus": { "enum": ["partial", "requires_operational_evidence", "unavailable"] },
        "limitationStatus": { "const": "outstanding" }
      }
    }
  }
}
