{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-shopify-config-snapshot.schema.json",
  "title": "Normalized Epic K Shopify configuration snapshot",
  "description": "A normalized intermediate representation. A future authorized audit must establish and document the mapping from Shopify responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "snapshotVersion", "synthetic", "source", "profiles", "zones", "rates", "discounts", "markets", "pickup", "products"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-normalized-shopify-config-snapshot" },
    "snapshotVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "synthetic": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "storeRef", "apiVersion", "mappingStatus", "sourceVerificationStatus", "mappingAcceptanceStatus", "collectionAuthorizationStatus", "operationalAuthorityStatus", "collectedAt", "assessmentTime", "collectorAuthority", "authorityStatus", "sanitized", "sanitizationStatus", "validity", "datasetCompleteness", "collectionFailures"],
      "properties": {
        "system": { "const": "normalized_shopify_configuration" },
        "storeRef": { "$ref": "#/$defs/reference" },
        "apiVersion": { "type": "string", "pattern": "^20[0-9]{2}-(01|04|07|10)$" },
        "mappingStatus": { "description": "Repository mapping maturity; Shopify provenance alone cannot set approved_mapping_attached.", "enum": ["synthetic_contract_only", "source_verified_mapping_pending_acceptance", "approved_mapping_attached"] },
        "sourceVerificationStatus": { "description": "Whether Shopify established the collected source fact.", "enum": ["verified", "unverified", "synthetic"] },
        "mappingAcceptanceStatus": { "description": "Product Owner acceptance of the Shopify-to-contract mapping, distinct from source verification.", "enum": ["accepted", "pending", "unverified", "synthetic"] },
        "collectionAuthorizationStatus": { "description": "Authorization to perform the read-only collection, distinct from operational approval.", "enum": ["authorized", "unverified", "synthetic"] },
        "operationalAuthorityStatus": { "description": "External business-owner authority for operational use of the evidence.", "enum": ["accepted", "blocked", "unverified", "synthetic"] },
        "collectedAt": { "type": "string", "format": "date-time" },
        "assessmentTime": { "type": "string", "format": "date-time" },
        "collectorAuthority": { "type": "string", "minLength": 2 },
        "authorityStatus": { "description": "Legacy collection-authorization status retained for compatibility; it does not confer mapping or operational approval.", "enum": ["accepted", "unverified", "synthetic"] },
        "sanitized": { "const": true },
        "sanitizationStatus": { "enum": ["synthetic_only", "raw_identifiers_replaced"] },
        "collectionFailures": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["dataset", "state", "message"],
            "properties": {
              "dataset": { "type": "string", "minLength": 2 },
              "state": { "enum": ["partial", "missing", "inaccessible", "unsupported"] },
              "message": { "type": "string", "minLength": 2 }
            }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["none_established", "interval"] },
            "expiresAt": { "type": "string", "format": "date-time" }
          },
          "allOf": [{ "if": { "properties": { "kind": { "const": "interval" } } }, "then": { "required": ["expiresAt"] } }]
        },
        "datasetCompleteness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profiles", "zones", "rates", "discounts", "markets", "pickup", "products"],
          "properties": {
            "profiles": { "$ref": "#/$defs/completeness" },
            "zones": { "$ref": "#/$defs/completeness" },
            "rates": { "$ref": "#/$defs/completeness" },
            "discounts": { "$ref": "#/$defs/completeness" },
            "markets": { "$ref": "#/$defs/completeness" },
            "pickup": { "$ref": "#/$defs/completeness" },
            "products": { "$ref": "#/$defs/completeness" }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "assignedProductRefs", "machineShipmentMode"],
        "properties": {
          "id": { "$ref": "#/$defs/reference" },
          "name": { "type": "string", "minLength": 1 },
          "assignedProductRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
          "machineShipmentMode": { "enum": ["quotation_required", "ordinary_checkout_possible", "unverified"] }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "countryCodes", "subdivisionCodes"],
        "properties": {
          "id": { "$ref": "#/$defs/reference" },
          "countryCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
          "subdivisionCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } }
        }
      }
    },
    "rates": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "profileId", "zoneIds", "type", "active", "amountCents", "effectivePriceStatus", "currencyCode", "subdivisionCodes", "operationalApproval", "serviceAvailability"],
        "properties": {
          "id": { "$ref": "#/$defs/reference" },
          "profileId": { "$ref": "#/$defs/reference" },
          "zoneIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
          "type": { "enum": ["flat", "threshold_free", "carrier_calculated", "freight_quote"] },
          "active": { "type": "boolean" },
          "amountCents": { "type": ["integer", "null"], "minimum": 0 },
          "effectivePriceStatus": { "enum": ["verified_paid", "verified_zero", "unverified", "quotation_required"] },
          "thresholdCents": { "type": "integer", "minimum": 0 },
          "currencyCode": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "subdivisionCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
          "operationalApproval": { "enum": ["accepted", "missing", "pending", "not_applicable"] },
          "serviceAvailability": { "enum": ["confirmed", "unverified", "not_applicable"] }
        },
        "allOf": [
          {
            "if": { "properties": { "effectivePriceStatus": { "const": "verified_paid" } } },
            "then": { "properties": { "amountCents": { "type": "integer", "minimum": 1 } } }
          },
          {
            "if": { "properties": { "effectivePriceStatus": { "const": "verified_zero" } } },
            "then": {
              "anyOf": [
                { "properties": { "amountCents": { "const": 0 } } },
                { "properties": { "type": { "const": "threshold_free" } } }
              ]
            }
          },
          {
            "if": { "properties": { "effectivePriceStatus": { "const": "quotation_required" } } },
            "then": { "properties": { "type": { "const": "freight_quote" } } }
          }
        ]
      }
    },
    "discounts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "active", "shippingEffect", "effectiveShippingPriceStatus"],
        "properties": {
          "id": { "$ref": "#/$defs/reference" },
          "active": { "type": "boolean" },
          "shippingEffect": { "enum": ["zero_shipping", "reduced_shipping", "none", "unverified"] },
          "effectiveShippingPriceStatus": { "enum": ["verified_positive", "verified_zero", "unverified", "not_applicable"] }
        }
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "countryCodes", "active", "checkoutAvailabilityEvidence"],
        "properties": {
          "id": { "$ref": "#/$defs/reference" },
          "countryCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
          "active": { "type": "boolean" },
          "checkoutAvailabilityEvidence": { "enum": ["confirmed", "absent", "unverified"] }
        }
      }
    },
    "pickup": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "code", "active", "pickupEnabled", "eligibilityAssignmentStatus", "inventoryReadinessStatus"],
        "properties": {
          "id": { "$ref": "#/$defs/reference" },
          "code": { "type": "string", "minLength": 2 },
          "active": { "type": "boolean" },
          "pickupEnabled": { "type": "boolean" },
          "eligibilityAssignmentStatus": { "enum": ["complete", "partial", "missing"] },
          "inventoryReadinessStatus": { "enum": ["accepted", "pending", "missing"] }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "classification", "requiresShipping", "profileId", "pickupEligibility", "shippingWeight", "packageCharacteristicsStatus", "packages"],
        "properties": {
          "ref": { "$ref": "#/$defs/reference" },
          "classification": { "enum": ["machine", "replacement_part", "accessory", "consumable", "other", "unknown"] },
          "requiresShipping": { "type": "boolean" },
          "profileId": { "$ref": "#/$defs/reference" },
          "pickupEligibility": { "enum": ["approved", "rejected", "unknown"] },
          "shopifyInventoryStatus": { "enum": ["positive", "zero", "untracked", "unverified"] },
          "inventoryLocationRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
          "shippingWeight": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["value", "unit", "evidenceStatus"],
            "properties": {
              "value": { "type": "number", "minimum": 0 },
              "unit": { "enum": ["g", "kg", "oz", "lb"] },
              "evidenceStatus": { "enum": ["accepted", "available", "missing", "synthetic"] }
            }
          },
          "packageCharacteristicsStatus": { "enum": ["complete", "partial", "missing", "synthetic_complete"] },
          "packages": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "quantity", "length", "width", "height", "dimensionUnit"],
              "properties": {
                "id": { "$ref": "#/$defs/reference" },
                "quantity": { "type": "integer", "minimum": 1 },
                "length": { "type": "number", "exclusiveMinimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "dimensionUnit": { "enum": ["in", "cm"] }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "packageCharacteristicsStatus": { "enum": ["complete", "synthetic_complete"] } } },
            "then": { "properties": { "packages": { "minItems": 1 } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "completeness": { "enum": ["complete", "partial", "missing"] },
    "reference": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" }
  }
}
