{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-evidence-intake-manifest.schema.json",
  "title": "Epic K operational evidence intake manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "version", "status", "preparedOn", "requirementsSource", "submissionContract", "globalBoundaries", "requests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-operational-evidence-intake-manifest" },
    "version": { "const": "1.0.0" },
    "status": { "const": "request_only_no_evidence_attached" },
    "preparedOn": { "const": "2026-10-24" },
    "requirementsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contractId", "version", "fingerprint"],
      "properties": {
        "path": { "const": "data/epic-k-operational-evidence-requirements.json" },
        "contractId": { "const": "epic-k-operational-evidence-requirements" },
        "version": { "const": "1.0.0-provisional" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "submissionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaPath", "receiptTargetPath", "validationLibrary", "intakeCreatesAcceptedReceipt"],
      "properties": {
        "schemaPath": { "const": "schemas/epic-k-evidence-receipts.schema.json" },
        "receiptTargetPath": { "const": "data/epic-k-evidence-receipts.json" },
        "validationLibrary": { "const": "scripts/lib/epic-k-evidence-drift.js#verifyEvidence" },
        "intakeCreatesAcceptedReceipt": { "const": false }
      }
    },
    "globalBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationalEvidence", "operationalReadiness", "liveCheckoutEnforcement", "mappingDesignAcceptance", "remediationStatus", "shopifyAccessAuthorized", "shopifyMutationAuthorized", "parentPbiStatus"],
      "properties": {
        "operationalEvidence": { "const": "BLOCKED" },
        "operationalReadiness": { "const": "BLOCKED" },
        "liveCheckoutEnforcement": { "const": "UNVERIFIED" },
        "mappingDesignAcceptance": { "const": "accepted_all_24_definitions" },
        "remediationStatus": { "const": "proposal_only" },
        "shopifyAccessAuthorized": { "const": false },
        "shopifyMutationAuthorized": { "const": false },
        "parentPbiStatus": { "const": "partial" }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "canonical-json-sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "repositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryPath", "classification", "summary", "limitation", "maySatisfyRequirement"],
      "properties": {
        "repositoryPath": { "type": ["string", "null"] },
        "classification": { "enum": ["potentially_authoritative_current", "relevant_requires_confirmation_or_renewal", "informational_only", "missing_or_inaccessible"] },
        "summary": { "type": "string", "minLength": 4 },
        "limitation": { "type": "string", "minLength": 4 },
        "maySatisfyRequirement": { "const": false }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "requirementId",
        "requestState",
        "allowedSubjectTypes",
        "requiredScopeDimensions",
        "acceptableArtifacts",
        "requiredProvenance",
        "validityMode",
        "validityRationale",
        "sanitizationRequirements",
        "requiredAssertionNames",
        "repositorySources",
        "humanAuthorityInputs",
        "prohibitedInferences"
      ],
      "properties": {
        "requestId": { "type": "string", "pattern": "^K-INTAKE-[0-9]{3}$" },
        "requirementId": { "type": "string", "pattern": "^K-EVID-[0-9]{3}$" },
        "requestState": { "const": "awaiting_authoritative_submission" },
        "allowedSubjectTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "requiredScopeDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "acceptableArtifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } },
        "requiredProvenance": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } },
        "validityMode": { "enum": ["required_interval", "owner_declared_interval_or_none"] },
        "validityRationale": { "type": "string", "minLength": 4 },
        "sanitizationRequirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } },
        "requiredAssertionNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" } },
        "repositorySources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repositorySource" } },
        "humanAuthorityInputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } },
        "prohibitedInferences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } }
      }
    }
  }
}
