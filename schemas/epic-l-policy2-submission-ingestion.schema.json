{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-l-policy2-submission-ingestion.schema.json",
  "title": "Epic L Policy 2.0 B08A submission ingestion contract",
  "type": "object",
  "required": ["schemaVersion", "contractId", "status", "envelopeVersion", "envelopeSchema", "submissionTypes", "identityBoundary", "derivedFields", "defaults", "consistency", "diagnostics", "boundaries", "b08bDependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "contractId": { "const": "EPIC-L-POLICY2-B08A-SUBMISSION-INGESTION" },
    "status": { "const": "IMPLEMENTED_PRIVATE_SYNTHETIC_ONLY" },
    "envelopeVersion": { "const": "1.0.0" },
    "envelopeSchema": { "const": "schemas/epic-l-policy2-submission-envelope.schema.json" },
    "submissionTypes": { "const": ["REGISTRATION", "SUPPORT"] },
    "identityBoundary": {
      "type": "object",
      "required": ["authoritySource", "callerRoleLabelsAccepted", "productionIdentityBinding", "syntheticAuthorityMayBecomeProductionAuthority"],
      "properties": {
        "authoritySource": { "type": "string", "minLength": 1 },
        "callerRoleLabelsAccepted": { "const": false },
        "productionIdentityBinding": { "const": "UNRESOLVED" },
        "syntheticAuthorityMayBecomeProductionAuthority": { "const": false }
      },
      "additionalProperties": false
    },
    "derivedFields": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "defaults": { "type": "object" },
    "consistency": { "type": "object", "required": ["deliveryIdentityUniqueWithinTransport", "conflictingDeliveryRejected", "domainCommandStableAcrossRetry", "domainIdempotencyRequired", "retryCanReconcileDomainSuccessAfterReceiptInterruption", "partialInvalidSubmissionMutationAllowed"] },
    "diagnostics": { "type": "object", "required": ["restrictedPermission", "payloadIncluded", "customerContactIncluded", "auditAppendOnly"] },
    "boundaries": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "b08bDependencies": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
