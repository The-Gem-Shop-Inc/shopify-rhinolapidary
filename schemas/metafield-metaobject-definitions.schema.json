{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["metafields", "metaobjects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "metafields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ownerType",
          "namespace",
          "key",
          "name",
          "type",
          "requiredForLaunch",
          "usedForFiltering",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "ownerType": { "enum": ["product", "variant", "collection", "page"] },
          "namespace": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 2 },
          "type": { "type": "string", "minLength": 2 },
          "requiredForLaunch": { "type": "boolean" },
          "usedForFiltering": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 2 }
        }
      }
    },
    "metaobjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "requiredForLaunch", "owner", "fields"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "minLength": 2 },
          "name": { "type": "string", "minLength": 2 },
          "requiredForLaunch": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 2 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 2 },
                "type": { "type": "string", "minLength": 2 },
                "required": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}