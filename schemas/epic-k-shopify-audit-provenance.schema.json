{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-shopify-audit-provenance.schema.json",
  "title": "Epic K Shopify audit provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "auditId", "storeRef", "apiVersion", "collectedAt", "assessedAt", "authorization", "collection", "datasets", "sanitization", "restrictedEvidence", "customerAndMerchantImpact", "operationalEvidence", "liveCheckoutEnforcement"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-shopify-audit-provenance" },
    "auditId": { "type": "string", "pattern": "^K1B02-AUDIT-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "storeRef": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" },
    "apiVersion": { "type": "string", "pattern": "^20[0-9]{2}-(01|04|07|10)$" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "assessedAt": { "type": "string", "format": "date-time" },
    "authorization": { "const": "product_owner_authorized_read_only_epic_k_audit" },
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["interface", "finalQueryCount", "mutationCount", "schemaInspection", "storeIdentityVerified", "initialReadOnlyQueryCorrections"],
      "properties": {
        "interface": { "const": "authenticated_shopify_admin_graphql_connector" },
        "finalQueryCount": { "type": "integer", "minimum": 1 },
        "mutationCount": { "const": 0 },
        "schemaInspection": { "const": true },
        "storeIdentityVerified": { "const": true },
        "initialReadOnlyQueryCorrections": { "type": "integer", "minimum": 0 }
      }
    },
    "datasets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operation", "requiredScopes", "scopeStatus", "pages", "recordCount", "completeness", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "operation": { "type": "string", "pattern": "^EpicK[A-Za-z0-9]+$" },
          "requiredScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "scopeStatus": { "enum": ["granted", "not_required", "missing", "unverified"] },
          "pages": { "type": "integer", "minimum": 1 },
          "recordCount": { "type": "integer", "minimum": 0 },
          "completeness": { "enum": ["complete", "partial", "missing", "unsupported"] },
          "notes": { "type": "string", "minLength": 2 }
        }
      }
    },
    "sanitization": {
      "type": "object", "additionalProperties": false,
      "required": ["rawGidsCommitted", "credentialsCommitted", "customerDataCommitted", "stableReferences"],
      "properties": {
        "rawGidsCommitted": { "const": false },
        "credentialsCommitted": { "const": false },
        "customerDataCommitted": { "const": false },
        "stableReferences": { "const": "fnv1a64_prefixed" }
      }
    },
    "restrictedEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["rawResponsePersistence", "gitPath", "futureStorageRequirement"],
      "properties": {
        "rawResponsePersistence": { "const": "not_persisted_after_transient_connector_processing" },
        "gitPath": { "const": null },
        "futureStorageRequirement": { "type": "string", "minLength": 2 }
      }
    },
    "customerAndMerchantImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["shopifyDataChanged", "customerExperienceChanged", "ordersChanged", "paymentsChanged", "publicationChanged"],
      "properties": {
        "shopifyDataChanged": { "const": false },
        "customerExperienceChanged": { "const": false },
        "ordersChanged": { "const": false },
        "paymentsChanged": { "const": false },
        "publicationChanged": { "const": false }
      }
    },
    "operationalEvidence": { "const": "BLOCKED" },
    "liveCheckoutEnforcement": { "const": "UNVERIFIED" }
  }
}
