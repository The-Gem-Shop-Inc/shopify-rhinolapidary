{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-k-shopify-source-mapping.schema.json",
  "title": "Epic K Shopify source mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "version", "projectApiVersion", "auditApiVersion", "verifiedAt", "storeRef", "mappings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "epic-k-shopify-source-mapping" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "projectApiVersion": { "type": "string", "pattern": "^20[0-9]{2}-(01|04|07|10)$" },
    "auditApiVersion": { "type": "string", "pattern": "^20[0-9]{2}-(01|04|07|10)$" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "storeRef": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" },
    "mappings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["normalizedPath", "dataset", "shopifySource", "requiredReadPermission", "transformation", "pagination", "shopifyEstablishesFact", "operationalApprovalRequired", "unavailableBehavior", "status"],
        "properties": {
          "normalizedPath": { "type": "string", "minLength": 2 },
          "dataset": { "enum": ["profiles", "zones", "rates", "discounts", "markets", "pickup", "products", "provenance"] },
          "shopifySource": { "type": "string", "minLength": 2 },
          "requiredReadPermission": { "type": "string", "minLength": 2 },
          "transformation": { "type": "string", "minLength": 2 },
          "pagination": { "type": "string", "minLength": 2 },
          "shopifyEstablishesFact": { "type": "boolean" },
          "operationalApprovalRequired": { "type": "boolean" },
          "unavailableBehavior": { "type": "string", "minLength": 2 },
          "status": { "enum": ["verified", "partial", "unavailable", "requires_operational_evidence"] }
        }
      }
    }
  }
}
