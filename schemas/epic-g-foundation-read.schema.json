{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","sourceKind","transport","startedAt","completedAt","shop","snapshot","operations","mutations"],
 "properties":{
  "schemaVersion":{"const":1},"sourceKind":{"enum":["live_admin","fixture"]},"transport":{"type":"string"},
  "startedAt":{"type":"string","format":"date-time"},"completedAt":{"type":"string","format":"date-time"},
  "shop":{"type":"object","required":["id","myshopifyDomain"],"properties":{"id":{"type":"string","pattern":"^gid://shopify/Shop/[0-9]+$"},"myshopifyDomain":{"type":"string"}}},
  "snapshot":{"$ref":"epic-e-admin-snapshot.schema.json"},
  "operations":{"type":"array","minItems":1,"items":{"type":"object","required":["query","variables","response"],"properties":{"query":{"type":"string","pattern":"^query "},"variables":{"type":"object","required":["first","after"],"properties":{"first":{"const":10},"after":{"type":["string","null"]}}},"response":{"type":"object"}}}},
  "mutations":{"const":0},"apiVersionExposed":{"type":"boolean"},
  "recordedConnectorLog":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
 }
}
