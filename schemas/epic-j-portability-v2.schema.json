{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "predecessor",
    "ownerDecision",
    "businessException",
    "cleanCheckoutEvidence",
    "privateTraceGitIdentities",
    "implementation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "const": "J1-EVIDENCE-PORTABILITY-V2-2026-10-21"
    },
    "predecessor": {
      "$ref": "#/definitions/identity"
    },
    "ownerDecision": {
      "$ref": "#/definitions/identity"
    },
    "businessException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "absencePermittedInLocal",
        "absencePermittedInPortable"
      ],
      "properties": {
        "path": {
          "const": "docs/product/AMER\u0130KA ROCK SHOPS.xlsx"
        },
        "sha256": {
          "const": "cb74336c9584d8a52d92fd1d791650d730ae50c058cc1867f3a11fb81958968c"
        },
        "absencePermittedInLocal": {
          "const": true
        },
        "absencePermittedInPortable": {
          "const": true
        }
      }
    },
    "cleanCheckoutEvidence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "additionalItems": false,
      "items": [
        {
          "allOf": [
            { "$ref": "#/definitions/identity" },
            { "type": "object", "properties": { "path": { "const": "docs/qa/evidence/epic-f/006b-worksheet-review-2026-10-15/diff.log" }, "sha256": { "const": "7851d1ed5cb2898278b72a87051c13f1c14573ee4e79764fcf2b6d451a23291e" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/identity" },
            { "type": "object", "properties": { "path": { "const": "docs/qa/evidence/epic-f/006b-worksheet-review-2026-10-15/registers.log" }, "sha256": { "const": "6a0d7fca9ebc11ad99bcbe27ce12e1c83b8c3d32f02abcd700ee2bb295fbe1db" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/identity" },
            { "type": "object", "properties": { "path": { "const": "docs/qa/evidence/epic-f/006b-worksheet-review-2026-10-15/review.log" }, "sha256": { "const": "f9628aa7856036165b3329a7bcc6fc3b548da9dac07016b7e018a86e36a65756" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/identity" },
            { "type": "object", "properties": { "path": { "const": "docs/qa/evidence/epic-f/006b-worksheet-review-2026-10-15/theme-check.log" }, "sha256": { "const": "b154cb2d4e0dbe3f3ad203bec0b9e01799b1c95fd818970db0f56c4a8d422f78" } } }
          ]
        }
      ]
    },
    "privateTraceGitIdentities": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "gitBlobOid"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "gitBlobOid": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    "implementation": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/definitions/identity"
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
