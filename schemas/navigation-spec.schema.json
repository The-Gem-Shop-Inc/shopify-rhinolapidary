{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["routes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "path", "group", "requiredForLaunch"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/" },
          "group": { "enum": ["header", "footer", "utility", "support", "policy"] },
          "requiredForLaunch": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}