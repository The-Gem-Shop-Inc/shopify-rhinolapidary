{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decisionId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fulfillment",
              "profile_capability",
              "pickup",
              "region",
              "policy",
              "warranty_class",
              "warranty_mapping",
              "lead_time_source",
              "lead_time_projection",
              "variant_timing",
              "variant_fulfillment"
            ]
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "decisionState": {
            "const": "approved"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "approvedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
          },
          "ownerRoles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "decisionId",
          "kind",
          "subjectId",
          "decisionState",
          "sourceIds",
          "approvedAt",
          "ownerRoles"
        ]
      }
    },
    "fulfillmentAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignmentId": {
            "type": "string",
            "minLength": 1
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "variantGid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^gid://shopify/ProductVariant/[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fulfillmentClass": {
            "enum": [
              "parcel",
              "freight"
            ]
          },
          "expectedProfileGids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^gid://shopify/DeliveryProfile/[0-9]+$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          },
          "commerceDecisionId": {
            "type": "string",
            "minLength": 1
          },
          "fulfillmentEvidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "assignmentId",
          "productGid",
          "fulfillmentClass",
          "expectedProfileGids",
          "approvalDecisionId"
        ]
      }
    },
    "profileCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profileGid": {
            "type": "string",
            "pattern": "^gid://shopify/DeliveryProfile/[0-9]+$"
          },
          "allowedHandlingClasses": {
            "type": "array",
            "items": {
              "enum": [
                "parcel",
                "freight"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "configurationSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "profileGid",
          "allowedHandlingClasses",
          "configurationSha256",
          "approvalDecisionId"
        ]
      }
    },
    "pickupRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "permission": {
            "enum": [
              "allowed",
              "not_allowed"
            ]
          },
          "evidenceBasis": {
            "const": "explicit_business_rule"
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ruleId",
          "productGid",
          "permission",
          "evidenceBasis",
          "approvalDecisionId"
        ]
      }
    },
    "regionRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "kind": {
            "enum": [
              "regulatory",
              "commercial",
              "temporary",
              "policy"
            ]
          },
          "permission": {
            "enum": [
              "allowed",
              "not_allowed"
            ]
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "subdivision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceBasis": {
            "const": "explicit_regional_rule"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ruleId",
          "productGid",
          "kind",
          "permission",
          "countryCode",
          "subdivision",
          "evidenceBasis",
          "expiresAt",
          "approvalDecisionId"
        ]
      }
    },
    "policyVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policyId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "current",
              "obsolete",
              "superseded"
            ]
          },
          "effectiveFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
          },
          "effectiveTo": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "administrator": {
            "type": "string",
            "minLength": 1
          },
          "repairProvider": {
            "type": "string",
            "minLength": 1
          },
          "roleEvidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "issuer": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "administrator": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "repairProvider": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "issuer",
              "administrator",
              "repairProvider"
            ]
          },
          "explicitRoleEquality": {
            "type": "boolean"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "resourceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "nativePolicyGid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^gid://shopify/ShopPolicy/[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersededBy": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "policyId",
          "revision",
          "lifecycle",
          "effectiveFrom",
          "effectiveTo",
          "issuer",
          "administrator",
          "repairProvider",
          "roleEvidence",
          "explicitRoleEquality",
          "sourceIds",
          "resourceId",
          "nativePolicyGid",
          "supersededBy",
          "approvalDecisionId",
          "sourceSha256"
        ]
      }
    },
    "warrantyClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "classId": {
            "type": "string",
            "minLength": 1
          },
          "policyId": {
            "type": "string",
            "minLength": 1
          },
          "policyRevision": {
            "type": "string",
            "minLength": 1
          },
          "durationValue": {
            "type": "integer",
            "minimum": 1
          },
          "durationUnit": {
            "enum": [
              "days",
              "months",
              "years"
            ]
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "classId",
          "policyId",
          "policyRevision",
          "durationValue",
          "durationUnit",
          "trigger",
          "exclusions",
          "approvalDecisionId"
        ]
      }
    },
    "warrantyMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "classId": {
            "type": "string",
            "minLength": 1
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "thirdPartyResponsibilityConfirmed": {
            "type": "boolean"
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "productGid",
          "classId",
          "exceptions",
          "thirdPartyResponsibilityConfirmed",
          "approvalDecisionId"
        ]
      }
    },
    "leadTimeSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "minLength": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "maxAgeSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "updateSlaSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "owner",
          "process",
          "consumer",
          "maxAgeSeconds",
          "updateSlaSeconds",
          "approvalDecisionId"
        ]
      }
    },
    "leadTimeProjections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectionId": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "productGid": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "scope": {
            "enum": [
              "PRODUCT",
              "PRODUCTVARIANT"
            ]
          },
          "variantGid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^gid://shopify/ProductVariant/[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceUpdatedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
          },
          "fallback": {
            "const": "unknown_no_timing_promise"
          },
          "minDays": {
            "type": "integer",
            "minimum": 0
          },
          "maxDays": {
            "type": "integer",
            "minimum": 0
          },
          "timeBasis": {
            "enum": [
              "calendar_days",
              "business_days"
            ]
          },
          "event": {
            "enum": [
              "dispatch",
              "delivery"
            ]
          },
          "approvalDecisionId": {
            "type": "string",
            "minLength": 1
          },
          "commerceDecisionId": {
            "type": "string",
            "minLength": 1
          },
          "fulfillmentEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "projectionId",
          "sourceId",
          "owner",
          "productGid",
          "scope",
          "sourceUpdatedAt",
          "expiresAt",
          "fallback",
          "minDays",
          "maxDays",
          "timeBasis",
          "event",
          "approvalDecisionId"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "source",
    "approvals",
    "fulfillmentAssignments",
    "profileCapabilities",
    "pickupRules",
    "regionRules",
    "policyVersions",
    "warrantyClasses",
    "warrantyMappings",
    "leadTimeSources",
    "leadTimeProjections"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
