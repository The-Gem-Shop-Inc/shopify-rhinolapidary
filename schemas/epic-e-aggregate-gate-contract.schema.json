          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "string"
            },
            "success": {
              "type": "string"
            },
            "blockedValuesAreArchitectureErrors": {
              "type": "boolean"
            }
          }
        },
        "admin": {
          "type": "object",
          "required": [
            "checks",
            "success",
            "inaccessibleOrStaleExitCode"
          ],
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "string"
            },
            "success": {
              "type": "string"
            },
            "inaccessibleOrStaleExitCode": {
              "type": "integer"
            }
          }
        },
        "migration": {
          "type": "object",
          "required": [
            "checks",
            "success",
            "unauthorizedExitCode"
          ],
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "string"
            },
            "success": {
              "type": "string"
            },
            "unauthorizedExitCode": {
              "type": "integer"
            }
          }
        },
        "all": {
          "type": "object",
          "required": [
            "checks",
            "success",
            "expectedBatch4aExitCode"
          ],
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "string"
            },
            "success": {
              "type": "string"
            },
            "expectedBatch4aExitCode": {
              "type": "integer"
            }
          }
        }
      }
    },
    "exitCodes": {
      "type": "object",
      "required": [
        "0",
        "1",
        "2"
      ],
      "additionalProperties": false,
      "properties": {
        "0": {
          "type": "string"
        },
        "1": {
          "type": "string"
        },
