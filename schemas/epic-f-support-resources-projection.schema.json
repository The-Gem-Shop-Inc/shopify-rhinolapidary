{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhinolapidary.com/schemas/epic-f-support-resources-projection.schema.json",
  "title": "Epic F support and resources projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_only",
    "product_gid",
    "warranty",
    "resources",
    "suppressed"
  ],
  "properties": {
    "fixture_only": {
      "type": "boolean"
    },
    "product_gid": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^gid://shopify/Product/[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "warranty": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warrantyProjection"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceProjection"
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppressed"
      }
    }
  },
  "$defs": {
    "nullableText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "warrantyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "policy_id",
        "revision",
        "roles",
        "duration",
        "trigger",
        "exclusions",
        "exceptions",
        "destination",
        "approval_decision_id",
        "source_ids",
        "class_id",
        "policy_approval_decision_id",
        "class_approval_decision_id",
        "mapping_approval_decision_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "marketed_brand",
            "manufacturer",
            "issuer",
            "administrator",
            "repair_provider"
          ],
          "properties": {
            "marketed_brand": {
              "$ref": "#/$defs/nullableText"
            },
            "manufacturer": {
              "$ref": "#/$defs/nullableText"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "administrator": {
              "type": "string",
              "minLength": 1
            },
            "repair_provider": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "duration": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit": {
                  "enum": [
                    "days",
                    "months",
                    "years"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "destination": {
          "$ref": "#/$defs/nullableText"
        },
        "approval_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_approval_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "class_approval_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_approval_decision_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resourceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "resource_id",
        "type",
        "title",
        "url",
        "language",
        "version",
        "video",
        "approval_decision_id",
        "source_ids"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "manual",
            "diagram",
            "instruction",
            "video"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "video": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "poster_identity",
                "captions_reviewed",
                "width",
                "height",
                "embed_url"
              ],
              "properties": {
                "poster_identity": {
                  "type": "null"
                },
                "captions_reviewed": {
                  "const": true
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "embed_url": {
                  "type": "string",
                  "pattern": "^http://video\\.fixture\\.invalid/embed/[A-Za-z0-9-]+\\?autoplay=0$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suppressed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recordId": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fixture_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "warranty": {
            "maxItems": 0
          },
          "resources": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
