{
  "name": "shopify-rhinolapidary",
  "version": "1.0.0",
  "description": "Refer to the [Upstream Baseline](docs/architecture/trade-upstream-baseline.md) for the baseline of the Shopify Trade theme used in this project.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:ally": "playwright test tests/accessibility.spec.js --workers=1",
    "test:global-chrome-accessibility": "playwright test tests/global-chrome-accessibility.spec.js --project=desktop-chromium --project=mobile-chromium --workers=1",
    "test:smoke": "playwright test tests/storefront-auth.spec.js tests/storefront-smoke.spec.js --workers=1",
    "test:cart": "playwright test tests/cart.spec.js --workers=1",
    "test:navigation": "playwright test tests/navigation.spec.js --workers=1",
    "test:global-chrome-links": "playwright test tests/global-chrome-links.spec.js --workers=1",
    "test:footer-policy-sitemap": "playwright test tests/global-chrome-links.spec.js -g \"footer policy links\" --workers=1",
    "test:header-desktop": "playwright test tests/header-desktop.spec.js --workers=1",
    "test:mobile-drawer": "playwright test tests/mobile-drawer.spec.js --workers=1",
    "test:breadcrumbs": "playwright test tests/breadcrumbs.spec.js --workers=1",
    "test:global-utilities": "playwright test tests/global-utilities.spec.js --workers=1",
    "test:brand-performance": "node scripts/validate-brand-performance-budget.js --runtime --runs=1",
    "test:brand-performance:release": "node scripts/validate-brand-performance-budget.js --runtime --runs=3",
    "test:brand-performance:desktop": "node scripts/validate-brand-performance-budget.js --runtime --desktop --runs=3",
    "test:social-metadata": "node scripts/validate-social-metadata-contract.js && node scripts/validate-social-metadata.js",
    "qa:epic-b:static": "node scripts/run-epic-b-brand-qa.js --mode=static",
    "qa:epic-b:preview": "node scripts/run-epic-b-brand-qa.js --mode=preview",
    "qa:epic-b:all": "node scripts/run-epic-b-brand-qa.js --mode=all",
    "qa:epic-c:responsive": "node scripts/run-epic-c-responsive-qa.js",
    "qa:epic-c:static": "node scripts/run-epic-c-global-chrome-qa.js --mode=static",
    "qa:epic-c:preview": "node scripts/run-epic-c-global-chrome-qa.js --mode=preview",
    "qa:epic-c:all": "node scripts/run-epic-c-global-chrome-qa.js --mode=all",
    "check:placeholders": "node scripts/check-placeholder-content.js",
    "check:rhino-theme-settings": "node scripts/manage-rhino-theme-settings.js --check",
    "audit:app-blocks": "node scripts/audit-app-block-surfaces.js",
    "audit:theme-assets": "node scripts/audit-theme-assets.js",
    "audit:production-files": "node scripts/audit-production-push-files.js",
    "generate:brand-assets": "node scripts/generate-brand-launch-assets.js",
    "generate:rhino-theme-settings-candidate": "node scripts/manage-rhino-theme-settings.js --candidate",
    "validate:registers": "node scripts/validate-json-registers.js",
    "validate:theme-repository": "python scripts/validate-theme-repository.py",
    "theme:check": "shopify theme check --fail-level warning",
    "validate:fixtures": "node scripts/validate-storefront-fixtures.js",
    "validate:product-data": "node scripts/validate-product-csv.js",
    "validate:product-templates": "node scripts/validate-product-templates.js",
    "validate:filters": "node scripts/validate-filter-spec.js",
    "validate:data-architecture": "npm run validate:registers && npm run validate:product-templates && npm run validate:filters && node scripts/validate-product-purchase-architecture.js",
    "validate:cart-config": "node scripts/validate-cart-config.js",
    "validate:search-discovery": "node scripts/validate-search-discovery-state.js",
    "validate:metafields": "node scripts/validate-metafield-architecture.js",
    "validate:navigation": "node scripts/validate-navigation-spec.js",
    "validate:global-navigation-ia": "node scripts/validate-global-navigation-ia.js",
    "test:global-navigation-ia-validator": "node scripts/test-global-navigation-ia-validator.js",
    "validate:footer-support": "node scripts/validate-footer-support-resources.js",
    "test:footer-support-validator": "node scripts/test-footer-support-resources-validator.js",
    "validate:localization-market-safety": "node scripts/validate-localization-market-safety.js",
    "test:localization-market-safety-validator": "node scripts/test-localization-market-safety-validator.js",
    "validate:design-tokens": "node scripts/validate-design-tokens.js",
    "validate:css-architecture": "node scripts/validate-css-architecture.js",
    "validate:rhino-icons": "node scripts/validate-rhino-icons.js",
    "validate:storefront-js": "node scripts/validate-storefront-js-contracts.js",
    "validate:rhino-sections": "node scripts/validate-rhino-sections.js",
    "validate:theme-architecture": "npm run validate:navigation && npm run validate:design-tokens && npm run validate:css-architecture && npm run validate:storefront-js && npm run validate:rhino-sections",
    "validate:stock-assets": "node scripts/validate-stock-assets.js",
    "validate:media": "node scripts/validate-media-manifest.js",
    "validate:stock-remnants": "node scripts/validate-stock-trade-remnants.js",
    "validate:hardcoded-strings": "node scripts/validate-hardcoded-strings.js",
    "validate:cleanup-architecture": "npm run audit:theme-assets && npm run validate:stock-assets && npm run validate:media && npm run validate:stock-remnants && npm run validate:hardcoded-strings",
    "validate:production-readiness": "node scripts/validate-production-readiness.js",
    "validate:settings-data": "node scripts/validate-settings-data.js",
    "validate:theme-environments": "node scripts/validate-theme-environments.js",
    "validate:product-purchase": "node scripts/validate-product-purchase-architecture.js",
    "validate:launch-fixtures": "node scripts/validate-launch-fixtures.js",
    "validate:release-risks": "node scripts/validate-release-risks.js",
    "validate:brand-performance": "node scripts/validate-brand-performance-budget.js",
    "validate:global-chrome-performance": "node scripts/validate-brand-performance-budget.js --report-dir=test-results/epic-c/batch-5",
    "validate:brand-assets": "node scripts/validate-brand-launch-assets.js",
    "validate:brand-migration": "node scripts/validate-brand-content-migration.js",
    "validate:brand-claims": "node scripts/validate-brand-claims.js",
    "test:brand-claims-validator": "node scripts/test-brand-claims-validator.js",
    "validate:brand-launch-governance": "npm run validate:brand-assets && npm run validate:brand-migration && npm run validate:brand-claims",
    "validate:rhino-style-contract": "node scripts/validate-rhino-style-contract.js",
    "validate:rhino-section-patterns": "node scripts/validate-rhino-section-patterns.js",
    "validate:rhino-theme-settings-plan": "node scripts/manage-rhino-theme-settings.js --validate-plan",
    "validate:epic-b-architecture": "npm run validate:design-tokens && npm run validate:css-architecture && npm run validate:rhino-style-contract && npm run validate:rhino-sections && npm run validate:rhino-section-patterns && npm run validate:rhino-theme-settings-plan",
    "validate:epic-b-finalization": "node scripts/validate-epic-b-finalization.js",
    "validate:epic-c-measurement-plan": "node scripts/validate-epic-c-navigation-measurement-plan.js",
    "validate:epic-c-artifacts": "node scripts/validate-epic-c-finalization.js --artifacts-only",
    "validate:epic-c-finalization": "node scripts/validate-epic-c-finalization.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Gem-Shop-Inc/shopify-rhinolapidary.git"
  },
  "keywords": [],
