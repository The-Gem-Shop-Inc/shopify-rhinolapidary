{
  "name": "shopify-rhinolapidary",
  "version": "1.0.0",
  "description": "Refer to the [Upstream Baseline](docs/architecture/trade-upstream-baseline.md) for the baseline of the Shopify Trade theme used in this project.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:ally": "playwright test tests/accessibility.spec.js",
    "test:smoke": "playwright test tests/storefront-smoke.spec.js --workers=1",
    "test:cart": "playwright test tests/cart.spec.js --workers=1",
    "test:navigation": "playwright test tests/navigation.spec.js --workers=1",
    "check:placeholders": "node scripts/check-placeholder-content.js",
    "audit:app-blocks": "node scripts/audit-app-block-surfaces.js",
    "audit:theme-assets": "node scripts/audit-theme-assets.js",
    "audit:production-files": "node scripts/audit-production-push-files.js",
    "validate:registers": "node scripts/validate-json-registers.js",
    "validate:fixtures": "node scripts/validate-storefront-fixtures.js",
    "validate:product-data": "node scripts/validate-product-csv.js",
    "validate:product-templates": "node scripts/validate-product-templates.js",
    "validate:filters": "node scripts/validate-filter-spec.js",
    "validate:data-architecture": "npm run validate:registers && npm run validate:product-templates && npm run validate:filters && node scripts/validate-product-purchase-architecture.js",
    "validate:cart-config": "node scripts/validate-cart-config.js",
    "validate:search-discovery": "node scripts/validate-search-discovery-state.js",
    "validate:metafields": "node scripts/validate-metafield-architecture.js",
    "validate:navigation": "node scripts/validate-navigation-spec.js",
    "validate:design-tokens": "node scripts/validate-design-tokens.js",
    "validate:css-architecture": "node scripts/validate-css-architecture.js",
    "validate:storefront-js": "node scripts/validate-storefront-js-contracts.js",
    "validate:rhino-sections": "node scripts/validate-rhino-sections.js",
    "validate:theme-architecture": "npm run validate:navigation && npm run validate:design-tokens && npm run validate:css-architecture && npm run validate:storefront-js && npm run validate:rhino-sections",
    "validate:stock-assets": "node scripts/validate-stock-assets.js",
    "validate:media": "node scripts/validate-media-manifest.js",
    "validate:stock-remnants": "node scripts/validate-stock-trade-remnants.js",
    "validate:hardcoded-strings": "node scripts/validate-hardcoded-strings.js",
    "validate:cleanup-architecture": "npm run audit:theme-assets && npm run validate:stock-assets && npm run validate:media && npm run validate:stock-remnants && npm run validate:hardcoded-strings",
    "validate:production-readiness": "node scripts/validate-production-readiness.js && node scripts/audit-production-push-files.js",
    "validate:settings-data": "node scripts/validate-settings-data.js",
    "validate:theme-environments": "node scripts/validate-theme-environments.js",
    "validate:product-purchase": "node scripts/validate-product-purchase-architecture.js",
    "validate:launch-fixtures": "node scripts/validate-launch-fixtures.js",
    "validate:release-risks": "node scripts/validate-release-risks.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Gem-Shop-Inc/shopify-rhinolapidary.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/The-Gem-Shop-Inc/shopify-rhinolapidary/issues"
  },
  "homepage": "https://github.com/The-Gem-Shop-Inc/shopify-rhinolapidary#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2"
  }
}
