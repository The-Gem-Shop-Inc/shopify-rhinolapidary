 :root {
     /* Code brand colors */
     --rhino-color-red-500: #ed1c24;
@@ -1689,3 +1726,53 @@ textarea.rhino-field__control {
         font-size: 1.4rem;
     }
 }
+/* Conditional machine facts: semantic source order, no fixed-width values. */
+.rhino-machine-facts { margin-block: 3rem; min-width: 0; }
+.rhino-machine-facts :is(h2, h3, dt, dd, p, a, span) { overflow-wrap: anywhere; }
+.rhino-machine-facts dl { margin: 0; }
+.rhino-machine-fact-row { padding-block: 1rem; border-bottom: 1px solid rgba(var(--color-foreground), .2); }
+.rhino-machine-fact-row dt { font-weight: 600; }
+.rhino-machine-fact-row dd { margin: .5rem 0 0; }
+.rhino-machine-fact-context { display: block; margin-top: .5rem; }
+.rhino-machine-contents-list { list-style: none; padding: 0; display: grid; gap: 2rem; }
+.rhino-machine-component, .rhino-machine-component .card-wrapper { min-width: 0; }
+@media screen and (min-width: 750px) {
+  .rhino-machine-fact-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; }
+  .rhino-machine-fact-row dd { margin: 0; }
+  .rhino-machine-contents-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+/* F6 conditional resources reuse Trade DeferredMedia; no additional controller. */
+.rhino-machine-resource-list {
+  padding-inline-start: 2rem;
+}
+.rhino-machine-resource-list > li {
+  margin-block: 1.6rem;
+  overflow-wrap: anywhere;
+}
+.rhino-machine-resource-list > li > span {
+  display: block;
+}
+.rhino-machine-resource-video {
+  display: block;
+  position: relative;
+  width: 100%;
+  margin-block-start: 0.8rem;
+}
+.rhino-machine-resource-video > button {
+  width: 100%;
+  min-height: 100%;
+  height: auto;
+  padding: 1.6rem;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
+.rhino-machine-resource-video[loaded] > button {
+  display: none;
+}
+.rhino-machine-resource-video > iframe {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
