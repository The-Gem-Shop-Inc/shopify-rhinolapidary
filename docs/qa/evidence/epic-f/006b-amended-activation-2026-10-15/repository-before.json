      "body": "'use strict';\n// Additive E authority for the two completed October worksheets. No catalog split.\nconst fs=require('node:fs'),assert=require('node:assert/strict'),E=require('./epic-e-owner-response-adapter');\nconst DIR='docs/qa/evidence/epic-f/007b-008b-owner-followup-2026-10-14',RESPONSES='data/epic-e-bom-owner-followup.json',RECEIPT=DIR+'/reconciliation.json';\nconst EM='gid://shopify/Product/8905780756677';\nconst SOURCES=['docs/product/007B-remaining-contents-and-bom.pdf','docs/product/008B-remaining-compatibility-and-product-identity.pdf'];\nfunction prepare(){\n const original=E.validateResponses(),lines=original.contents,normalized=[];\n function add(id,label,quantity,componentProductGid=null,extra={}){normalized.push({identity:componentProductGid||'product-local:'+EM+':'+id,componentProductGid,noncatalogIdentity:componentProductGid?null:'product-local:'+EM+':'+id,label,included:true,quantity,grouping:null,executable:quantity!==null,hold:quantity===null?'Owner confirmed membership; positive quantity unanswered':null,...extra});}\n for(let i=1;i<=6;i++){const l=lines.find(l=>l.lineId==='EM1-'+String(i).padStart(2,'0'));const p=require('../../data/epic-e-product-identity.json').productIdentities.find(p=>p.productGid===l.ownerComponentProductGid);assert(p);add(l.lineId,i===1?'6\" Bonded Diamond Wheel 80 grit':l.label,1,p.productGid);}\n add('EM1-07-package','Flexible-shaft packaged set (flexible shaft, 18-piece accessory set and 3 attachment heads)',1,null,{grouping:'ONE_PACKAGED_SET',components:[{label:'Flexible shaft',quantity:1},{label:'Accessory set',pieceCount:18},{label:'Attachment heads',quantity:3}],sourceQuestion:'007B page 2, one packaged set'});\n for(const [id,label,n]of [ ['EM1-08-spindles','Silversmithing spindles',2],['EM1-08-wheels','Sanding/polishing wheels',3],['EM1-09','DIALUX Superfinishing Paste',1],['EM1-10','DIALUX Polishing Paste',1],['EM1-11-lap','Flat lap',1],['EM1-11-felt','Magnetic felt pad',1],['EM1-11-disc','Magnetic 80-grit disc',1],['EM1-12','Magnifying glass attachment',1],['EM1-13','Jointed light attachment',1],['EM1-14','Wrist rests',2],['EM1-15-pump','Water pump',1],['EM1-15-tank','Tank filtration system',1],['EM1-16-right','Right-side shield (loose included item)',1],['EM1-17','Moss Filtration Pads',2],['EM1-18','Brass spray nozzles',2],['EM1-19','Spoke wrench',1],['EM1-20','Hex key',1],['EM1-21','Crescent wrench',1] ])add(id,label,n);\n for(const [id,label]of [['8905782034629','Left Moss Pad'],['8905783574725','Right Moss Pad']])add(id,label,null,'gid://shopify/Product/'+id);\n const executable=normalized.filter(l=>l.executable),catalog=executable.filter(l=>l.componentProductGid),noncatalog=executable.filter(l=>!l.componentProductGid);\n const sources=SOURCES.map(path=>({path,sha256:E.hash(fs.readFileSync(path))})),decision='COMPLETED-007B:'+sources[0].sha256;\n const desired={included_products:catalog.map(l=>l.componentProductGid),included_quantities:Object.fromEntries(catalog.map(l=>[l.componentProductGid,l.quantity])),noncatalog_components:noncatalog.map(l=>({label:l.label,quantity:l.quantity,meaning:'included'}))};\n const rows=Object.entries(desired).map(([key,value])=>({rowId:'OCT14:'+EM.split('/').pop()+':'+key,kind:'value',targetGid:EM,domain:'included_components',planId:'E-MUT-035',field:'PRODUCT.metafields.rhino.'+key,type:E.definition(key).type,desired:value,valueState:'approved',approvalDecisionId:decision,conflictIds:[],ownerDecisionId:'B3B-D04',sourceExcerpt:'Completed 007B pages 1–2; original owner-confirmed 80-grit identity and Moss Filtration Pads quantity 2',provenance:{sourceId:decision,configurationId:'CURRENT_PRODUCT:'+EM}}));\n return {schemaVersion:1,approvalMode:'delegated_development_override',sources,priorOwnerSource:original.source,normalized,rows,assemblyEvidence:[{identity:'product-local:'+EM+':EM1-16-left-affixed',label:'Left-side shield',physicalState:'AFFIXED_TO_MACHINE',customerContentsLine:false,quantity:null,sourceExcerpt:'Left side is affixed'}],quantityOneScope:'Only the 19 items explicitly listed in the default-single-item question; package subcomponents have no independent contents line',variableSpeed:[{productGid:'gid://shopify/Product/8905781412037',state:'CURRENT_OPTION_CONFIRMED_NEW_VARIANT_PREPARATION_ONLY'},{productGid:'gid://shopify/Product/8905781477573',state:'CURRENT_OPTION_CONFIRMED_NEW_VARIANT_PREPARATION_ONLY'}],vice:{decisionId:'PO-E-013',state:'DECIDED_PENDING_CATALOG_SPLIT',existingProductGid:'gid://shopify/Product/8905784099013',existingFinalTitle:'Saw Vice Plate Set - SawMaster 18',newProductGid:null,newFinalTitle:'Saw Vice Plate Set - SawMaster 24',historicalIdentities:{'BK-450-24':'SawMaster 18','BK-600-24':'SawMaster 24'},additionalTechnicalDifferences:'ADDITIONAL_TECHNICAL_DIFFERENCES_PENDING',compatibility:'BOTH_EDGES_BLOCKED_UNTIL_EXACT_CATALOG_SPLIT'},reviewerName:null,reviewedAt:null,signature:'Not supplied; factual authority is the completed worksheet accepted by the authorized user'};\n}\nfunction validate(input=E.read(RESPONSES)){assert.deepEqual(input,prepare(),'Exact worksheet projection drift');assert.equal(input.normalized.length,27);assert.equal(input.normalized.filter(l=>l.executable).length,25);assert.equal(input.rows.length,3);const ids=require('../../data/epic-e-product-identity.json').productIdentities;for(const l of input.normalized){if(l.componentProductGid)assert(ids.some(p=>p.productGid===l.componentProductGid));if(l.executable)assert(Number.isSafeInteger(l.quantity)&&l.quantity>0);}const [members,quantities,noncat]=input.rows;assert(require('./epic-f-facts').quantityMap(quantities.desired,members.desired));assert.equal(noncat.desired.length,19);assert.equal(new Set(noncat.desired.map(l=>l.label)).size,19);assert.equal(input.normalized.filter(l=>l.grouping).length,1);return input;}\nfunction mutationInput(row,product){assert(validate().rows.some(r=>E.digest(r)===E.digest(row)));const actual=E.compareRow(row,product);if(actual.state==='EXACT')return null;if(actual.state==='CONFLICT'){assert(row.field.endsWith('.noncatalog_components'));const old=E.validateResponses().rows.find(r=>r.field.endsWith('.noncatalog_components'));assert.equal(E.compareRow(old,product).state,'EXACT','Only replace the prior reconciled Moss ×2 projection');}if(actual.metafield)assert(typeof actual.metafield.compareDigest==='string'&&actual.metafield.compareDigest.length>0,'Fresh CAS digest required for existing value');return {ownerId:row.targetGid,namespace:'rhino',key:row.field.split('.').pop(),type:row.type,value:JSON.stringify(row.desired),compareDigest:actual.metafield?.compareDigest??null};}\nfunction proof(before,after,rows=validate().rows){E.catalogComplete(before);E.catalogComplete(after);const keys=new Set(rows.map(r=>r.field.split('.').pop()));const clean=p=>{const q=structuredClone(p);if(p.id===EM){delete q.updatedAt;q.metafields.nodes=q.metafields.nodes.filter(m=>m.namespace!=='rhino'||!keys.has(m.key));}return require('./epic-f-live-machine-activation').protectedComparable(q);};assert.equal(E.digest(before.products.map(clean)),E.digest(after.products.map(clean)),'Unexpected protected Product/Variant change');return {protectedProducts:122,protectedVariants:before.products.reduce((n,p)=>n+p.variants.nodes.length,0),unexpectedProtectedChanges:0,rows:rows.map(r=>{const a=E.compareRow(r,after.products.find(p=>p.id===r.targetGid));assert.equal(a.state,'EXACT');const b=E.compareRow(r,before.products.find(p=>p.id===r.targetGid));if(b.metafield)assert.equal(a.metafield.id,b.metafield.id);return {rowId:r.rowId,planId:r.planId,domain:r.domain,targetGid:r.targetGid,field:r.field,desiredDigest:E.digest(r.desired),metafieldGid:a.metafield.id,type:a.metafield.type,definitionGid:a.metafield.definition.id,identityPreserved:true};})};}\nfunction loadCurrent(asOf=new Date().toISOString()){\n if(!fs.existsSync(RECEIPT))return E.loadReconciled(asOf);\n const input=validate(),receipt=E.read(RECEIPT);assert.equal(receipt.responseSha256,E.hash(fs.readFileSync(RESPONSES)));for(const ref of [receipt.before,receipt.after,receipt.journal,receipt.definitionsBefore,receipt.definitionsAfter])assert.equal(E.hash(fs.readFileSync(ref.path)),ref.sha256);assert(Date.parse(asOf)>=Date.parse(receipt.reconciledAt)&&Date.parse(asOf)<Date.parse(receipt.expiresAt),'Reconciliation stale');\n const before=E.read(receipt.before.path),after=E.read(receipt.after.path);assert.deepEqual(proof(before,after),receipt.mutationProof);assert.deepEqual(E.read(receipt.definitionsBefore.path).response.data.metafieldDefinitions.nodes,E.read(receipt.definitionsAfter.path).response.data.metafieldDefinitions.nodes);\n const old=E.validateResponses(),rows=[...old.rows.filter(r=>!r.field.endsWith('.noncatalog_components')),...input.rows];assert.equal(rows.length,72);const currentProof=rows.map(r=>{const c=E.compareRow(r,after.products.find(p=>p.id===r.targetGid));assert.equal(c.state,'EXACT','Current reconciled row mismatch '+r.rowId);return {rowId:r.rowId,planId:r.planId,domain:r.domain,targetGid:r.targetGid,field:r.field,desiredDigest:E.digest(r.desired),metafieldGid:c.metafield.id,type:c.metafield.type,definitionGid:c.metafield.definition.id,identityPreserved:true};});assert.deepEqual(currentProof,receipt.proof.rows);\n const journal=E.read(receipt.journal.path);assert.equal(journal.failed.length,0);assert.equal(journal.completed.length,3);assert.deepEqual(journal.completed.map(r=>r.rowId).sort(),input.rows.map(r=>r.rowId).sort());for(const r of currentProof.filter(r=>!r.rowId.startsWith('OCT14:'))){assert.equal(E.read(E.RECEIPT).proof.rows.find(n=>n.rowId===r.rowId).metafieldGid,r.metafieldGid);assert.equal(E.compareRow(rows.find(n=>n.rowId===r.rowId),before.products.find(p=>p.id===r.targetGid)).state,'EXACT');}\n return {input:{...old,rows,followupSource:input.sources},products:after.products,receipt,receiptPath:RECEIPT,receiptHash:E.hash(fs.readFileSync(RECEIPT))};\n}\nfunction ownerRowApproved(row,input){const {before,...r}=row;if(r.rowId.startsWith('OCT14:'))return validate().rows.some(n=>E.digest(n)===E.digest(r));return E.ownerRowApproved(r,E.validateResponses());}\nmodule.exports={DIR,RESPONSES,RECEIPT,EM,SOURCES,prepare,validate,mutationInput,proof,loadCurrent,ownerRowApproved};\n"
