        "originalBody": "'use strict';\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst { read, write } = require('./lib/epic-f-governance');\nconst { validate, packetPath } = require('./lib/epic-f-machine-page-readiness');\nconst original = read(packetPath), cases = [];\nassert.deepEqual(validate(original), [], 'Real packet must pass while release remains blocked');\ncases.push('source-bound safe suppression packet passes with stale Admin and blocked release');\nfunction reject(name, mutate, expectedError) {\n    const packet = structuredClone(original);\n    mutate(packet);\n    const errors = validate(packet);\n    assert(errors.length > 0, name);\n    if (expectedError) assert(errors.some(e => e.includes(expectedError)), `${name}: ${errors.join('; ')}`);\n    cases.push(name);\n}\nconst domain = (p, id) => p.domainMatrix.find(d => d.id === id);\nreject('missing machine', p => p.machines.pop());\nreject('duplicate machine', p => p.machines[1] = p.machines[0]);\nreject('unknown Product GID', p => p.machines[0].productGid = 'gid://shopify/Product/1');\nreject('only published machines sampled', p => p.machines = p.machines.filter(m => !m.rolloutAssessment.historicalEligibility.includes('excluded')));\nreject('draft machine omitted', p => p.machines = p.machines.filter(m => m.productGid !== 'gid://shopify/Product/8905785868485'));\nreject('renderer complete does not approve fact', p => domain(p, 'specifications').valueState = 'approved', 'Readiness conflation');\nreject('fixture approval cannot activate customer facts', p => domain(p, 'contents').activationAuthorization = 'granted', 'Readiness conflation');\nreject('suppression does not imply fact readiness', p => domain(p, 'warranty').valueState = 'approved', 'Readiness conflation');\nreject('repository test green cannot make Admin current', p => p.adminEvidence.state = 'current');\nreject('old snapshot present cannot make Admin current', p => p.adminEvidence.snapshots[0].state = 'current', 'Stale Admin labeled current');\nreject('snapshot expiry cannot be extended by generation time', p => p.adminEvidence.snapshots[0].expiresAt = p.assessedAt);\nreject('zero media grants changed to one', p => p.realGrants.counts[0].current = 1, 'Unauthorized media');\nfor (const row of original.realGrants.counts.slice(1)) reject(`zero ${row.domain} grants changed to one`, p => p.realGrants.counts.find(r => r.domain === row.domain).current = 1, `Unauthorized ${row.domain}`);\nreject('unknown nonzero grant fails closed with exact source', p => p.realGrants.unexpectedGrants.push({ source: 'data/epic-f-consumer-release.json', domain: 'unexpected_domain', grant: { domain: 'unexpected_domain', productGid: p.machines[0].productGid } }), 'Unauthorized real grant: unexpected_domain in data/epic-f-consumer-release.json');\nreject('suppressed module presented as active', p => p.machines[0].modules[0].customerPresentation = 'active');\nreject('proposed classification cannot be live migrated', p => { p.machines[0].classification.sourceValueState = 'proposed'; p.machines[0].classification.liveValue = 'machine'; p.machines[0].classification.migrationReconciliation = 'reconciled'; });\nfor (const id of ['004B', '006B', '007B', '008B', '009B', '010B', '011B', '014B', '015B', '018B']) reject(`${id} incorrectly complete`, p => p.pbiStates[`F-PBI-${id}`] = 'complete');\nreject('017B incorrectly authorized', p => { p.pbiStates['F-PBI-017B'] = 'complete'; p.authorizations.productTemplateAssignment = true; });\nreject('018 overall incorrectly complete', p => p.pbiStates['F-PBI-018'] = 'complete');\nreject('rollout plan ready cannot authorize assignment', p => p.rollout.execution = 'authorized');\nreject('conditional future candidate cannot become executable', p => p.rollout.executableTargetGids.push(p.rollout.conditionalFutureCandidateGids[0]), 'rollout GO/execution forbidden');\nreject('conditional future candidate cannot become eligible', p => p.rollout.eligibleCurrentTargetGids.push(p.rollout.conditionalFutureCandidateGids[0]), 'rollout GO/execution forbidden');\nreject('exclusion silently removed', p => p.rollout.exclusions.pop());\nfor (const role of ['Product Owner', 'Shopify Admin Owner']) reject(`only ${role} GO cannot authorize`, p => p.rollout.GO.find(a => a.role === role).granted = true, 'rollout GO/execution forbidden');\nreject('both GO roles cannot be invented in F8', p => p.rollout.GO.forEach(a => a.granted = true));\nreject('instrumentation falsely active from complete contract', p => { p.measurement.active = true; p.measurement.instrumentation = 'active'; });\nreject('analytics events cannot be emitted', p => p.measurement.emittedEvents = 1);\nreject('manual URL working cannot make canonical resource', p => domain(p, 'resources').valueState = 'approved', 'Readiness conflation');\nreject('policy route existing cannot approve warranty', p => domain(p, 'warranty').valueState = 'approved', 'Readiness conflation');\nreject('native pickup cannot approve seasonal pickup', p => domain(p, 'delivery').valueState = 'approved', 'Readiness conflation');\nreject('native payment terms cannot resolve F-DEC-001', p => { p.pbiStates['F-DEC-001'] = 'complete'; domain(p, 'payment_decision').valueState = 'approved'; });\nreject('local performance pass cannot certify release', p => p.performance.releaseCertification = 'complete');\nreject('single local observations cannot become release median', p => p.performance.releaseMedian = 50);\nreject('accessibility fixtures cannot verify Shopify parity', p => { p.accessibility.shopifyParity = 'verified'; domain(p, 'accessibility').shopifyParity = 'verified'; });\nreject('historical diagnostic signature drift', p => p.historicalDiagnostics.ownership.sha256 = '0'.repeat(64), 'Historical signature drift');\nreject('Product CSV total changed without owned evidence', p => p.historicalDiagnostics.productCsv.findingCount = 102, 'Historical signature drift');\nreject('Product CSV 95/8 categories changed', p => p.historicalDiagnostics.productCsv.findings[0] = '- price only', 'CSV 95/8');\nreject('37 historical claims disappeared', p => p.historicalDiagnostics.descriptionClaims.count = 0, 'Claim/manual diagnostic drift');\nreject('seven broken manual destinations disappeared', p => p.historicalDiagnostics.manuals.routes.pop(), 'Claim/manual diagnostic drift');\nreject('stale upstream hash', p => p.evidenceProvenance[0].sha256 = '0'.repeat(64), 'Missing/stale provenance');\nreject('missing evidence source', p => p.evidenceProvenance.pop(), 'Source-bound readiness mismatch');\nreject('nonexistent evidence source', p => p.evidenceProvenance[0].path = 'data/missing-evidence.json', 'Missing/stale provenance');\nreject('JSON-LD blocked fallback incorrectly retained', p => p.jsonLd.governedTechnicalRelationshipSupportFacts = 'present');\nreject('global ready boolean forbidden', p => p.ready = true);\nreject('releaseReady inferred from repository pass forbidden', p => p.releaseReady = true);\nreject('production publication authorization forbidden', p => p.authorizations.productionPublication = true);\nreject('runtime changes outside F8 scope forbidden', p => p.delta.newRuntimeJavaScript = 1);\nfs.mkdirSync('test-results/epic-f/f8', { recursive: true });\nwrite('test-results/epic-f/f8/readiness-tests.json', { cases, passed: cases.length, failed: 0, mutations: 0, emittedEvents: 0 });\nconsole.log(`F8 readiness: ${cases.length} adversarial checks passed; no events or mutations`);\n",
