    {
      "path": "scripts/deploy-epic-f-owner-activation.js",
      "sha256": "eec602f8dcd155ae84ee80449ff9eba26ba2fd3ee76faf3076fc9649571d471a",
      "body": "'use strict';\nconst fs=require('node:fs'),assert=require('node:assert/strict'),cp=require('node:child_process');\nconst E=require('./lib/epic-e-owner-response-adapter'),H=require('./lib/epic-f-owner-activation-binding');\nconst {CLI,cleanEnv}=require('./deploy-epic-f-header-focus-correction');\nconst {sanitize}=require('./smoke-epic-f-live-machine-activation');\nconst targets={preview:{id:'158631198917',role:'UNPUBLISHED',name:'Rhino Lapidary - Preview'},main:{id:'158579622085',role:'MAIN',name:'shopify-rhinolapidary/main'}};\nconst write=(name,value)=>fs.writeFileSync(E.DIR+'/'+name+'.json',JSON.stringify(value,null,2)+'\\n');\nfunction inventory(theme){assert.equal(theme.files.pageInfo.hasNextPage,false);return Object.fromEntries(theme.files.nodes.map(r=>[r.filename,r.checksumMd5]));}\nfunction before(name){const target=targets[name];assert(target);const binding=H.verify(),record=E.read(E.DIR+'/themes-'+name+'-before-push.json');assert(Date.now()-Date.parse(record.completedAt)<300000,'Fresh before-push theme read required');const t=record.response.data[name];assert.equal(t.id,'gid://shopify/OnlineStoreTheme/'+target.id);assert.equal(t.role,target.role);assert.equal(t.name,target.name);assert.deepEqual(inventory(t),inventory(E.read(E.DIR+'/themes-before.json').response.data[name]),'Remote source changed since development before-read');const local=E.read(E.DIR+'/local-validation.json');assert.equal(local.exitCode,0,'F1-F8 must pass before push');assert.equal(local.sourceBindingSha256,binding.bindingSha256);assert.equal(E.read(E.DIR+'/adapter-compiler-tests.json').failed,0);if(name==='main'){const p=E.read(E.DIR+'/preview-browser.json');assert.equal(p.failed,0);assert.equal(p.cells.length,16);assert.equal(p.bindingSha256,binding.bindingSha256);assert.equal(E.read(E.DIR+'/preview-readback-proof.json').unplannedFileChanges,0);}return {binding,target};}\nasync function run(name){const {binding,target}=before(name);const args=['theme','push','--store','sz5dnk-nf.myshopify.com','--theme',target.id,'--path','.'];for(const file of H.RUNTIME)args.push('--only',file);args.push('--nodelete','--strict',...(name==='main'?['--allow-live']:[]),'--json');assert(!args.includes('--publish'));fs.writeFileSync(E.DIR+'/'+name+'-push-reservation.json',JSON.stringify({startedAt:new Date().toISOString(),bindingSha256:binding.bindingSha256,target:target.id,files:H.RUNTIME})+'\\n',{flag:'wx'});let stdout='',stderr='';const startedAt=new Date().toISOString(),child=cp.spawn(process.execPath,[CLI,...args],{env:cleanEnv(),windowsHide:true,stdio:['ignore','pipe','pipe']});child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('exit',resolve);});const objects=[];try{objects.push(JSON.parse(stdout));}catch{for(const line of stdout.split(/\\r?\\n/))try{objects.push(JSON.parse(line));}catch{}}const result=objects.find(v=>v.theme);write(name+'-push',{startedAt,completedAt:new Date().toISOString(),bindingSha256:binding.bindingSha256,target:target.id,files:H.RUNTIME,command:['shopify',...args],exitCode,result:result||null,stdout:sanitize(stdout),stderr:sanitize(stderr),publication:false,ProductMutations:0});assert.equal(exitCode,0,'Inspect readback before any retry');assert.equal(String(result?.theme.id),target.id);assert.equal(result.theme.role,name==='main'?'live':'unpublished');console.log(JSON.stringify({target:target.id,files:H.RUNTIME.length,exitCode,publication:false}));}\nfunction readback(name){const b=H.verify(),target=targets[name],r=E.read(E.DIR+'/themes-'+name+'-after-push.json'),theme=r.response.data[name],base=E.read(E.DIR+'/themes-'+name+'-before-push.json').response.data[name];assert.equal(theme.role,target.role);assert.equal(theme.name,target.name);const old=inventory(base),now=inventory(theme),changed=Object.keys(now).filter(f=>old[f]!==now[f]),deleted=Object.keys(old).filter(f=>!now[f]),unplanned=changed.filter(f=>!H.RUNTIME.includes(f));assert.deepEqual(deleted,[]);assert.deepEqual(unplanned,[]);const rows=[];for(const file of H.RUNTIME){const source=theme.source.nodes.find(n=>n.filename===file);assert(source,'Missing deployed '+file);const actual=E.hash(source.body.content),expected=E.hash(fs.readFileSync(file));assert.equal(actual,expected,'Exact body mismatch '+file);rows.push({path:file,sha256:actual});}for(const ref of b.sourceAfter.filter(f=>!H.RUNTIME.includes(f.path))){const source=theme.source.nodes.find(n=>n.filename===ref.path);assert(source);const predecessor=base.source.nodes.find(n=>n.filename===ref.path);assert(predecessor);assert.equal(E.hash(source.body.content),E.hash(predecessor.body.content),'Protected remote source changed '+ref.path);}write(name+'-readback-proof',{observedAt:r.completedAt,bindingSha256:b.bindingSha256,target:target.id,runtimeFiles:rows,changedFileCount:changed.length,unplannedFileChanges:0,deletedFiles:0,publication:false});console.log(JSON.stringify({target:name,exactFiles:rows.length,unplannedFileChanges:0}));}\nif(require.main===module){const name=process.argv[2];(process.argv.includes('--readback')?Promise.resolve().then(()=>readback(name)):run(name)).catch(e=>{console.error(sanitize(e.stack));process.exitCode=1;});}module.exports={targets,before,readback,run};\n"
    },
