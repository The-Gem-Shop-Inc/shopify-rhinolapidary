  "files": [
    {
      "path": "assets/rhino-custom.css",
      "sha256": "32f44d332f5b1d51b95213292c54d6e5c17751ebf4e79878eba4e2c17ce5f961",
      "body": "/*\r\n * Rhino Lapidary brand and interface foundation.\r\n *\r\n * Rules:\r\n * - Keep Rhino-specific styling here or in future assets/rhino-*.css files.\r\n * - Prefer --rhino-* custom properties.\r\n * - Do not edit inherited Trade CSS for Rhino-specific visual changes unless documented.\r\n *\r\n * Source PBIs:\r\n * - B-005 Accessible color system\r\n * - B-006 Typography and technical hierarchy\r\n * - B-007 Layout, spacing, and surfaces\r\n * - B-008 Buttons, links, and CTA hierarchy\r\n * - B-009 Forms and storefront states\r\n *\r\n * Architecture:\r\n * - Keep Rhino-owned selectors prefixed with `.rhino-`.\r\n * - Keep Rhino-owned customer properties prefixed with `--rhino-`.\r\n * - Do not reproduce Trade component CSS in this file.\r\n * - Apply component classes intentionally during preview implementation.\r\n */\r\n\r\n.rhino-machine-shell .product--no-media .product__info-wrapper {\r\n    min-width: 0;\r\n    width: 100%;\r\n}\r\n\r\n.rhino-machine-shell .product__title,\r\n.rhino-machine-shell .price,\r\n.rhino-machine-shell .form__label,\r\n.rhino-machine-shell .product-form__input label,\r\n.rhino-machine-shell .button {\r\n    overflow-wrap: anywhere;\r\n    white-space: normal;\r\n}\r\n\r\n.rhino-machine-shell .product-form__input,\r\n.rhino-machine-shell .product-form__buttons,\r\n.rhino-machine-shell .price__container {\r\n    min-width: 0;\r\n    max-width: 100%;\r\n}\r\n\r\n.rhino-machine-shell .product-form__input input[type='radio'] + label {\r\n    max-width: 100%;\r\n}\r\n\r\n.rhino-machine-shell .button {\r\n    height: auto;\r\n    padding-block: var(--rhino-space-3);\r\n}\r\n\r\n.rhino-machine-shell .rhino-machine-contact {\r\n    display: flex;\r\n    width: fit-content;\r\n    max-width: 100%;\r\n    margin-inline: auto;\r\n}\r\n\r\n:root {\r\n    /* Code brand colors */\r\n    --rhino-color-red-500: #ed1c24;\r\n    --rhino-color-red-700: #b51820;\r\n    --rhino-color-red-900: #791716;\r\n    --rhino-color-gold-500: #b6830d;\r\n    --rhino-color-black: #000000;\r\n    --rhino-color-white: #ffffff;\r\n\r\n    /* Neutral interface colors */\r\n    --rhino-color-carbon: #111111;\r\n    --rhino-color-graphite: #2b2d30;\r\n    --rhino-color-steel: #5d6670;\r\n    --rhino-color-alloy: #c9cdd2;\r\n    --rhino-color-mist: #f3f4f5;\r\n    --rhino-color-warm-white: #fcfbf8;\r\n\r\n    /* Functional colors */\r\n    --rhino-color-link: #a3151c;\r\n    --rhino-color-info: #0b5ea8;\r\n    --rhino-color-success: #1f6b45;\r\n    --rhino-color-warning: #7a4a00;\r\n    --rhino-color-error: #b42318;\r\n\r\n    /* Functional surfaces */\r\n    --rhino-color-info-surface: #eef6fc;\r\n    --rhino-color-success-surface: #eef8f2;\r\n    --rhino-color-warning-surface: #fff7e8;\r\n    --rhino-color-error-surface: #fff1f0;\r\n\r\n    /* Semantic color aliases */\r\n    --rhino-color-brand-primary: var(--rhino-color-red-500);\r\n    --rhino-color-action: var(--rhino-color-red-700);\r\n    --rhino-color-action-hover: var(--rhino-color-red-900);\r\n    --rhino-color-focus: var(--rhino-color-red-500);\r\n    --rhino-color-surface: var(--rhino-color-white);\r\n    --rhino-color-surface-alternate: var(--rhino-color-mist);\r\n    --rhino-color-surface-editorial: var(--rhino-color-warm-white);\r\n    --rhino-color-surface-dark: var(--rhino-color-carbon);\r\n    --rhino-color-text: var(--rhino-color-carbon);\r\n    --rhino-color-text-muted: var(--rhino-color-steel);\r\n    --rhino-color-border: var(--rhino-color-alloy);\r\n    --rhino-color-border-strong: var(--rhino-color-graphite);\r\n    --rhino-color-focus-shadow: rgba(237, 28, 36, 0.2);\r\n    --rhino-color-overlay-dark: rgba(17, 17, 17, 0.88);\r\n\r\n    /* Font family and weight */\r\n    --rhino-font-family-sans:\r\n        \"DM Sans\",\r\n        var(--font-heading-family),\r\n        Arial,\r\n        sans-serif;\r\n    --rhino-font-weight-regular: 400;\r\n    --rhino-font-weight-medium: 500;\r\n    --rhino-font-weight-semibold: 600;\r\n    --rhino-font-weight-bold: 700;\r\n\r\n    /* General type scale */\r\n    --rhino-font-size-xs: 1.2rem;\r\n    --rhino-font-size-sm: 1.3rem;\r\n    --rhino-font-size-compact: 1.4rem;\r\n    --rhino-font-size-button: 1.5rem;\r\n    --rhino-font-size-body: 1.6rem;\r\n    --rhino-font-size-lg: 1.8rem;\r\n    --rhino-font-size-xl: 2rem;\r\n    --rhino-font-size-2xl: 2.4rem;\r\n    --rhino-font-size-3xl: 2.8rem;\r\n    --rhino-font-size-4xl: 3.2rem;\r\n    --rhino-font-size-5xl: 4rem;\r\n\r\n    /* Semantic type roles */\r\n    --rhino-type-page-title-size: var(--rhino-font-size-4xl);\r\n    --rhino-type-page-title-line-height: 1.25;\r\n    --rhino-type-product-title-size: var(--rhino-font-size-3xl);\r\n    --rhino-type-product-title-line-height: 1.285;\r\n    --rhino-type-section-title-size: var(--rhino-font-size-2xl);\r\n    --rhino-type-section-title-line-height: 1.333;\r\n    --rhino-type-subsection-title-size: var(--rhino-font-size-xl);\r\n    --rhino-type-subsection-title-line-height: 1.4;\r\n    --rhino-type-body-line-height: 1.625;\r\n    --rhino-type-compact-line-height: 1.571;\r\n    --rhino-type-label-letter-spacing: 0.08em;\r\n\r\n    /* Spacing scale */\r\n    --rhino-space-1: 0.4rem;\r\n    --rhino-space-2: 0.8rem;\r\n    --rhino-space-3: 1.2rem;\r\n    --rhino-space-4: 1.6rem;\r\n    --rhino-space-5: 2.4rem;\r\n    --rhino-space-6: 3.2rem;\r\n    --rhino-space-7: 4.8rem;\r\n    --rhino-space-8: 6.4rem;\r\n    --rhino-space-9: 9.6rem;\r\n\r\n    /* Width and gutters */\r\n    --rhino-width-canvas: 140rem;\r\n    --rhino-width-content: 112rem;\r\n    --rhino-width-prose: 72rem;\r\n    --rhino-width-form: 64rem;\r\n    --rhino-page-gutter: var(--rhino-space-4);\r\n\r\n    /* Section rhythm */\r\n    --rhino-section-spacing-y: 4rem;\r\n    --rhino-section-spacing-dense-y: var(--rhino-space-5);\r\n    --rhino-section-spacing-major-y: var(--rhino-space-8);\r\n\r\n    /* Borders */\r\n    --rhino-border-width: 0.1rem;\r\n    --rhino-border-width-accent: 0.4rem;\r\n    --rhino-border-standard:\r\n        var(--rhino-border-width)\r\n        solid\r\n        var(--rhino-color-border);\r\n    --rhino-border-strong:\r\n        var(--rhino-border-width)\r\n        solid\r\n        var(--rhino-color-border-strong);\r\n\r\n    /* Radii */\r\n    --rhino-radius-control: 0.4rem;\r\n    --rhino-radius-panel: 0.4rem;\r\n    --rhino-radius-media: 0.6rem;\r\n    --rhino-radius-overlay: 0.6rem;\r\n    --rhino-radius-round: 50%;\r\n\r\n    /* Control sizing */\r\n    --rhino-control-min-height: 4.4rem;\r\n    --rhino-control-comfortable-height: 4.8rem;\r\n    --rhino-icon-button-size: 4.4rem;\r\n\r\n    /* Focus */\r\n    --rhino-focus-width: 0.3rem;\r\n    --rhino-focus-offset: 0.2rem;\r\n    --rhino-focus-ring:\r\n        var(--rhino-focus-width)\r\n        solid\r\n        var(--rhino-color-focus);\r\n\r\n    /* Overlay elevation only */\r\n    --rhino-shadow-overlay:\r\n        0 1.6rem 4rem rgba(17, 17, 17, 0.18);\r\n    --rhino-shadow-drawer:\r\n        0 0 3.2rem rgba(17, 17, 17, 0.2);\r\n\r\n    /* Motion */\r\n    --rhino-motion-duration-instant: 80ms;\r\n    --rhino-motion-duration-fast: 160ms;\r\n    --rhino-motion-duration-standard: 240ms;\r\n    --rhino-motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);\r\n    --rhino-motion-easing-exit: cubic-bezier(0.4, 0, 1, 1);\r\n    --rhino-motion-distance: 0.8rem;\r\n}\r\n\r\n@media screen and (min-width: 750px) {\r\n    :root {\r\n        --rhino-page-gutter: var(--rhino-space-5);\r\n        --rhino-section-spacing-y: var(--rhino-space-8);\r\n        --rhino-section-spacing-dense-y: var(--rhino-space-6);\r\n        --rhino-section-spacing-major-y: var(--rhino-space-9);\r\n        --rhino-type-page-title-size: var(--rhino-font-size-5xl);\r\n        --rhino-type-product-title-size: var(--rhino-font-size-4xl);\r\n        --rhino-type-section-title-size: var(--rhino-font-size-3xl);\r\n        --rhino-type-subsection-title-size: 2.2rem;\r\n    }\r\n}\r\n\r\n@media screen and (min-width: 990px) {\r\n    :root {\r\n        --rhino-page-gutter: var(--rhino-space-6);\r\n    }\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Global foundation\r\n * -------------------------------------------------------------------------- */\r\nbody {\r\n    color: var(--rhino-color-text);\r\n    font-family: var(--rhino-font-family-sans);\r\n    font-size: var(--rhino-font-size-body);\r\n    font-variant-numeric: lining-nums;\r\n    line-height: var(--rhino-type-body-line-height);\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4,\r\nh5,\r\nh6,\r\n.button,\r\nbutton,\r\ninput,\r\nselect,\r\ntextarea {\r\n    font-family: var(--rhino-font-family-sans);\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4,\r\nh5,\r\nh6 {\r\n    color: inherit;\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    overflow-wrap: anywhere;\r\n    text-wrap: balance;\r\n}\r\n\r\np,\r\nli,\r\ndd {\r\n    overflow-wrap: break-word;\r\n    text-wrap: pretty;\r\n}\r\n\r\n:where(\r\n    a,\r\n    button,\r\n    input,\r\n    select,\r\n    textarea,\r\n    summary,\r\n    [tabindex]:not([tabindex=\"-1\"])\r\n):focus-visible {\r\n    outline: var(--rhino-focus-ring);\r\n    outline-offset: var(--rhino-focus-offset);\r\n}\r\n\r\n::selection {\r\n    background: var(--rhino-color-red-900);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Typography roles\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-page-title {\r\n    font-size: var(--rhino-type-page-title-size);\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    letter-spacing: -0.02em;\r\n    line-height: var(--rhino-type-page-title-line-height);\r\n    margin-block: 0;\r\n}\r\n\r\n.rhino-product-title {\r\n    font-size: var(--rhino-type-product-title-size);\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    letter-spacing: -0.015em;\r\n    line-height: var(--rhino-type-product-title-line-height);\r\n    margin-block: 0;\r\n    overflow-wrap: anywhere;\r\n}\r\n\r\n.rhino-section-title {\r\n    font-size: var(--rhino-type-section-title-size);\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    line-height: var(--rhino-type-section-title-line-height);\r\n    margin-block: 0;\r\n}\r\n\r\n.rhino-subsection-title {\r\n    font-size: var(--rhino-type-subsection-title-size);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: var(--rhino-type-subsection-title-line-height);\r\n    margin-block: 0;\r\n}\r\n\r\n.rhino-product-subtitle {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-lg);\r\n    font-weight: var(--rhino-font-weight-medium);\r\n    line-height: 1.555;\r\n    margin-block: 0;\r\n}\r\n\r\n.rhino-technical-label,\r\n.rhino-eyebrow {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    letter-spacing: var(--rhino-type-label-letter-spacing);\r\n    line-height: 1.5;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.rhino-spec-value {\r\n    color: var(--rhino-color-text);\r\n    font-size: var(--rhino-font-size-body);\r\n    font-variant-numeric: tabular-nums lining-nums;\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: 1.5;\r\n}\r\n\r\n.rhino-price {\r\n    color: var(--rhino-color-text);\r\n    font-size: 2.6rem;\r\n    font-variant-numeric: tabular-nums lining-nums;\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    line-height: 1.307;\r\n}\r\n\r\n.rhino-caption {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-sm);\r\n    line-height: 1.538;\r\n}\r\n\r\n.rhino-prose {\r\n    font-size: var(--rhino-font-size-body);\r\n    line-height: var(--rhino-type-body-line-height);\r\n    max-width: var(--rhino-width-prose);\r\n}\r\n\r\n.rhino-prose > *:first-child {\r\n    margin-block-start: 0;\r\n}\r\n\r\n.rhino-prose > *:last-child {\r\n    margin-block-end: 0;\r\n}\r\n\r\n.rhino-nowrap {\r\n    white-space: nowrap;\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Layout primitives\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-container,\r\n.rhino-container--wide,\r\n.rhino-container--prose,\r\n.rhino-container--form {\r\n    margin-inline: auto;\r\n    width: calc(100% - (var(--rhino-page-gutter) * 2));\r\n}\r\n\r\n.rhino-container {\r\n    max-width: var(--rhino-width-content);\r\n}\r\n\r\n.rhino-container--wide {\r\n    max-width: var(--rhino-width-canvas);\r\n}\r\n\r\n.rhino-container--prose {\r\n    max-width: var(--rhino-width-prose);\r\n}\r\n\r\n.rhino-container--form {\r\n    max-width: var(--rhino-width-form);\r\n}\r\n\r\n.rhino-section {\r\n    padding-block: var(--rhino-section-spacing-y);\r\n}\r\n\r\n.rhino-section--dense {\r\n    padding-block: var(--rhino-section-spacing-dense-y);\r\n}\r\n\r\n.rhino-section--major {\r\n    padding-block: var(--rhino-section-spacing-major-y);\r\n}\r\n\r\n.rhino-stack {\r\n    --rhino-stack-gap: var(--rhino-space-4);\r\n\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.rhino-stack > * {\r\n    margin-block: 0;\r\n}\r\n\r\n.rhino-stack > * + * {\r\n    margin-block-start: var(--rhino-stack-gap);\r\n}\r\n\r\n.rhino-stack--compact {\r\n    --rhino-stack-gap: var(--rhino-space-2);\r\n}\r\n\r\n.rhino-stack--technical {\r\n    --rhino-stack-gap: var(--rhino-space-3);\r\n}\r\n\r\n.rhino-stack--spacious {\r\n    --rhino-stack-gap: var(--rhino-space-6);\r\n}\r\n\r\n.rhino-cluster {\r\n    --rhino-cluster-gap: var(--rhino-space-3);\r\n\r\n    align-items: center;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--rhino-cluster-gap);\r\n}\r\n\r\n.rhino-grid {\r\n    --rhino-grid-min: 24rem;\r\n    --rhino-grid-gap: var(--rhino-space-5);\r\n\r\n    display: grid;\r\n    gap: var(--rhino-grid-gap);\r\n    grid-template-columns:\r\n        repeat(\r\n            auto-fit,\r\n            minmax(min(100%, var(--rhino-grid-min)), 1fr)\r\n        );\r\n}\r\n\r\n.rhino-divider {\r\n    border: 0;\r\n    border-block-start: var(--rhino-border-standard);\r\n    margin-block: var(--rhino-space-5);\r\n}\r\n\r\n/* ---------------------------------------------------------------------------\r\n * Surfaces and panels\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-panel {\r\n    background: var(--rhino-color-surface);\r\n    border: var(--rhino-border-standard);\r\n    border-radius: var(--rhino-radius-panel);\r\n    color: var(--rhino-color-text);\r\n    padding: var(--rhino-space-5);\r\n}\r\n\r\n.rhino-panel--alternate {\r\n    background: var(--rhino-color-surface-alternate);\r\n}\r\n\r\n.rhino-panel--editorial {\r\n    background: var(--rhino-color-surface-editorial);\r\n}\r\n\r\n.rhino-panel--strong {\r\n    border-color: var(--rhino-color-border-strong);\r\n}\r\n\r\n.rhino-panel--accent {\r\n    border-inline-start:\r\n        var(--rhino-border-width-accent)\r\n        solid\r\n        var(--rhino-color-red-700);\r\n}\r\n\r\n.rhino-panel--dark {\r\n    background: var(--rhino-color-surface-dark);\r\n    border-color: var(--rhino-color-graphite);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-media-frame {\r\n    background: var(--rhino-color-surface-alternate);\r\n    border: var(--rhino-border-standard);\r\n    border-radius: var(--rhino-radius-media);\r\n    overflow: hidden;\r\n}\r\n\r\n/* ---------------------------------------------------------------------------\r\n * Links\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-link {\r\n    color: var(--rhino-color-link);\r\n    font-weight: var(--rhino-font-weight-medium);\r\n    text-decoration-line: underline;\r\n    text-decoration-thickness: 0.1em;\r\n    text-underline-offset: 0.18em;\r\n}\r\n\r\n.rhino-link:hover {\r\n    color: var(--rhino-color-red-900);\r\n    text-decoration-thickness: 0.14em;\r\n}\r\n\r\n.rhino-link--muted {\r\n    color: var(--rhino-color-text-muted);\r\n}\r\n\r\n.rhino-link--muted:hover {\r\n    color: var(--rhino-color-text);\r\n}\r\n\r\n/* -------------------------------------------------------------------------\r\n * Buttons and action groups\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-button {\r\n    align-items: center;\r\n    appearance: none;\r\n    background: transparent;\r\n    border: var(--rhino-border-width) solid transparent;\r\n    border-radius: var(--rhino-radius-control);\r\n    box-shadow: none;\r\n    color: inherit;\r\n    cursor: pointer;\r\n    display: inline-flex;\r\n    font-size: var(--rhino-font-size-button);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    gap: var(--rhino-space-2);\r\n    justify-content: center;\r\n    line-height: 1.333;\r\n    min-height: var(--rhino-control-min-height);\r\n    padding: var(--rhino-space-3) var(--rhino-space-5);\r\n    text-align: center;\r\n    text-decoration: none;\r\n}\r\n\r\n.rhino-button--primary {\r\n    background: var(--rhino-color-action);\r\n    border-color: var(--rhino-color-action);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-button--primary:hover {\r\n    background: var(--rhino-color-action-hover);\r\n    border-color: var(--rhino-color-action-hover);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-button--secondary {\r\n    background: var(--rhino-color-white);\r\n    border-color: var(--rhino-color-border-strong);\r\n    color: var(--rhino-color-carbon);\r\n}\r\n\r\n.rhino-button--secondary:hover {\r\n    background: var(--rhino-color-mist);\r\n}\r\n\r\n.rhino-button--tertiary {\r\n    border-color: transparent;\r\n    color: var(--rhino-color-link);\r\n    padding-inline: var(--rhino-space-2);\r\n    text-decoration-line: underline;\r\n    text-decoration-thickness: 0.1em;\r\n    text-underline-offset: 0.18em;\r\n}\r\n\r\n.rhino-button--tertiary:hover {\r\n    color: var(--rhino-color-red-900);\r\n    text-decoration-thickness: 0.14em;\r\n}\r\n\r\n.rhino-button--support {\r\n    background: var(--rhino-color-info-surface);\r\n    border-color: var(--rhino-color-info);\r\n    color: var(--rhino-color-info);\r\n}\r\n\r\n.rhino-button--support:hover {\r\n    background: var(--rhino-color-info);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-button--danger {\r\n    background: var(--rhino-color-white);\r\n    border-color: var(--rhino-color-error);\r\n    color: var(--rhino-color-error);\r\n}\r\n\r\n.rhino-button--danger:hover {\r\n    background: var(--rhino-color-error);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-button--icon {\r\n    min-width: var(--rhino-icon-button-size);\r\n    padding: var(--rhino-space-2);\r\n    width: var(--rhino-icon-button-size);\r\n}\r\n\r\n.rhino-button:is(\r\n    :disabled,\r\n    [disabled],\r\n    [aria-disabled=\"true\"]\r\n) {\r\n    cursor: not-allowed;\r\n    opacity: 0.55;\r\n}\r\n\r\n.rhino-button[aria-busy=\"true\"],\r\n.rhino-button.is-loading {\r\n    cursor: progress;\r\n}\r\n\r\n.rhino-action-group {\r\n    align-items: center;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--rhino-space-3);\r\n}\r\n\r\n@media screen and (max-width: 749px) {\r\n    .rhino-action-group--stack-mobile {\r\n        align-items: stretch;\r\n        flex-direction: column;\r\n    }\r\n\r\n    .rhino-action-group--stack-mobile .rhino-button {\r\n        width: 100%;\r\n    }\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Forms\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-form {\r\n    max-width: var(--rhino-width-form);\r\n}\r\n\r\n.rhino-field {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: var(--rhino-space-2);\r\n}\r\n\r\n.rhino-field + .rhino-field {\r\n    margin-block-start: var(--rhino-space-5);\r\n}\r\n\r\n.rhino-field__label {\r\n    color: var(--rhino-color-text);\r\n    font-size: var(--rhino-font-size-compact);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n}\r\n\r\n.rhino-field__requirement {\r\n    color: var(--rhino-color-text-muted);\r\n    font-weight: var(--rhino-font-weight-regular);\r\n}\r\n\r\n.rhino-field__hint {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-sm);\r\n    line-height: 1.538;\r\n}\r\n\r\n.rhino-field__control {\r\n    background: var(--rhino-color-white);\r\n    border: var(--rhino-border-standard);\r\n    border-radius: var(--rhino-radius-control);\r\n    color: var(--rhino-color-text);\r\n    font: inherit;\r\n    min-height: var(--rhino-control-comfortable-height);\r\n    padding: var(--rhino-space-3) var(--rhino-space-4);\r\n    width: 100%;\r\n}\r\n\r\ntextarea.rhino-field__control {\r\n    min-height: 14rem;\r\n    resize: vertical;\r\n}\r\n\r\n.rhino-field__control:hover {\r\n    border-color: var(--rhino-color-steel);\r\n}\r\n\r\n.rhino-field__control:focus-visible {\r\n    border-color: var(--rhino-color-focus);\r\n    box-shadow:\r\n        0 0 0\r\n        var(--rhino-focus-width)\r\n        var(--rhino-color-focus-shadow);\r\n    outline: none;\r\n}\r\n\r\n.rhino-field__control[aria-invalid=\"true\"] {\r\n    border-color: var(--rhino-color-error);\r\n}\r\n\r\n.rhino-field__control:disabled {\r\n    background: var(--rhino-color-mist);\r\n    color: var(--rhino-color-text-muted);\r\n    cursor: not-allowed;\r\n}\r\n\r\n.rhino-field__message {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-sm);\r\n    line-height: 1.538;\r\n}\r\n\r\n.rhino-field__message--error {\r\n    color: var(--rhino-color-error);\r\n    font-weight: var(--rhino-font-weight-medium);\r\n}\r\n\r\n.rhino-field__message--success {\r\n    color: var(--rhino-color-success);\r\n    font-weight: var(--rhino-font-weight-medium);\r\n}\r\n\r\n.rhino-form-actions {\r\n    align-items: center;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--rhino-space-3);\r\n    margin-block-start: var(--rhino-space-6);\r\n}\r\n\r\n/* ---------------------------------------------------------------------------\r\n * Storefront states\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-state {\r\n    --rhino-state-accent: var(--rhino-color-info);\r\n    --rhino-state-background: var(--rhino-color-info-surface);\r\n\r\n    background: var(--rhino-state-background);\r\n    border: var(--rhino-border-standard);\r\n    border-inline-start:\r\n        var(--rhino-border-width-accent)\r\n        solid\r\n        var(--rhino-state-accent);\r\n    border-radius: var(--rhino-radius-panel);\r\n    color: var(--rhino-color-text);\r\n    padding: var(--rhino-space-4);\r\n}\r\n\r\n.rhino-state__title {\r\n    color: inherit;\r\n    font-size: var(--rhino-font-size-body);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: 1.5;\r\n    margin: 0;\r\n}\r\n\r\n.rhino-state__message {\r\n    margin-block:\r\n        var(--rhino-space-2)\r\n        0;\r\n}\r\n\r\n.rhino-state--success {\r\n    --rhino-state-accent: var(--rhino-color-success);\r\n    --rhino-state-background: var(--rhino-color-success-surface);\r\n}\r\n\r\n.rhino-state--warning {\r\n    --rhino-state-accent: var(--rhino-color-warning);\r\n    --rhino-state-background: var(--rhino-color-warning-surface);\r\n}\r\n\r\n.rhino-state--error {\r\n    --rhino-state-accent: var(--rhino-color-error);\r\n    --rhino-state-background: var(--rhino-color-error-surface);\r\n}\r\n\r\n.rhino-state--neutral,\r\n.rhino-empty-state {\r\n    --rhino-state-accent: var(--rhino-color-steel);\r\n    --rhino-state-background: var(--rhino-color-mist);\r\n}\r\n\r\n.rhino-empty-state {\r\n    background: var(--rhino-color-mist);\r\n    border: var(--rhino-border-standard);\r\n    border-radius: var(--rhino-radius-panel);\r\n    padding: var(--rhino-space-7) var(--rhino-space-5);\r\n    text-align: center;\r\n}\r\n\r\n.rhino-empty-state > * {\r\n    margin-inline: auto;\r\n    max-width: var(--rhino-width-form);\r\n}\r\n\r\n/* ---------------------------------------------------------------------------\r\n * Specification tables\r\n * ------------------------------------------------------------------------- */\r\n\r\n.rhino-spec-table-wrapper {\r\n    max-width: 100%;\r\n    overflow-x: auto;\r\n}\r\n\r\n.rhino-spec-table {\r\n    border-collapse: collapse;\r\n    color: var(--rhino-color-text);\r\n    font-variant-numeric: tabular-nums lining-nums;\r\n    width: 100%;\r\n}\r\n\r\n.rhino-spec-table th,\r\n.rhino-spec-table td {\r\n    border-block-end: var(--rhino-border-standard);\r\n    padding:\r\n        var(--rhino-space-3)\r\n        var(--rhino-space-4);\r\n    text-align: start;\r\n    vertical-align: top;\r\n}\r\n\r\n.rhino-spec-tabl th {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    letter-spacing: var(--rhino-type-label-letter-spacing);\r\n    text-transform: uppercase;\r\n}\r\n\r\n.rhino-spec-table tbody th {\r\n    color: var(--rhino-color-text);\r\n    font-size: var(--rhino-font-size-compact);\r\n    letter-spacing: 0;\r\n    text-transform: none;\r\n}\r\n\r\n.rhino-spec-table tbody tr:hover {\r\n    background: var(--rhino-color-mist);\r\n}\r\n\r\n/* ---------------------------------------------------------------------------\r\n * Accessibility preferences\r\n * ------------------------------------------------------------------------- */\r\n\r\n@media (forced-colors: active) {\r\n    .rhino-button,\r\n    .rhino-field__control,\r\n    .rhino-panel,\r\n    .rhino-panel,\r\n    .rhino-empty-state {\r\n        forced-color-adjust: auto;\r\n    }\r\n\r\n    :where(\r\n        a,\r\n        button,\r\n        input,\r\n        select,\r\n        textarea,\r\n        summary,\r\n        [tabindex]:not([tabindex=\"-1\"])\r\n    ):focus-visible {\r\n        outline-color: Highlight;\r\n    }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n    .rhino-button,\r\n    .rhino-link,\r\n    .rhino-field__control {\r\n        scroll-behavior: auto;\r\n        transition-duration: 0.01ms;\r\n    }\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Product badges and trust markers\r\n * Source PBIs: B-010, B-012, B-023\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-badge-list {\r\n    align-items: center;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--rhino-space-2);\r\n    list-style: none;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n.rhino-badge {\r\n    align-items: center;\r\n    background: var(--rhino-color-white);\r\n    border: var(--rhino-border-standard);\r\n    border-radius: var(--rhino-radius-control);\r\n    color: var(--rhino-color-graphite);\r\n    display: inline-flex;\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    gap: var(--rhino-space-1);\r\n    letter-spacing: 0.02em;\r\n    line-height: 1.333;\r\n    min-height: 2.8rem;\r\n    padding: var(--rhino-space-1) var(--rhino-space-2);\r\n    text-transform: none;\r\n}\r\n\r\n.rhino-badge .rhino-icon {\r\n    flex: 0 0 auto;\r\n    height: 1.6rem;\r\n    width: 1.6rem;\r\n}\r\n\r\n.rhino-badge--product-class {\r\n    background: var(--rhino-color-mist);\r\n    color: var(--rhino-color-carbon);\r\n}\r\n\r\n.rhino-badge--availability {\r\n    border-color: var(--rhino-color-error);\r\n    color: var(--rhino-color-error);\r\n}\r\n\r\n.rhino-badge--warning {\r\n    background: var(--rhino-color-warning-surface);\r\n    border-color: var(--rhino-color-warning);\r\n    color: var(--rhino-color-warning);\r\n}\r\n\r\n.rhino-badge--freight {\r\n    background: var(--rhino-color-info-surface);\r\n    border-color: var(--rhino-color-info);\r\n    color: var(--rhino-color-info);\r\n}\r\n\r\n.rhino-badge--compatibility {\r\n    background: var(--rhino-color-success-surface);\r\n    border-color: var(--rhino-color-success);\r\n    color: var(--rhino-color-success);\r\n}\r\n\r\n.rhino-badge--sale {\r\n    background: var(--rhino-color-red-900);\r\n    border-color: var(--rhino-color-red-900);\r\n    color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-badge--new {\r\n    background: var(--rhino-color-white);\r\n    border-color: var(--rhino-color-red-700);\r\n    color: var(--rhino-color-red-700);\r\n}\r\n\r\n.rhino-trust-list {\r\n    border-block:\r\n            var(--rhino-border-standard);\r\n    display: grid;\r\n    margin: 0;\r\n}\r\n\r\n.rhino-trust-marker {\r\n    align-items: start;\r\n    display: grid;\r\n    gap: var(--rhino-space-3);\r\n    grid-template-columns: auto minmax(0, 1fr);\r\n    padding-block: var(--rhino-space-4);\r\n}\r\n\r\n.rhino-trust-marker + .rhino-trust-marker {\r\n    border-block-start: var(--rhino-border-standard);\r\n}\r\n\r\n.rhino-trust-marker__icon {\r\n    align-items: center;\r\n    color: var(--rhino-color-info);\r\n    display: inline-flex;\r\n    height: 2.4rem;\r\n    justify-content: center;\r\n    width: 2.4rem;\r\n}\r\n\r\n.rhino-trust-marker__content {\r\n    min-width: 0;\r\n}\r\n\r\n.rhino-trust-marker__title {\r\n    color: var(--rhino-color-text);\r\n    font-size: var(--rhino-font-size-compact);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n    margin: 0;\r\n}\r\n\r\n.rhino-trust-marker__text {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-compact);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n    margin:\r\n            var(--rhino-space-1)\r\n            0\r\n            0;\r\n}\r\n\r\n.rhino-trust-marker__action {\r\n    display: inline-block;\r\n    margin-block-start: var(--rhino-space-2);\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Machine family identifiers\r\n * Source PBI: B-012\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-family-identifier {\r\n    --rhino-family-accent: var(--rhino-color-red-700);\r\n\r\n    align-items: center;\r\n    background: var(--rhino-color-white);\r\n    border: var(--rhino-border-standard);\r\n    border-inline-start:\r\n            var(--rhino-border-width-accent)\r\n            solid\r\n            var(--rhino-family-accent);\r\n    border-radius: var(--rhino-radius-control);\r\n    color: var(--rhino-color-carbon);\r\n    display: inline-flex;\r\n    gap: var(--rhino-space-2);\r\n    max-width: 100%;\r\n    min-height: 3.6rem;\r\n    padding:\r\n            var(--rhino-space-1)\r\n            var(--rhino-space-3);\r\n}\r\n\r\n.rhino-family-identifier__icon,\r\n.rhino-family-identifier__code {\r\n    align-items: center;\r\n    color: var(--rhino-family-accent);\r\n    display: inline-flex;\r\n    flex: 0 0 auto;\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    justify-content: center;\r\n    letter-spacing: 0.04em;\r\n    min-width: 2.8rem;\r\n}\r\n\r\n.rhino-family-identifier__icon {\r\n    height: 2.4rem;\r\n    width: 2.4rem;\r\n}\r\n\r\n.rhino-family-identifier__name {\r\n    font-size: var(--rhino-font-size-compact);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n    min-width: 0;\r\n    overflow-wrap: anywhere;\r\n}\r\n\r\n.rhino-family-identifier--compact {\r\n    min-height: 3.2rem;\r\n    padding:\r\n            var(--rhino-space-1)\r\n            var(--rhino-space-2);\r\n}\r\n\r\n.rhino-family-identifier--compact .rhino-family-identifier__name {\r\n    font-size: var(--rhino-font-size-sm);\r\n}\r\n\r\n.rhino-family-identifier--muted {\r\n    --rhino-family-accent: var(--rhino-color-steel);\r\n\r\n    background: var(--rhino-color-mist);\r\n}\r\n\r\n.rhino-family-identifier[data-family=\"jademaster\"] {\r\n    --rhino-family-accent: var(--rhino-color-steel);\r\n}\r\n\r\n/*\r\n * TumbleMaster is intentionally not assigned a customer-facing selector while\r\n * its commercial and technical status remains unavailable.\r\n */\r\n\r\n/* --------------------------------------------------------------------------\r\n * Rhino icon sizing foundation\r\n * Source PBI: B-011\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-icon-wrapper {\r\n    align-items: center;\r\n    color: currentColor;\r\n    display: inline-flex;\r\n    flex: 0 0 auto;\r\n    justify-content: center;\r\n    line-height: 0;\r\n    vertical-align: middle;\r\n}\r\n\r\n.rhino-icon {\r\n    color: currentColor;\r\n    display: inline-block;\r\n    fill: none;\r\n    flex: 0 0 auto;\r\n    height: 2.4rem;\r\n    stroke: currentColor;\r\n    stroke-linecap: round;\r\n    stroke-linejoin: round;\r\n    stroke-width: 1.75;\r\n    vertical-align: middle;\r\n    width: 2.4rem;\r\n}\r\n\r\n.rhino-icon-wrapper--default .rhino-icon {\r\n    height: 2.4rem;\r\n    width: 2.4rem;\r\n}\r\n\r\n.rhino-icon-wrapper--compact .rhino-icon,\r\n.rhino-icon--compact {\r\n    height: 1.6rem;\r\n    width: 1.6rem;\r\n}\r\n\r\n.rhino-icon-wrapper--small .rhino-icon,\r\n.rhino-icon--small {\r\n    height: 2rem;\r\n    width: 2rem;\r\n}\r\n\r\n.rhino-icon-wrapper--large .rhino-icon,\r\n.rhino-icon--large {\r\n    height: 3.2rem;\r\n    width: 3.2rem;\r\n}\r\n\r\n.rhino-icon--filled {\r\n    fill: currentColor;\r\n    stroke: none;\r\n}\r\n\r\n@media screen and (max-width: 749px) {\r\n    .rhino-trust-marker {\r\n        gap: var(--rhino-space-2);\r\n    }\r\n\r\n    .rhino-family-identifier {\r\n        max-width: 100%;\r\n    }\r\n}\r\n\r\n@media (forced-colors: active) {\r\n    .rhino-badge,\r\n    .rhino-family-identifier,\r\n    .rhino-trust-list {\r\n        forced-color-adjust: auto;\r\n    }\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Motion and loading\r\n * Source PBI: B-020\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-transition {\r\n    transition-duration: var(--rhino-motion-duration-fast);\r\n    transition-property:\r\n            background-color,\r\n            border-color,\r\n            color,\r\n            opacity,\r\n            transform;\r\n    transition-timing-function: var(--rhino-motion-easing-standard);\r\n}\r\n\r\n.rhino-transition--overlay {\r\n    transition-duration: var(--rhino-motion-duration-standard);\r\n}\r\n\r\n.rhino-fade-enter {\r\n    opacity: 0;\r\n}\r\n\r\n.rhino-fade-enter.is-visible {\r\n    opacity: 1;\r\n}\r\n\r\n.rhino-busy-region {\r\n    min-height: 1px;\r\n    position: relative;\r\n}\r\n\r\n.rhino-busy-region[aria-busy=\"true\"] {\r\n    cursor: progress;\r\n}\r\n\r\n.rhino-loading {\r\n    align-items: center;\r\n    color: var(--rhino-color-text-muted);\r\n    display: inline-flex;\r\n    font-size: var(--rhino-font-size-compact);\r\n    gap: var(--rhino-space-2);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n}\r\n\r\n.rhino-spinner {\r\n    animation: rhino-spinner-rotate 800ms linear infinite;\r\n    border:\r\n            0.2rem\r\n            solid\r\n            var(--rhino-color-alloy);\r\n    border-block-start-color: var(--rhino-color-red-700);\r\n    border-radius: var(--rhino-radius-round);\r\n    display: inline-block;\r\n    height: 2rem;\r\n    width: 2rem;\r\n}\r\n\r\n.rhino-spinner--small {\r\n    border-width: 0.15rem;\r\n    height: 1.6rem;\r\n    width: 1.6rem;\r\n}\r\n\r\n.rhino-skeleton {\r\n    background: var(--rhino-color-mist);\r\n    border-radius: var(--rhino-radius-control);\r\n    display: block;\r\n    min-height: 1.6rem;\r\n}\r\n\r\n.rhino-skeleton--text {\r\n    max-width: 32rem;\r\n    width: 100%;\r\n}\r\n\r\n.rhino-skeleton--short {\r\n    max-width: 16rem;\r\n}\r\n\r\n.rhino-skeleton--media {\r\n    aspect-ratio: 4 / 3;\r\n    min-height: 0;\r\n    width: 100%;\r\n}\r\n\r\n@keyframes rhino-spinner-rotate {\r\n    to {\r\n        transform: rotate(360deg);\r\n    }\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Technical diagrams\r\n * Source PBI: B-013\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-diagram {\r\n    background: var(--rhino-color-white);\r\n    border: var(--rhino-border-standard);\r\n    border-radius: var(--rhino-radius-media);\r\n    color: var(--rhino-color-text);\r\n    margin: 0;\r\n    overflow: hidden;\r\n}\r\n\r\n.rhino-diagram__canvas {\r\n    background: var(--rhino-color-mist);\r\n    overflow-x: auto;\r\n    padding: var(--rhino-space-4);\r\n}\r\n\r\n.rhino-diagram__canvas svg {\r\n    display: block;\r\n    height: auto;\r\n    margin-inline: auto;\r\n    max-width: 100%;\r\n}\r\n\r\n.rhino-diagram__caption {\r\n    border-block-start: var(--rhino-border-standard);\r\n    padding: var(--rhino-space-4);\r\n}\r\n\r\n.rhino-diagram__caption > *:first-child {\r\n    margin-block-start: 0;\r\n}\r\n\r\n.rhino-diagram__caption > *:last-child {\r\n    margin-block-end: 0;\r\n}\r\n\r\n.rhino-diagram__title {\r\n    font-size: var(--rhino-font-size-body);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: 1.5;\r\n    margin: 0;\r\n}\r\n\r\n.rhino-diagram__description {\r\n    color: var(--rhino-color-text-muted);\r\n    font-size: var(--rhino-font-size-compact);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n    margin:\r\n            var(--rhino-space-2)\r\n            0\r\n            0;\r\n}\r\n\r\n.rhino-diagram__legend {\r\n    display: grid;\r\n    gap: var(--rhino-space-2);\r\n    list-style: none;\r\n    margin:\r\n            var(--rhino-space-4)\r\n            0\r\n            0;\r\n    padding: 0;\r\n}\r\n\r\n.rhino-diagram__legend-item {\r\n    align-items: start;\r\n    display: grid;\r\n    font-size: var(--rhino-font-size-compact);\r\n    gap: var(--rhino-space-2);\r\n    grid-template-columns: 2.8rem minmax(0, 1fr);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n}\r\n\r\n.rhino-diagram__callout-number {\r\n    align-items: center;\r\n    background: var(--rhino-color-red-700);\r\n    border-radius: var(--rhino-radius-round);\r\n    color: var(--rhino-color-white);\r\n    display: inline-flex;\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-variant-numeric: tabular-nums;\r\n    font-weight: var(--rhino-font-weight-bold);\r\n    height: 2.4rem;\r\n    justify-content: center;\r\n    width: 2.4rem;\r\n}\r\n\r\n.rhino-diagram-line {\r\n    fill: none;\r\n    stroke: var(--rhino-color-graphite);\r\n    stroke-linecap: round;\r\n    stroke-linejoin: round;\r\n    stroke-width: 2;\r\n}\r\n\r\n.rhino-diagram-line--secondary {\r\n    stroke: var(--rhino-color-steel);\r\n    stroke-width: 1.5;\r\n}\r\n\r\n.rhino-diagram-line--callout {\r\n    stroke: var(--rhino-color-red-700);\r\n}\r\n\r\n.rhino-diagram-line--water {\r\n    stroke: var(--rhino-color-info);\r\n    stroke-dasharray: 6 4;\r\n}\r\n\r\n.rhino-diagram-line--dimension {\r\n    stroke: var(--rhino-color-graphite);\r\n    stroke-width: 1.25;\r\n}\r\n\r\n.rhino-diagram-line--warning {\r\n    stroke: var(--rhino-color-warning);\r\n}\r\n\r\n.rhino-diagram-label {\r\n    fill: var(--rhino-color-carbon);\r\n    font-family: var(--rhino-font-family-sans);\r\n    font-size: 14px;\r\n    font-weight: var(--rhino-font-weight-medium);\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Restrained geological motif\r\n * Source PBI: B-014\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-strata-rule {\r\n    display: grid;\r\n    gap: var(--rhino-space-1);\r\n    margin-block: var(--rhino-space-6);\r\n    max-width: 18rem;\r\n}\r\n\r\n.rhino-strata-rule::before,\r\n.rhino-strata-rule::after {\r\n    content: \"\";\r\n    display: block;\r\n    height: 0.2rem;\r\n}\r\n\r\n.rhino-strata-rule::before {\r\n    background: var(--rhino-color-red-700);\r\n    width: 100%;\r\n}\r\n\r\n.rhino-strata-rule::after {\r\n    background: var(--rhino-color-alloy);\r\n    box-shadow:\r\n            0 var(--rhino-space-1)\r\n            0\r\n            var(--rhino-color-steel);\r\n    width: 72%;\r\n}\r\n\r\n.rhino-strata-rule--center {\r\n    margin-inline: auto;\r\n}\r\n\r\n.rhino-strata-rule--right {\r\n    margin-inline-start: auto;\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Video thumbnails and click-to-load presentation\r\n * Source PBI: B-019\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-video-card {\r\n    background: var(--rhino-color-carbon);\r\n    border: var(--rhino-border-standard);\r\n    border-color: var(--rhino-color-graphite);\r\n    border-radius: var(--rhino-radius-media);\r\n    color: var(--rhino-color-white);\r\n    margin: 0;\r\n    overflow: hidden;\r\n}\r\n\r\n.rhino-video-card__media {\r\n    aspect-ratio: 16 / 9;\r\n    background: var(--rhino-color-graphite);\r\n    position: relative;\r\n}\r\n\r\n.rhino-video-card__poster {\r\n    display: block;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    width: 100%;\r\n}\r\n\r\n.rhino-video-card__button {\r\n    align-items: center;\r\n    background: var(--rhino-color-action);\r\n    border:\r\n            var(--rhino-border-width)\r\n            solid\r\n            var(--rhino-color-action);\r\n    border-radius: var(--rhino-radius-round);\r\n    color: var(--rhino-color-white);\r\n    cursor: pointer;\r\n    display: inline-flex;\r\n    height: 5.6rem;\r\n    justify-content: center;\r\n    left: 50%;\r\n    min-height: 4.8rem;\r\n    min-width: 4.8rem;\r\n    position: absolute;\r\n    top: 50%;\r\n    transform: translate(-50%, -50%);\r\n    width: 5.6rem;\r\n}\r\n\r\n.rhino-video-card__button:hover {\r\n    background: var(--rhino-color-action-hover);\r\n    border-color: var(--rhino-color-action-hover);\r\n}\r\n\r\n.rhino-video-card__button:focus-visible {\r\n    outline-color: var(--rhino-color-white);\r\n}\r\n\r\n.rhino-video-card__button .rhino-icon,\r\n.rhino-video-card__button .rhino-icon-wrapper {\r\n    height: 2.4rem;\r\n    width: 2.4rem;\r\n}\r\n\r\n.rhino-video-card__duration {\r\n    background: var(--rhino-color-overlay-dark);\r\n    border-radius: var(--rhino-radius-control);\r\n    bottom: var(--rhino-space-3);\r\n    color: var(--rhino-color-white);\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-variant-numeric: tabular-nums;\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: 1.333;\r\n    padding:\r\n            var(--rhino-space-1)\r\n            var(--rhino-space-2);\r\n    position: absolute;\r\n    right: var(--rhino-space-3);\r\n}\r\n\r\n.rhino-video-card__content {\r\n    padding: var(--rhino-space-4);\r\n}\r\n\r\n.rhino-video-card__category {\r\n    color: var(--rhino-color-alloy);\r\n    font-size: var(--rhino-font-size-xs);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    letter-spacing: var(--rhino-type-label-letter-spacing);\r\n    line-height: 1.5;\r\n    margin: 0;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.rhino-video-card__title {\r\n    color: var(--rhino-color-white);\r\n    font-size: var(--rhino-font-size-lg);\r\n    font-weight: var(--rhino-font-weight-semibold);\r\n    line-height: 1.555;\r\n    margin:\r\n            var(--rhino-space-2)\r\n            0\r\n            0;\r\n}\r\n\r\n.rhino-video-card__description {\r\n    color: var(--rhino-color-alloy);\r\n    font-size: var(--rhino-font-size-compact);\r\n    line-height: var(--rhino-type-compact-line-height);\r\n    margin:\r\n            var(--rhino-space-2)\r\n            0\r\n            0;\r\n}\r\n\r\n.rhino-video-card__privacy {\r\n    color: var(--rhino-color-alloy);\r\n    font-size: var(--rhino-font-size-sm);\r\n    line-height: 1.538;\r\n    margin:\r\n            var(--rhino-space-3)\r\n            0\r\n            0;\r\n}\r\n\r\n.rhino-video-card__player {\r\n    aspect-ratio: 16 / 9;\r\n    background: var(--rhino-color-black);\r\n    width: 100%;\r\n}\r\n\r\n.rhino-video-card__player iframe,\r\n.rhino-video-card__player video {\r\n    border: 0;\r\n    display: block;\r\n    height: 100%;\r\n    width: 100%;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n    .rhino-transition,\r\n    .rhino-transition--overlay,\r\n    .rhino-fade-enter,\r\n    .rhino-fade-enter.is-visible,\r\n    .rhino-video-card__button {\r\n        transition: none;\r\n    }\r\n\r\n    .rhino-spinner {\r\n        animation: none;\r\n        border-color: var(--rhino-color-steel);\r\n        border-block-start-color: var(--rhino-color-red-700);\r\n    }\r\n\r\n    html:focus-within {\r\n        scroll-behavior: auto;\r\n    }\r\n}\r\n\r\n@media (forced-colors: active) {\r\n    .rhino-spinner,\r\n    .rhino-diagram,\r\n    .rhino-video-card,\r\n    .rhino-video-card__button {\r\n        forced-color-adjust: auto;\r\n    }\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Header and drawer focused repairs\r\n * Source PBIs: C-PBI-009\r\n * -------------------------------------------------------------------------- */\r\n\r\n.menu-drawer__account {\r\n    min-height: var(--rhino-control-min-height);\r\n}\r\n\r\n#ProductCount,\r\n#ProductCountDesktop {\r\n    color: var(--rhino-color-text);\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Policy rich text contrast\r\n * Source PBIs: C-PBI-018, C-PBI-022\r\n * -------------------------------------------------------------------------- */\r\n\r\n.shopify-policy__body {\r\n    color: var(--rhino-color-text);\r\n}\r\n\r\n.shopify-policy__body :where(span, strong, em, u) {\r\n    color: inherit;\r\n}\r\n\r\n.shopify-policy__body a {\r\n    color: var(--rhino-color-link);\r\n}\r\n\r\n.shopify-policy__body a :where(span, strong, em, u) {\r\n    color: inherit;\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n * Breadcrumbs\r\n * Source PBIs: C-PBI-013\r\n * -------------------------------------------------------------------------- */\r\n\r\n.rhino-breadcrumb {\r\n    margin: 1.2rem auto 0;\r\n    color: var(--rhino-color-text);\r\n    font-size: 1.3rem;\r\n    line-height: 1.45;\r\n}\r\n\r\n.rhino-breadcrumb__list {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 0.35rem 0.6rem;\r\n    align-items: center;\r\n    padding: 0;\r\n    margin: 0;\r\n    list-style: none;\r\n}\r\n\r\n.rhino-breadcrumb__item {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    min-width: 0;\r\n    max-width: 100%;\r\n    overflow-wrap: anywhere;\r\n}\r\n\r\n.rhino-breadcrumb__link {\r\n    color: var(--rhino-color-link);\r\n    scroll-margin-top: calc(var(--header-height, 0px) + 1.6rem);\r\n    text-decoration: underline;\r\n    text-underline-offset: 0.2rem;\r\n}\r\n\r\n.rhino-breadcrumb__link:focus-visible {\r\n    outline: var(--rhino-focus-ring);\r\n    outline-offset: var(--rhino-focus-offset);\r\n}\r\n\r\n.rhino-breadcrumb__separator {\r\n    flex: 0 0 auto;\r\n    margin-left: 0.6rem;\r\n    color: var(--rhino-color-text-muted);\r\n}\r\n\r\n.rhino-breadcrumb__item--current {\r\n    color: var(--rhino-color-text);\r\n}\r\n\r\n@media screen and (min-width: 750px) {\r\n    .rhino-breadcrumb {\r\n        margin-top: 1.6rem;\r\n        font-size: 1.4rem;\r\n    }\r\n}\r\n/* Conditional machine facts: semantic source order, no fixed-width values. */\n.rhino-machine-facts { margin-block: 3rem; min-width: 0; }\n.rhino-machine-facts :is(h2, h3, dt, dd, p, a, span) { overflow-wrap: anywhere; }\n.rhino-machine-facts dl { margin: 0; }\n.rhino-machine-fact-row { padding-block: 1rem; border-bottom: 1px solid rgba(var(--color-foreground), .2); }\n.rhino-machine-fact-row dt { font-weight: 600; }\n.rhino-machine-fact-row dd { margin: .5rem 0 0; }\n.rhino-machine-fact-context { display: block; margin-top: .5rem; }\n.rhino-machine-contents-list { list-style: none; padding: 0; display: grid; gap: 2rem; }\n.rhino-machine-component, .rhino-machine-component .card-wrapper { min-width: 0; }\n@media screen and (min-width: 750px) {\n  .rhino-machine-fact-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; }\n  .rhino-machine-fact-row dd { margin: 0; }\n  .rhino-machine-contents-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n/* F6 conditional resources reuse Trade DeferredMedia; no additional controller. */\n.rhino-machine-resource-list {\n  padding-inline-start: 2rem;\n}\n.rhino-machine-resource-list > li {\n  margin-block: 1.6rem;\n  overflow-wrap: anywhere;\n}\n.rhino-machine-resource-list > li > span {\n  display: block;\n}\n.rhino-machine-resource-video {\n  display: block;\n  position: relative;\n  width: 100%;\n  margin-block-start: 0.8rem;\n}\n.rhino-machine-resource-video > button {\n  width: 100%;\n  min-height: 100%;\n  height: auto;\n  padding: 1.6rem;\n  white-space: normal;\n  overflow-wrap: anywhere;\n}\n.rhino-machine-resource-video[loaded] > button {\n  display: none;\n}\n.rhino-machine-resource-video > iframe {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  border: 0;\n}\n"
    },
    {
      "path": "layout/theme.liquid",
      "sha256": "87086adef642d447d2cba82186641e93460d815549375bf608da035534cec5af",
      "body": "{%- capture rhino_consumer_route -%}{%- render 'rhino-product-consumer-route', product: product -%}{%- endcapture -%}\r\n{%- assign rhino_legacy_content = false -%}\r\n{%- if rhino_consumer_route == 'replacement_part' or rhino_consumer_route == 'consumable' or rhino_consumer_route == 'accessory' -%}{%- assign rhino_legacy_content = true -%}{%- endif -%}\r\n<!doctype html>\r\n<html class=\"js\" lang=\"{{ request.locale.iso_code }}\">\r\n  <head>\r\n    <meta charset=\"utf-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\r\n    {% render 'rhino-browser-assets' %}\r\n    {%- liquid\r\n      assign rhino_canonical_url = canonical_url | default: request.origin\r\n      assign rhino_canonical_url = rhino_canonical_url | split: '?' | first\r\n      if request.page_type == 'password'\r\n        assign rhino_canonical_url = request.origin\r\n      endif\r\n    -%}\r\n    <link rel=\"canonical\" href=\"{{ rhino_canonical_url }}\">\r\n\r\n    {%- if settings.favicon != blank -%}\r\n      <link rel=\"icon\" type=\"image/png\" href=\"{{ settings.favicon | image_url: width: 32, height: 32 }}\">\r\n    {%- endif -%}\r\n\r\n    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}\r\n      <link rel=\"preconnect\" href=\"https://fonts.shopifycdn.com\" crossorigin>\r\n    {%- endunless -%}\r\n\r\n    <title>\r\n      {% if request.page_type == 'product' and rhino_legacy_content == false %}{{ product.title | escape }}{% else %}{{ page_title }}{% endif %}\r\n      {%- if current_tags %} &ndash; tagged \"{{ current_tags | join: ', ' }}\"{% endif -%}\r\n      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}\r\n      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}\r\n    </title>\r\n\r\n    {% if page_description %}\r\n      {% unless request.page_type == 'product' and rhino_legacy_content == false %}\r\n      <meta name=\"description\" content=\"{{ page_description | escape }}\">\r\n      {% endunless %}\r\n    {% endif %}\r\n\r\n    {% render 'meta-tags' %}\r\n\r\n    <script type=\"module\">\r\n      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';\r\n\r\n      window.StandardEvents = StandardEvents;\r\n\r\n      customElements.define('collection-component', StandardEvents.createViewEventElement());\r\n      customElements.define(\r\n        'product-component',\r\n        StandardEvents.createViewEventElement(HTMLElement, { defaultTrigger: 'intersect' }),\r\n      );\r\n\r\n      document.addEventListener('DOMContentLoaded', () => {\r\n        const template = document.querySelector('main[data-template]')?.dataset.template || '';\r\n        document.dispatchEvent(\r\n          new StandardEvents.PageViewEvent({\r\n            page: { template, title: document.title, url: window.location.href },\r\n          })\r\n        );\r\n      }, { once: true });\r\n    </script>\r\n\r\n    <script src=\"{{ 'constants.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'pubsub.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'global.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'cart-disclosure-modal.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'cart-disclosure-tooltip.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'details-disclosure.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'details-modal.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'search-form.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'standard-actions-override.js' | asset_url }}\" defer=\"defer\"></script>\r\n    <script src=\"{{ 'rhino-storefront.js' | asset_url }}\" defer=\"defer\"></script>\r\n\r\n    {%- if settings.animations_reveal_on_scroll -%}\r\n      <script src=\"{{ 'animations.js' | asset_url }}\" defer=\"defer\"></script>\r\n    {%- endif -%}\r\n\r\n    {{ content_for_header }}\r\n\r\n    {%- liquid\r\n      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'\r\n      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'\r\n      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'\r\n    %}\r\n\r\n    {% style %}\r\n      {{ settings.type_body_font | font_face: font_display: 'swap' }}\r\n      {{ body_font_bold | font_face: font_display: 'swap' }}\r\n      {{ body_font_italic | font_face: font_display: 'swap' }}\r\n      {{ body_font_bold_italic | font_face: font_display: 'swap' }}\r\n      {{ settings.type_header_font | font_face: font_display: 'swap' }}\r\n\r\n      {% assign scheme_classes = '' %}\r\n      \r\n      {% for scheme in settings.color_schemes -%}\r\n        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}\r\n        {% if forloop.index == 1 -%}\r\n          :root,\r\n        {%- endif %}\r\n        .color-{{ scheme.id }} {\r\n          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};\r\n        {% if scheme.settings.background_gradient != empty %}\r\n          --gradient-background: {{ scheme.settings.background_gradient }};\r\n        {% else %}\r\n          --gradient-background: {{ scheme.settings.background }};\r\n        {% endif %}\r\n\r\n        {% liquid\r\n          assign background_color = scheme.settings.background\r\n          assign background_color_brightness = background_color | color_brightness\r\n          if background_color_brightness <= 26\r\n            assign background_color_contrast = background_color | color_lighten: 50\r\n          elsif background_color_brightness <= 65\r\n            assign background_color_contrast = background_color | color_lighten: 5\r\n          else\r\n            assign background_color_contrast = background_color | color_darken: 25\r\n          endif\r\n        %}\r\n\r\n        --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};\r\n        --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};\r\n        --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};\r\n        --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};\r\n        --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};\r\n        --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};\r\n        --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};\r\n        --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};\r\n        --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};\r\n        --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};\r\n        --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};\r\n        --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});\r\n      }\r\n      {% endfor %}\r\n\r\n      {{ scheme_classes | prepend: 'body' }} {\r\n        color: rgba(var(--color-foreground), 0.75);\r\n      