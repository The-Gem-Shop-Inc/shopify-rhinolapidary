      "body": "'use strict';\nconst fs=require('node:fs'),assert=require('node:assert/strict'),cp=require('node:child_process'),E=require('./lib/epic-e-owner-response-adapter'),N=require('./lib/epic-e-bom-owner-followup'),B=require('./lib/epic-f-bom-owner-binding');\nconst {CLI,cleanEnv}=require('./deploy-epic-f-header-focus-correction'),{sanitize}=require('./smoke-epic-f-live-machine-activation');\nconst targets={preview:{id:'158631198917',role:'UNPUBLISHED',name:'Rhino Lapidary - Preview'},main:{id:'158579622085',role:'MAIN',name:'shopify-rhinolapidary/main'}};\nconst write=(name,v)=>fs.writeFileSync(N.DIR+'/'+name+'.json',JSON.stringify(v,null,2)+'\\n'),inventory=t=>{assert(!t.files.pageInfo.hasNextPage);return Object.fromEntries(t.files.nodes.map(r=>[r.filename,r.checksumMd5]));};\nfunction before(name){const b=B.verify(),t=targets[name],r=E.read(N.DIR+'/themes-'+name+'-before-push.json');assert(Date.now()-Date.parse(r.completedAt)<300000);assert.equal(r.response.data[name].role,t.role);assert.equal(r.response.data[name].name,t.name);assert.deepEqual(inventory(r.response.data[name]),inventory(E.read(N.DIR+'/themes-before.json').response.data[name]));assert.equal(E.read(N.DIR+'/local-validation.json').exitCode,0);assert.equal(E.read(N.DIR+'/local-validation.json').sourceBindingSha256,b.bindingSha256);assert.equal(E.read(N.DIR+'/compiler-tests.json').failed,0);if(name==='main'){const p=E.read(N.DIR+'/preview-browser.json');assert.equal(p.failed,0);assert.equal(p.cells.length,16);assert.equal(p.bindingSha256,b.bindingSha256);assert.equal(E.read(N.DIR+'/preview-readback-proof.json').unplannedFileChanges,0);}return b;}\nasync function run(name){const b=before(name),t=targets[name],files=b.changedThisTask;assert.equal(files.length,16);const args=['theme','push','--store','sz5dnk-nf.myshopify.com','--theme',t.id,'--path','.'];for(const f of files)args.push('--only',f);args.push('--nodelete','--strict',...(name==='main'?['--allow-live']:[]),'--json');fs.writeFileSync(N.DIR+'/'+name+'-push-reservation.json',JSON.stringify({startedAt:new Date().toISOString(),bindingSha256:b.bindingSha256,files,target:t.id})+'\\n',{flag:'wx'});let stdout='',stderr='';const child=cp.spawn(process.execPath,[CLI,...args],{env:cleanEnv(),windowsHide:true,stdio:['ignore','pipe','pipe']});child.stdout.on('data',x=>stdout+=x);child.stderr.on('data',x=>stderr+=x);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('exit',resolve);});let result;try{result=JSON.parse(stdout);}catch{for(const line of stdout.split(/\\r?\\n/))try{const x=JSON.parse(line);if(x.theme)result=x;}catch{}}write(name+'-push',{completedAt:new Date().toISOString(),bindingSha256:b.bindingSha256,files,command:['shopify',...args],exitCode,result,stdout:sanitize(stdout),stderr:sanitize(stderr),publication:false});assert.equal(exitCode,0,'Inspect actual readback before retry');assert.equal(String(result?.theme.id),t.id);console.log(JSON.stringify({target:t.id,files:files.length,exitCode,publication:false}));}\nfunction readback(name){const b=B.verify(),r=E.read(N.DIR+'/themes-'+name+'-after-push.json').response.data[name],a=E.read(N.DIR+'/themes-'+name+'-before-push.json').response.data[name],old=inventory(a),now=inventory(r),changed=Object.keys(now).filter(f=>old[f]!==now[f]);assert.equal(r.role,targets[name].role);assert.deepEqual(Object.keys(old).filter(f=>!now[f]),[]);assert.deepEqual(changed.filter(f=>!b.changedThisTask.includes(f)),[]);for(const f of b.sourceAfter){const actual=r.source.nodes.find(n=>n.filename===f.path);assert(actual);if(b.changedThisTask.includes(f.path))assert.equal(E.hash(actual.body.content),f.sha256);else assert.equal(actual.body.content,a.source.nodes.find(n=>n.filename===f.path).body.content);}write(name+'-readback-proof',{completedAt:new Date().toISOString(),bindingSha256:b.bindingSha256,exactSourceFiles:45,changedFileCount:changed.length,unplannedFileChanges:0,deletedFiles:0});console.log(JSON.stringify({target:name,changed:changed.length,unplanned:0}));}\nif(require.main===module)(process.argv.includes('--readback')?Promise.resolve().then(()=>readback(process.argv[2])):run(process.argv[2])).catch(e=>{console.error(sanitize(e.stack));process.exitCode=1;});module.exports={run,readback};\n"
