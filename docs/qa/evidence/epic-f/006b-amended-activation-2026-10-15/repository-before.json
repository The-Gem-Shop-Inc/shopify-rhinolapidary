      "body": "'use strict';\nconst fs=require('node:fs'),assert=require('node:assert/strict'),{chromium}=require('@playwright/test');\nconst E=require('./lib/epic-e-owner-response-adapter'),H=require('./lib/epic-f-owner-activation-binding'),F=require('./lib/epic-f-customer-release');\nconst {auth}=require('./probe-epic-f-header-focus-correction'),{domContract,sanitizeEvidence,sanitize}=require('./smoke-epic-f-live-machine-activation');\nconst {gallery}=require('./validate-epic-f-live-media-browser'),{axe,previewToolbarOwnership}=require('./lib/epic-f-preview-browser');\nconst {classifyRequest}=require('./lib/epic-f-live-performance-guard-v3');\nasync function compatibleKeyboard(page){const links=page.locator('[data-rhino-owner-compatible] .card__heading a:visible'),count=await links.count(),result=[];if(!count)return {state:'NOT_APPLICABLE',links:[]};await page.keyboard.press('Tab');await links.first().focus();for(let i=0;i<count;i++){const link=links.nth(i);assert.equal(await link.evaluate(e=>e===document.activeElement),true,'Native card Tab order');const evidence=await link.evaluate(e=>{const s=getComputedStyle(e),pseudo=getComputedStyle(e,'::after'),r=e.getBoundingClientRect(),visibleOutline=style=>style.outlineStyle!=='none'&&parseFloat(style.outlineWidth)>0;return {productId:e.closest('[data-rhino-owner-compatible]').dataset.rhinoOwnerCompatible,name:e.textContent.trim(),href:e.getAttribute('href').split('?')[0],focusVisible:e.matches(':focus-visible'),visibleIndicator:visibleOutline(s)||visibleOutline(pseudo),targetWidth:Math.max(r.width,parseFloat(pseudo.width)||0),targetHeight:Math.max(r.height,parseFloat(pseudo.height)||0)};});assert(evidence.name&&evidence.focusVisible&&evidence.visibleIndicator);assert(evidence.targetWidth>=24&&evidence.targetHeight>=24,'Native card touch target');result.push(evidence);await page.keyboard.press('Tab');}return {state:'PASS',links:result,transactionControlsActivated:false};}\nasync function run(mode){assert(['preview','main','preview-probe'].includes(mode));const b=H.verify(),projection=F.verifyRelease().projection,media=E.read('data/epic-f-media-release.json'),browser=await chromium.launch({headless:true});let cookies;const result={mode,startedAt:new Date().toISOString(),bindingSha256:b.bindingSha256,cells:[],failed:0,critical:0,serious:0,browserProductMutations:0,performanceSampling:false};const save=()=>fs.writeFileSync(E.DIR+'/'+mode+'-browser.json',JSON.stringify(sanitizeEvidence(result),null,2)+'\\n');\n try{cookies=await auth(browser);const products=mode==='preview-probe'?projection.pages.slice(0,1):projection.pages;for(const p of products)for(const width of mode==='preview-probe'?[390]:[390,1440]){const context=await browser.newContext({viewport:{width,height:1000},deviceScaleFactor:1,acceptDownloads:false});await context.addCookies(cookies);const page=await context.newPage(),errors=[],transactions=[];page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{let frame;try{frame=r.frame();}catch{}const decision=classifyRequest({url:r.url(),method:r.method(),resourceType:r.resourceType(),isNavigation:r.isNavigationRequest(),isMainFrame:frame===page.mainFrame(),postData:r.postData()});if(decision.action==='INVALIDATE'){const u=new URL(r.url());transactions.push({origin:u.origin,path:u.pathname,method:r.method(),type:r.resourceType(),decision});void context.close();}});const cell={productGid:p.productGid,handle:p.handle,width};try{const route='/products/'+p.handle,u=new URL(route,'https://sz5dnk-nf.myshopify.com');if(mode!=='main')u.searchParams.set('preview_theme_id','158631198917');const response=await page.goto(u.toString(),{waitUntil:'load',timeout:60000});assert.equal(response.status(),200);assert.equal(new URL(page.url()).pathname,route);await page.evaluate(()=>document.fonts.ready);await page.waitForTimeout(1500);const theme=await page.evaluate(()=>String(window.Shopify?.theme?.id));assert.equal(theme,mode==='main'?'158579622085':'158631198917');cell.dom=await domContract(page);assert.equal(cell.dom.productId,p.productGid.split('/').pop());assert.equal(cell.dom.shellCount,1);assert.equal(cell.dom.horizontalOverflow,false);assert.equal(cell.dom.liquidErrors,false);assert.equal(cell.dom.description,null);assert.equal(cell.dom.emptyShellHeadings,0);assert(cell.dom.price&&cell.dom.purchase&&cell.dom.contact?.visible&&cell.dom.terms?.rendered);assert.equal(cell.dom.graphErrors.length,0);for(const graph of cell.dom.graphEvidence){assert(!graph.properties.includes('description'));assert(!graph.properties.includes('additionalProperty'));}assert(cell.dom.ogImage&&new URL(cell.dom.ogImage).pathname.endsWith('/assets/rhino-og-default.jpg'),'Governed brand social image');assert.equal(cell.dom.ogDescription,null);cell.facts=await page.locator('[data-rhino-owner-field]').evaluateAll(es=>es.map(e=>({field:e.dataset.rhinoOwnerField,surface:e.dataset.rhinoOwnerSurface,value:e.querySelector('dd').textContent.trim()})));const details=cell.facts.filter(n=>n.surface==='detail');assert.deepEqual(details,p.specs.map(s=>({field:s.role.id,surface:'detail',value:s.row.display})));for(const key of cell.facts.filter(n=>n.surface==='key'))assert(details.some(d=>d.field===key.field&&d.value===key.value));assert(cell.facts.filter(n=>n.surface==='key').length<=3);cell.contents=await page.locator('[data-rhino-owner-content]').evaluateAll(es=>es.map(e=>({label:e.dataset.rhinoOwnerContent,text:e.textContent.replace(/\\s+/g,' ').trim()})));assert.deepEqual(cell.contents,p.contents.map(i=>({label:i.line.label,text:i.line.label+' × '+i.line.quantity})));cell.cards=await page.locator('[data-rhino-owner-compatible]').evaluateAll(es=>es.map(e=>({id:e.dataset.rhinoOwnerCompatible,imageCount:e.querySelectorAll('img').length,title:e.querySelector('.card__heading')?.textContent.trim(),price:e.querySelector('.price')?.textContent.trim(),href:e.querySelector('.card__heading a')?.getAttribute('href')?.split('?')[0]})));assert.deepEqual(cell.cards.map(c=>c.id),p.cards.map(c=>c.productGid.split('/').pop()));assert(cell.cards.every(c=>c.imageCount===0&&c.title&&c.href));assert.deepEqual(cell.cards.map(c=>c.href),p.cards.map(c=>'/products/'+c.handle));cell.compatibleKeyboard=await compatibleKeyboard(page);assert.equal(await page.locator('[data-rhino-owner-field^=\"crate_\"],[data-rhino-owner-field=\"motor_speed\"][data-rhino-owner-surface=\"detail\"]').count(),p.handle==='em-1-machine'?0:details.filter(d=>d.field==='motor_speed').length);assert.equal(await page.locator('[id^=\"MachineResources-\"],[id^=\"MachineSupport-\"],[id^=\"MachineDelivery-\"]').count(),0);const ownership=mode==='main'?null:await previewToolbarOwnership(page),exclusion=ownership?.verified?ownership.selector:null;cell.previewToolbar=ownership;cell.accessibility=await axe(page,exclusion);assert.equal(cell.accessibility.clean,true);result.critical+=cell.accessibility.counts.critical;result.serious+=cell.accessibility.counts.serious;cell.gallery=await gallery(page,media.grants.find(g=>g.productGid===p.productGid),exclusion);if(width===390){await page.evaluate(()=>document.documentElement.style.fontSize=parseFloat(getComputedStyle(document.documentElement).fontSize)*2+'px');await page.waitForTimeout(350);cell.text200={overflow:await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),facts:await page.locator('[data-rhino-owner-field][data-rhino-owner-surface=detail]:visible').count()};assert.equal(cell.text200.overflow,false);assert.equal(cell.text200.facts,p.specs.length);}assert.deepEqual(errors,[]);assert.deepEqual(transactions,[]);cell.pageErrors=errors;cell.transactions=transactions;cell.passed=true;console.log(JSON.stringify({mode,handle:p.handle,width,specs:details.length,contents:cell.contents.length,cards:cell.cards.length,axe:'PASS'}));}catch(e){cell.passed=false;cell.error=sanitize(e.message);cell.pageErrors=errors;cell.transactions=transactions;result.failed++;throw e;}finally{result.cells.push(cell);await context.close().catch(()=>{});save();}}}catch(e){result.exception=sanitize(e.stack);throw e;}finally{cookies=null;await browser.close();result.completedAt=new Date().toISOString();save();}return result;}\nif(require.main===module)run(process.argv[2]).catch(e=>{console.error(sanitize(e.stack));process.exitCode=1;});module.exports={run};\n"
