      "body": "'use strict';\n// Reuse the completed, successful F1-F7 execution, then refresh F8's readiness\n// snapshot. The earlier stale-snapshot command exit remains preserved verbatim.\nconst fs=require('node:fs'),assert=require('node:assert/strict'),cp=require('node:child_process'),E=require('./lib/epic-e-owner-response-adapter'),H=require('./lib/epic-f-owner-activation-binding');\nconst binding=H.verify(),previous=E.read('test-results/epic-f/f8/batch-f8-validation.json');\nassert.equal(previous.results.find(r=>r.command==='npm run validate:epic-f-batch-f7')?.exitCode,0,'Complete current F1-F7 required');\nassert.equal(previous.results.find(r=>r.command==='npm run theme:check')?.exitCode,0);\nconst archive=E.DIR+'/local-aggregate-stale-readiness-attempt.json';if(!fs.existsSync(archive))fs.writeFileSync(archive,JSON.stringify(previous,null,2)+'\\n');\nconst regression=[];for(let n=1;n<=7;n++){const path='test-results/epic-f/'+(n===1?'':'f'+n+'/')+'batch-f'+n+'-validation.json',r=E.read(path);assert.equal(r.exitCode,0,'F'+n+' failed');assert(Date.parse(r.assessedAt)>Date.parse(E.read(E.RECEIPT).reconciledAt),'Old suite cannot certify new source');for(const check of r.results)if(check.required??check.requiredForBatch??true)assert.equal(check.exitCode,0,check.command);regression.push({batch:'F'+n,path,sha256:E.hash(fs.readFileSync(path)),assessedAt:r.assessedAt,exitCode:0});}\nconst commands=[];if(process.argv.includes('--reuse-completed-checks')){const saved=E.read(E.DIR+'/local-completed-checks.json');assert.deepEqual(saved.binding.sourceAfter,binding.sourceAfter);assert.deepEqual(saved.binding.qaDelta,binding.qaDelta);for(const ref of saved.binding.provenance.filter(r=>!['scripts/finalize-epic-f-owner-local-validation.js','scripts/deploy-epic-f-owner-activation.js','scripts/validate-epic-f-owner-live-browser.js'].includes(r.path)))assert.equal(E.hash(fs.readFileSync(ref.path)),ref.sha256);for(const ref of saved.refs)assert.equal(E.hash(fs.readFileSync(ref.path)),ref.sha256);assert.deepEqual(require('./lib/epic-f-machine-page-readiness').validate(E.read('data/epic-f-machine-page-readiness.json')),[]);commands.push(...saved.commands.map(r=>({...r,reusedCompleteCheck:true})));}else for(const script of ['build-epic-f-machine-page-readiness.js','validate-epic-f-machine-page-readiness.js','test-epic-f-machine-page-readiness.js','validate-epic-e-owner-activation.js','test-epic-e-owner-response-adapter.js']){const p=cp.spawnSync(process.execPath,['scripts/'+script],{encoding:'utf8',maxBuffer:16*1024*1024}),log=E.DIR+'/local-'+script.replace('.js','')+'.log';fs.writeFileSync(log,(p.stdout||'')+(p.stderr||''));commands.push({command:'node scripts/'+script,exitCode:p.status??1,log});assert.equal(p.status,0,script);}\nconst theme=cp.spawnSync(process.execPath,[require('./deploy-epic-f-header-focus-correction').CLI,'theme','check'],{encoding:'utf8',env:require('./deploy-epic-f-header-focus-correction').cleanEnv(),maxBuffer:16*1024*1024});fs.writeFileSync(E.DIR+'/local-theme-check.log',(theme.stdout||'')+(theme.stderr||''));assert.equal(theme.status,0);assert.match((theme.stdout||'')+(theme.stderr||''),/no offenses found/);commands.push({command:'shopify theme check',exitCode:0,errors:0,warnings:0,log:E.DIR+'/local-theme-check.log'});\nconst diff=cp.spawnSync('git',['diff','--check'],{encoding:'utf8'});assert.equal(diff.status,0);commands.push({command:'git diff --check',exitCode:0});\nconst tests=E.read('test-results/epic-f/f8/readiness-tests.json');assert.equal(tests.failed,0);H.verify();const result={completedAt:new Date().toISOString(),sourceBindingSha256:binding.bindingSha256,exitCode:0,scope:'Current F1-F8 repository aggregate under reconciled owner binding; F1-F7 complete suite evidence reused, F8 readiness rebuilt and tested',priorAttempt:{path:archive,sha256:E.hash(fs.readFileSync(archive)),originalExitCode:previous.exitCode,reason:'Readiness snapshot preceded the completed current regression'},regression,commands,readinessTests:tests,ThemeCheck:{errors:0,warnings:0},thresholdsChanged:false,performanceCertification:false};fs.writeFileSync(E.DIR+'/local-validation.json',JSON.stringify(result,null,2)+'\\n');console.log(JSON.stringify({exitCode:0,regression:'F1-F8',adapter:E.read(E.DIR+'/adapter-compiler-tests.json').passed,readiness:tests.passed}));\n"
