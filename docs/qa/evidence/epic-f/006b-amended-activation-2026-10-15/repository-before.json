      "sha256": "309c5fd98199953857829f181c573aeb08802e143ab13bd42ba453b7ea73d745",
      "body": "{%- comment -%}\nGenerated exact F-DEC-002-DEV current-Product development grants.\nFinal launch rights/content quality remain separately reviewable. No facts or cross-Product authority.\n{%- endcomment -%}\n{%- assign rhino_product_id = product.id | append: '' -%}\n{%- assign rhino_media_id = media.id | append: '' -%}\n{%- assign rhino_media_store_prefix = request.host | prepend: '//' | append: '/cdn/shop/' -%}\n{%- assign rhino_media_source = media.preview_image.src | remove_first: 'https:' | remove_first: 'http:' | remove_first: '//cdn.shopify.com/s/files/1/0792/7994/7973/' | remove_first: rhino_media_store_prefix | remove_first: '/cdn/shop/' | remove_first: '/s/files/1/0792/7994/7973/' -%}\n{%- if template.suffix == 'machine' and product.published_at != blank and media.media_type == 'image' -%}\n  {%- assign rhino_media_source_matches = false -%}\n  {%- if rhino_media_source == 'files/s886176631913542175_p78_i10_w1440.jpg?v=1783011248' or rhino_media_source == 'files/s886176631913542175_p78_i10_w1440.jpg' -%}{%- assign rhino_media_source_matches = true -%}{%- endif -%}\n  {%- if rhino_product_id == '8905779937477' and rhino_media_id == '33451099455685' and media.alt == 'Rhino Lapidary BeadMaster machine, front view' and media.preview_image.alt == 'Rhino Lapidary BeadMaster machine, front view' and rhino_media_source_matches and media.preview_image.width == 1440 and media.preview_image.height == 1440 -%}eligible{%- endif -%}\n  {%- assign rhino_media_source_matches = false -%}\n  {%- if rhino_media_source == 'files/s886176631913542175_p81_i5_w1440.jpg?v=1783011273' or rhino_media_source == 'files/s886176631913542175_p81_i5_w1440.jpg' -%}{%- assign rhino_media_source_matches = true -%}{%- endif -%}\n  {%- if rhino_product_id == '8905781412037' and rhino_media_id == '33451104895173' and media.alt == 'Rhino Lapidary LapMaster machine, view from above' and media.preview_image.alt == 'Rhino Lapidary LapMaster machine, view from above' and rhino_media_source_matches and media.preview_image.width == 1440 and media.preview_image.height == 1440 -%}eligible{%- endif -%}\n  {%- assign rhino_media_source_matches = false -%}\n  {%- if rhino_media_source == 'files/s886176631913542175_p82_i2_w1440.jpg?v=1783011274' or rhino_media_source == 'files/s886176631913542175_p82_i2_w1440.jpg' -%}{%- assign rhino_media_source_matches = true -%}{%- endif -%}\n  {%- if rhino_product_id == '8905781477573' and rhino_media_id == '33451105255621' and media.alt == 'Rhino Lapidary LapMaster machine, angled view' and media.preview_image.alt == 'Rhino Lapidary LapMaster machine, angled view' and rhino_media_source_matches and media.preview_image.width == 1440 and media.preview_image.height == 1440 -%}eligible{%- endif -%}\n  {%- assign rhino_media_source_matches = false -%}\n  {%- if rhino_media_source == 'files/s886176631913542175_p83_i6_w1440.jpg?v=1783011322' or rhino_media_source == 'files/s886176631913542175_p83_i6_w1440.jpg' -%}{%- assign rhino_media_source_matches = true -%}{%- endif -%}\n  {%- if rhino_product_id == '8905784131781' and rhino_media_id == '33451117576389' and media.alt == 'Rhino Lapidary SawMaster machine with the lid open, angled view' and media.preview_image.alt == 'Rhino Lapidary SawMaster machine with the lid open, angled view' and rhino_media_source_matches and media.preview_image.width == 1440 and media.preview_image.height == 1440 -%}eligible{%- endif -%}\n  {%- assign rhino_media_source_matches = false -%}\n  {%- if rhino_media_source == 'files/s886176631913542175_p79_i14_w1440.jpg?v=1783011325' or rhino_media_source == 'files/s886176631913542175_p79_i14_w1440.jpg' -%}{%- assign rhino_media_source_matches = true -%}{%- endif -%}\n  {%- if rhino_product_id == '8905784328389' and rhino_media_id == '33451118428357' and media.alt == 'Rhino Lapidary ShapeMaster machine, angled front view' and media.preview_image.alt == 'Rhino Lapidary ShapeMaster machine, angled front view' and rhino_media_source_matches and media.preview_image.width == 1440 and media.preview_image.height == 1440 -%}eligible{%- endif -%}\n  {%- assign rhino_media_source_matches = false -%}\n  {%- if rhino_media_source == 'files/s886176631913542175_p80_i20_w1440.jpg?v=1783011345' or rhino_media_source == 'files/s886176631913542175_p80_i20_w1440.jpg' -%}{%- assign rhino_media_source_matches = true -%}{%- endif -%}\n  {%- if rhino_product_id == '8905785344197' and rhino_media_id == '33451123409093' and media.alt == 'Rhino Lapidary TrimMaster machine, angled front view' and media.preview_image.alt == 'Rhino Lapidary TrimMaster machine, angled front view' and rhino_media_source_matches and media.preview_image.width == 1440 and media.preview_image.height == 1440 -%}eligible{%- endif -%}\n{%- endif -%}\n"
