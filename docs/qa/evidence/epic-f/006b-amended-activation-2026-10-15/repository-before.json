      "path": "scripts/lib/epic-f-bom-contents-compiler.js",
      "sha256": "ebd1c9d7c824d8570ec8467972c51baf984c459c39478620ec16b1f5f675e880",
      "body": "'use strict';\nconst assert=require('node:assert/strict'),E=require('./epic-e-owner-response-adapter');\nconst PATH='snippets/rhino-owner-approved-contents-8905780756677.liquid';\nconst q=s=>\"'\"+String(s).replace(/'/g,'&#39;')+\"'\",safe=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction compile(page,state){\n const rows=state.input.rows.filter(r=>r.targetGid===page.productGid&&r.domain==='included_components'),members=rows.find(r=>r.field.endsWith('.included_products')),quantities=rows.find(r=>r.field.endsWith('.included_quantities')),noncat=rows.find(r=>r.field.endsWith('.noncatalog_components'));\n assert(members&&quantities&&noncat);assert(require('./epic-f-facts').quantityMap(quantities.desired,members.desired));\n const starts=Math.floor(Date.parse(state.receipt.reconciledAt)/1000),expires=Math.floor(Date.parse(state.receipt.expiresAt)/1000);\n const out=['{% doc %}\\nExact reconciled EM-1 contents; package children remain within one line.\\n@param {product} product - Exact current machine Product.\\n@param {section} section - Containing machine section.\\n{% enddoc %}', '{%- comment -%}Exact E-reconciled contents. Package children are evidence, not duplicate membership lines.{%- endcomment -%}',\"{%- assign rhino_bom_now = 'now' | date: '%s' | plus: 0 -%}\",`{%- if template.suffix == 'machine' and product.id == 8905780756677 and product.published_at != blank and product.metafields.rhino.product_class.value == 'machine' and rhino_bom_now >= ${starts} and rhino_bom_now < ${expires} -%}`,\"{%- assign rhino_bom_members = product.metafields.rhino.included_products.value -%}\",\"{%- assign rhino_bom_quantities = product.metafields.rhino.included_quantities.value -%}\",\"{%- assign rhino_bom_noncatalog = product.metafields.rhino.noncatalog_components.value -%}\",\"{%- assign rhino_bom_ids = rhino_bom_members | map: 'id' | sort | join: ',' -%}\",\"{%- assign rhino_bom_valid = true -%}\"];\n const checks=[\"product.metafields.rhino.included_products.type == 'list.product_reference'\",\"product.metafields.rhino.included_quantities.type == 'json'\",\"product.metafields.rhino.noncatalog_components.type == 'json'\",`rhino_bom_ids == ${q(members.desired.map(g=>g.split('/').pop()).sort().join(','))}`,`rhino_bom_quantities.size == ${members.desired.length}`,`rhino_bom_noncatalog.size == ${noncat.desired.length}`];\n for(const gid of members.desired){const part=state.products.find(p=>p.id===gid);assert(part&&part.publishedAt&&part.status==='ACTIVE');const ident=require('../../data/epic-e-product-identity.json').productIdentities.find(p=>p.productGid===gid);assert.equal(part.handle,ident.handle);const cls=part.metafields.nodes.find(m=>m.namespace==='rhino'&&m.key==='product_class').jsonValue;assert(['consumable','accessory','replacement_part'].includes(cls));const i=members.desired.indexOf(gid);out.push(`{%- assign rhino_bom_part_${i} = all_products[${q(part.handle)}] -%}`);checks.push(`rhino_bom_quantities[${q(gid)}] == ${quantities.desired[gid]}`,`rhino_bom_part_${i}.id == ${gid.split('/').pop()}`,`rhino_bom_part_${i}.metafields.rhino.product_class.value == ${q(cls)}`);}\n out.push(`{%- unless ${checks.join(' and ')} -%}{%- assign rhino_bom_valid = false -%}{%- endunless -%}`);\n // Validate the entire noncatalog array before displaying any member. No index/label fallback.\n out.push('{%- for rhino_bom_line in rhino_bom_noncatalog -%}','{%- case forloop.index0 -%}');for(let i=0;i<noncat.desired.length;i++){const l=noncat.desired[i];out.push(`{%- when ${i} -%}`,`{%- unless rhino_bom_line.label == ${q(l.label)} and rhino_bom_line.quantity == ${l.quantity} and rhino_bom_line.meaning == 'included' -%}{%- assign rhino_bom_valid = false -%}{%- endunless -%}`);}out.push('{%- else -%}{%- assign rhino_bom_valid = false -%}','{%- endcase -%}','{%- endfor -%}','{%- if rhino_bom_valid -%}',\"{{ 'component-card.css' | asset_url | stylesheet_tag }}\",'<section class=\"rhino-machine-facts rhino-machine-contents\" aria-labelledby=\"OwnerContents-{{ section.id }}\"><h2 id=\"OwnerContents-{{ section.id }}\">{{ \\'products.product.machine_facts.included\\' | t }}</h2><ul class=\"rhino-machine-contents-list\" role=\"list\">');\n for(let i=0;i<members.desired.length;i++){const item=page.contents[i];out.push(`<li class=\"rhino-machine-component\" data-rhino-owner-content=\"${safe(item.line.label)}\" data-rhino-owner-catalog=\"${members.desired[i].split('/').pop()}\">`,`{% assign rhino_bom_card_id = section.id | append: '-contents-${i}' %}{% render 'card-product', card_product: rhino_bom_part_${i}, section_id: rhino_bom_card_id, skip_styles: true, quick_add: 'none', show_vendor: false, show_rating: false, show_secondary_image: false, extend_height: false, rhino_contents_context: true, rhino_owner_customer_context: true %}`,`<span class=\"rhino-machine-component-quantity\">× ${quantities.desired[members.desired[i]]}</span></li>`);}\n for(const l of noncat.desired)out.push(`<li data-rhino-owner-content=\"${safe(l.label)}\">${safe(l.label)} <span class=\"rhino-machine-component-quantity\">× ${l.quantity}</span></li>`);\n out.push('</ul></section>','{%- endif -%}','{%- endif -%}');return out.join('\\n')+'\\n';\n}\nmodule.exports={PATH,compile};\n"
