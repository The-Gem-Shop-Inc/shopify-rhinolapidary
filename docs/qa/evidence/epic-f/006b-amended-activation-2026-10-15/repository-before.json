      "path": "snippets/cart-drawer.liquid",
      "sha256": "c1091354befbffa1bc0ed114d978377c436b8dc47e8e9eb348a843845d619c9a",
      "body": "{% comment %}\r\n  Renders cart drawer\r\n\r\n  Usage:\r\n  {% render 'cart-drawer' %}\r\n{% endcomment %}\r\n\r\n{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}\r\n{{ 'component-card.css' | asset_url | stylesheet_tag }}\r\n\r\n<script src=\"{{ 'cart.js' | asset_url }}\" defer=\"defer\"></script>\r\n<script src=\"{{ 'quantity-popover.js' | asset_url }}\" defer=\"defer\"></script>\r\n\r\n<style>\r\n  .drawer {\r\n    visibility: hidden;\r\n  }\r\n</style>\r\n\r\n<cart-drawer class=\"drawer{% if cart == empty %} is-empty{% endif %}\">\r\n  <div id=\"CartDrawer\" class=\"cart-drawer\">\r\n    <div id=\"CartDrawer-Overlay\" class=\"cart-drawer__overlay\"></div>\r\n    <div\r\n      class=\"drawer__inner gradient color-{{ settings.cart_color_scheme }}\"\r\n      role=\"dialog\"\r\n      aria-modal=\"true\"\r\n      aria-label=\"{{ 'sections.cart.title' | t }}\"\r\n      tabindex=\"-1\"\r\n    >\r\n      {%- if cart == empty -%}\r\n        <div class=\"drawer__inner-empty\">\r\n          <div class=\"cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}\">\r\n            <div class=\"cart-drawer__empty-content\">\r\n              <h2 class=\"cart__empty-text\">{{ 'sections.cart.empty' | t }}</h2>\r\n              <button\r\n                class=\"drawer__close\"\r\n                type=\"button\"\r\n                onclick=\"this.closest('cart-drawer').close()\"\r\n                aria-label=\"{{ 'accessibility.close' | t }}\"\r\n              >\r\n                <span class=\"svg-wrapper\">\r\n                  {{- 'icon-close.svg' | inline_asset_content -}}\r\n                </span>\r\n              </button>\r\n              <a href=\"{{ routes.all_products_collection_url }}\" class=\"button\">\r\n                {{ 'general.continue_shopping' | t }}\r\n              </a>\r\n\r\n              {%- if shop.customer_accounts_enabled and customer == null -%}\r\n                <p class=\"cart__login-title h3\">{{ 'sections.cart.login.title' | t }}</p>\r\n                <p class=\"cart__login-paragraph\">\r\n                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}\r\n                </p>\r\n              {%- endif -%}\r\n            </div>\r\n          </div>\r\n          {%- if settings.cart_drawer_collection != blank -%}\r\n            <div class=\"cart-drawer__collection\">\r\n              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}\r\n            </div>\r\n          {%- endif -%}\r\n        </div>\r\n      {%- endif -%}\r\n      <div class=\"drawer__header\">\r\n        <h2 class=\"drawer__heading\">{{ 'sections.cart.title' | t }}</h2>\r\n        <button\r\n          class=\"drawer__close\"\r\n          type=\"button\"\r\n          onclick=\"this.closest('cart-drawer').close()\"\r\n          aria-label=\"{{ 'accessibility.close' | t }}\"\r\n        >\r\n          <span class=\"svg-wrapper\">\r\n            {{- 'icon-close.svg' | inline_asset_content -}}\r\n          </span>\r\n        </button>\r\n      </div>\r\n      <cart-drawer-items\r\n        view-event-payload=\"{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}\"\r\n        view-event-trigger=\"manual\"\r\n        {% if cart == empty %}\r\n          class=\" is-empty\"\r\n        {% endif %}\r\n      >\r\n        <form\r\n          action=\"{{ routes.cart_url }}\"\r\n          id=\"CartDrawer-Form\"\r\n          class=\"cart__contents cart-drawer__form\"\r\n          method=\"post\"\r\n        >\r\n          <div id=\"CartDrawer-CartItems\" class=\"drawer__contents js-contents\">\r\n            {%- if cart != empty -%}\r\n              <div class=\"drawer__cart-items-wrapper\">\r\n                <table class=\"cart-items\" role=\"table\">\r\n                  <thead role=\"rowgroup\">\r\n                    <tr role=\"row\">\r\n                      <th id=\"CartDrawer-ColumnProductImage\" role=\"columnheader\">\r\n                        <span class=\"visually-hidden\">{{ 'sections.cart.headings.image' | t }}</span>\r\n                      </th>\r\n                      <th\r\n                        id=\"CartDrawer-ColumnProduct\"\r\n                        class=\"caption-with-letter-spacing\"\r\n                        scope=\"col\"\r\n                        role=\"columnheader\"\r\n                      >\r\n                        {{ 'sections.cart.headings.product' | t }}\r\n                      </th>\r\n                      <th\r\n                        id=\"CartDrawer-ColumnTotal\"\r\n                        class=\"right caption-with-letter-spacing\"\r\n                        scope=\"col\"\r\n                        role=\"columnheader\"\r\n                      >\r\n                        {{ 'sections.cart.headings.total' | t }}\r\n                      </th>\r\n                      <th id=\"CartDrawer-ColumnQuantity\" role=\"columnheader\">\r\n                        <span class=\"visually-hidden\">{{ 'sections.cart.headings.quantity' | t }}</span>\r\n                      </th>\r\n                    </tr>\r\n                  </thead>\r\n\r\n                  <tbody role=\"rowgroup\">\r\n                    {%- for item in cart.items -%}\r\n{%- capture rhino_consumer_route -%}{%- render 'rhino-product-consumer-route', product: item.product -%}{%- endcapture -%}\r\n{%- assign rhino_legacy_content = false -%}\r\n{%- if rhino_consumer_route == 'replacement_part' or rhino_consumer_route == 'consumable' or rhino_consumer_route == 'accessory' -%}{%- assign rhino_legacy_content = true -%}{%- endif -%}\r\n\r\n                      <tr\r\n                        id=\"CartDrawer-Item-{{ item.index | plus: 1 }}\"\r\n                        class=\"cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}\"\r\n                        role=\"row\"\r\n                        {% if item.parent_relationship.parent != null %}\r\n                          aria-label=\"{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}\"\r\n                        {% endif %}\r\n                      >\r\n                        <td\r\n                          class=\"cart-item__media\"\r\n                          role=\"cell\"\r\n                          headers=\"CartDrawer-ColumnProductImage\"\r\n                        >\r\n                          {% if rhino_legacy_content and item.image %}\r\n                            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}\r\n                            <a href=\"{{ item.url }}\" class=\"cart-item__link\" tabindex=\"-1\" aria-hidden=\"true\"> </a>\r\n                            <img\r\n                              class=\"cart-item__image\"\r\n                              src=\"{{ item.image | image_url: width: 300 }}\"\r\n                              alt=\"{{ item.image.alt | escape }}\"\r\n                              loading=\"lazy\"\r\n                              width=\"150\"\r\n                              height=\"{{ 150 | divided_by: item.image.aspect_ratio | ceil }}\"\r\n                            >\r\n                          {% endif %}\r\n                        </td>\r\n\r\n                        <td class=\"cart-item__details\" role=\"cell\" headers=\"CartDrawer-ColumnProduct\">\r\n                          {%- if settings.show_vendor -%}\r\n                            <p class=\"caption-with-letter-spacing light\">{{ item.product.vendor }}</p>\r\n                          {%- endif -%}\r\n\r\n                          <div class=\"cart-item__title\">\r\n                            <a href=\"{{ item.url }}\" class=\"cart-item__name h4 break\">\r\n                              {{- item.product.title | escape -}}\r\n                            </a>\r\n                            {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-drawer-' | append: item.key | replace: ':', '-' -%}\r\n                            {%- render 'cart-disclosure-indicator',\r\n                              product: item.product,\r\n                              modal_id: cart_disclosure_modal_id\r\n                            -%}\r\n                          </div>\r\n\r\n                          {%- if item.original_price != item.final_price -%}\r\n                            <div class=\"cart-item__discounted-prices\">\r\n                              <span class=\"visually-hidden\">\r\n                                {{ 'products.product.price.regular_price' | t }}\r\n                              </span>\r\n                              <s class=\"cart-item__old-price product-option\">\r\n                                {{- item.original_price | money -}}\r\n                              </s>\r\n                              <span class=\"visually-hidden\">\r\n                                {{ 'products.product.price.sale_price' | t }}\r\n                              </span>\r\n                              <strong class=\"cart-item__final-price product-option\">\r\n                                {{ item.final_price | money }}\r\n                              </strong>\r\n                            </div>\r\n                          {%- else -%}\r\n                            <div class=\"product-option\">\r\n                              {{ item.original_price | money }}\r\n                            </div>\r\n                          {%- endif -%}\r\n\r\n                          {%- if item.product.has_only_default_variant == false\r\n                            or item.properties.size != 0\r\n                            or item.selling_plan_allocation != null\r\n                          -%}\r\n                            <dl>\r\n                              {%- if item.product.has_only_default_variant == false -%}\r\n                                {%- for option in item.options_with_values -%}\r\n                                  <div class=\"product-option\">\r\n                                    <dt>{{ option.name }}:</dt>\r\n                                    <dd>\r\n                                      {{ option.value -}}\r\n                                      {%- unless forloop.last %}, {% endunless %}\r\n                                    </dd>\r\n                                  </div>\r\n                                {%- endfor -%}\r\n                              {%- endif -%}\r\n\r\n                              {%- for property in item.properties -%}\r\n                                {%- assign property_first_char = property.first | slice: 0 -%}\r\n                                {%- if property.last != blank and property_first_char != '_' -%}\r\n                                  <div class=\"product-option\">\r\n                                    <dt>{{ property.first }}:</dt>\r\n                                    <dd>\r\n                                      {%- if property.last contains '/uploads/' -%}\r\n                                        <a\r\n                                          href=\"{{ property.last }}\"\r\n                                          class=\"link\"\r\n                                          target=\"_blank\"\r\n                                          aria-describedby=\"a11y-new-window-message\"\r\n                                        >\r\n                                          {{ property.last | split: '/' | last }}\r\n                                        </a>\r\n                                      {%- else -%}\r\n                                        {{ property.last }}\r\n                                      {%- endif -%}\r\n                                    </dd>\r\n                                  </div>\r\n                                {%- endif -%}\r\n                              {%- endfor -%}\r\n                            </dl>\r\n\r\n                            <p class=\"product-option\">{{ item.selling_plan_allocation.selling_plan.name }}</p>\r\n                          {%- endif -%}\r\n\r\n                          <ul\r\n                            class=\"discounts list-unstyled\"\r\n                            role=\"list\"\r\n                            aria-label=\"{{ 'customer.order.discount' | t }}\"\r\n                          >\r\n                            {%- for discount in item.line_level_discount_allocations -%}\r\n                              <li class=\"discounts__discount\">\r\n                                {{- 'icon-discount.svg' | inline_asset_content -}}\r\n                                {{ discount.discount_application.title }}\r\n                              </li>\r\n                            {%- endfor -%}\r\n                          </ul>\r\n                        </td>\r\n\r\n                        <td class=\"cart-item__totals right\" role=\"cell\" headers=\"CartDrawer-ColumnTotal\">\r\n                          {%- render 'loading-spinner' -%}\r\n                          <div class=\"cart-item__price-wrapper\">\r\n                            {%- if item.original_line_price != item.final_line_price -%}\r\n                              <div class=\"cart-item__discounted-prices\">\r\n                                <span class=\"visually-hidden\">\r\n                                  {{ 'products.product.price.regular_price' | t }}\r\n                                </span>\r\n                                <s class=\"cart-item__old-price price price--end\">\r\n                                  {{ item.original_line_price | money }}\r\n                                </s>\r\n                                <span class=\"visually-hidden\">\r\n                                  {{ 'products.product.price.sale_price' | t }}\r\n                                </span>\r\n                                <span class=\"price price--end\">\r\n                                  {{ item.final_line_price | money }}\r\n                                </span>\r\n                              </div>\r\n                            {%- else -%}\r\n                              <span class=\"price price--end\">\r\n                                {{ item.original_line_price | money }}\r\n                              </span>\r\n                            {%- endif -%}\r\n\r\n                            {%- if item.variant.available and item.unit_price_measurement -%}\r\n                              {% render 'unit-price',\r\n                                price: item.unit_price,\r\n                                measurement: item.unit_price_measurement\r\n                              %}\r\n                            {%- endif -%}\r\n                          </div>\r\n                        </td>\r\n                        {%- liquid\r\n                          assign has_qty_rules = false\r\n                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null\r\n                            assign has_qty_rules = true\r\n                          endif\r\n\r\n                          assign has_vol_pricing = false\r\n                          if item.variant.quantity_price_breaks.size > 0\r\n                            assign has_vol_pricing = true\r\n                          endif\r\n                        -%}\r\n                        <td\r\n                          class=\"cart-item__quantity {% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}\"\r\n                          role=\"cell\"\r\n                          headers=\"CartDrawer-ColumnQuantity\"\r\n                        >\r\n                          <quantity-popover>\r\n                            <div class=\"cart-item__quantity-wrapper quantity-popover-wrapper\">\r\n                              <div class=\"quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}\">\r\n                                <quantity-input class=\"quantity cart-quantity\">\r\n                                  <button\r\n                                    class=\"quantity__button\"\r\n                                    name=\"minus\"\r\n                                    type=\"button\"\r\n                                    {% if item.instructions and item.instructions.can_update_quantity == false %}\r\n                                      disabled\r\n                                    {% endif %}\r\n                                  >\r\n                                    <span class=\"visually-hidden\">\r\n                                      {{-\r\n                                        'products.product.quantity.decrease'\r\n                                        | t: product: item.product.title\r\n                                        | escape\r\n                                      -}}\r\n                                    </span>\r\n                                    <span class=\"svg-wrapper\">\r\n                                      {{- 'icon-minus.svg' | inline_asset_content -}}\r\n                                    </span>\r\n                                  </button>\r\n                                  <input\r\n                                    class=\"quantity__input\"\r\n                                    type=\"number\"\r\n                                    data-quantity-variant-id=\"{{ item.variant.id }}\"\r\n                                    data-quantity-line-key=\"{{ item.key }}\"\r\n                                    name=\"updates[]\"\r\n                                    value=\"{{ item.quantity }}\"\r\n                                    {% # theme-check-disable %}\r\n                                    data-cart-quantity=\"{{ cart | item_count_for_variant: item.variant.id }}\"\r\n                                    min=\"0\"\r\n                                    data-min=\"{{ item.variant.quantity_rule.min }}\"\r\n                                    {% if item.variant.quantity_rule.max != null %}\r\n                                      max=\"{{ item.variant.quantity_rule.max }}\"\r\n                                    {% endif %}\r\n                                    step=\"{{ item.variant.quantity_rule.increment }}\"\r\n                                    {% # theme-check-enable %}\r\n                                    aria-label=\"{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}\"\r\n                                    id=\"Drawer-quantity-{{ item.index | plus: 1 }}\"\r\n                                    data-index=\"{{ item.index | plus: 1 }}\"\r\n                                    {% if item.instructions and item.instructions.can_update_quantity == false %}\r\n                                      disabled\r\n                                    {% endif %}\r\n                                  >\r\n                                  <button\r\n                                    class=\"quantity__button\"\r\n                                    name=\"plus\"\r\n                                    type=\"button\"\r\n                                    {% if item.instructions and item.instructions.can_update_quantity == false %}\r\n                                      disabled\r\n                                    {% endif %}\r\n                                  >\r\n                                    <span class=\"visually-hidden\">\r\n                                      {{-\r\n                                        'products.product.quantity.increase'\r\n                                        | t: product: item.product.title\r\n                                        | escape\r\n                                      -}}\r\n                                    </span>\r\n                                    <span class=\"svg-wrapper\">\r\n                                      {{- 'icon-plus.svg' | inline_asset_content -}}\r\n                                    </span>\r\n                                  </button>\r\n                                </quantity-input>\r\n                              </div>\r\n                              <cart-remove-button\r\n                                id=\"CartDrawer-Remove-{{ item.index | plus: 1 }}\"\r\n                                data-index=\"{{ item.index | plus: 1 }}\"\r\n                              >\r\n                                <button\r\n                                  type=\"button\"\r\n                                  class=\"button button--tertiary cart-remove-button\"\r\n                                  aria-label=\"{{ 'sections.cart.remove_title' | t: title: item.title | escape }}\"\r\n                                  data-variant-id=\"{{ item.variant.id }}\"\r\n                                  {% if item.instructions and item.instructions.can_remove == false %}\r\n                                    class=\"hidden\"\r\n                                  {% endif %}\r\n                                >\r\n                                  <span class=\"svg-wrapper\">\r\n                                    {{- 'icon-remove.svg' | inline_asset_content -}}\r\n                                  </span>\r\n                                </button>\r\n                              </cart-remove-button>\r\n                            </div>\r\n                            {%- if has_qty_rules or has_vol_pricing -%}\r\n                              <button\r\n                                type=\"button\"\r\n                                class=\"quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary\"\r\n                                aria-expanded=\"false\"\r\n                              >\r\n                                <span class=\"svg-wrapper\">\r\n                                  {{- 'icon-info.svg' | inline_asset_content -}}\r\n                                </span>\r\n                                <span>\r\n                                  {%- if has_vol_pricing -%}\r\n                                    {{ 'products.product.volume_pricing.note' | t }}\r\n                                  {%- elsif has_qty_rules -%}\r\n                                    {{ 'products.product.quantity.note' | t }}\r\n                                  {%- endif -%}\r\n                                </span>\r\n                              </button>\r\n                            {%- endif -%}\r\n                            {%- if has_vol_pricing or has_qty_rules -%}\r\n                              <div\r\n                                class=\"cart-items__info global-settings-popup quantity-popover__info\"\r\n                                tabindex=\"-1\"\r\n                                hidden\r\n                              >\r\n                                {%- if has_qty_rules == false -%}\r\n                                  <span class=\"volume-pricing-label caption\">\r\n                                    {{- 'products.product.volume_pricing.title' | t -}}\r\n                                  </span>\r\n                                {%- endif -%}\r\n                                <div class=\"quantity__rules caption\">\r\n                                  {%- if item.variant.quantity_rule.increment > 1 -%}\r\n                                    <span class=\"divider\">\r\n                                      {{-\r\n                                        'products.product.quantity.multiples_of'\r\n                                        | t: quantity: item.variant.quantity_rule.increment\r\n                                      -}}\r\n                                    </span>\r\n                                  {%- endif -%}\r\n                                  {%- if item.variant.quantity_rule.min > 1 -%}\r\n                                    <span class=\"divider\">\r\n                                      {{-\r\n                                        'products.product.quantity.min_of'\r\n                                        | t: quantity: item.variant.quantity_rule.min\r\n                                      -}}\r\n                                    </span>\r\n                                  {%- endif -%}\r\n                                  {%- if item.variant.quantity_rule.max != null -%}\r\n                                    <span class=\"divider\">\r\n                                      {{-\r\n                                        'products.product.quantity.max_of'\r\n                                        | t: quantity: item.variant.quantity_rule.max\r\n                                      -}}\r\n                                    </span>\r\n                                  {%- endif -%}\r\n                                </div>\r\n                                <button\r\n                                  class=\"button-close button button--tertiary\"\r\n                                  type=\"button\"\r\n                                  aria-label=\"{{ 'accessibility.close' | t }}\"\r\n                                >\r\n                                  <span class=\"svg-wrapper\">\r\n                                    {{- 'icon-close.svg' | inline_asset_content -}}\r\n                                  </span>\r\n                                </button>\r\n                                {%- if item.variant.quantity_price_breaks.size > 0 -%}\r\n                                  <volume-pricing class=\"parent-display\">\r\n                                    <ul class=\"list-unstyled\">\r\n                                      <li>\r\n                                        <span>{{ item.variant.quantity_rule.min }}+</span>\r\n                                        <span>{{ item.variant.price | money_with_currency }}/ea</span>\r\n                                      </li>\r\n                                      {%- for price_break in item.variant.quantity_price_breaks -%}\r\n                                        <li>\r\n                                          <span>\r\n                                            {{- price_break.minimum_quantity -}}\r\n                                            <span aria-hidden=\"true\">+</span></span\r\n                                          >\r\n                                          <span>{{ price_break.price | money_with_currency }}/ea</span>\r\n                                        </li>\r\n                                      {%- endfor -%}\r\n                                    </ul>\r\n                                  </volume-pricing>\r\n                                {%- endif -%}\r\n                              </div>\r\n                            {%- endif -%}\r\n                            <div\r\n                              id=\"CartDrawer-LineItemError-{{ item.index | plus: 1 }}\"\r\n                              class=\"cart-item__error\"\r\n                              role=\"alert\"\r\n                            >\r\n                              <small class=\"cart-item__error-text\"></small>\r\n                              <span class=\"svg-wrapper\">\r\n                                {{- 'icon-error.svg' | inline_asset_content -}}\r\n                              </span>\r\n                            </div>\r\n                          </quantity-popover>\r\n                        </td>\r\n                      </tr>\r\n                    {%- endfor -%}\r\n                  </tbody>\r\n                </table>\r\n              </div>\r\n            {%- endif -%}\r\n            <p id=\"CartDrawer-LiveRegionText\" class=\"visually-hidden\" role=\"status\"></p>\r\n            <p id=\"CartDrawer-LineItemStatus\" class=\"visually-hidden\" aria-hidden=\"true\" role=\"status\">\r\n              {{ 'accessibility.loading' | t }}\r\n            </p>\r\n          </div>\r\n          <div id=\"CartDrawer-CartErrors\" role=\"alert\"></div>\r\n        </form>\r\n      </cart-drawer-items>\r\n      <div class=\"drawer__footer\">\r\n        {%- if settings.show_cart_note -%}\r\n          <details id=\"Details-CartDrawer\">\r\n            <summary>\r\n              <span class=\"summary__title\">\r\n                {{ 'sections.cart.note' | t }}\r\n                {{- 'icon-caret.svg' | inline_asset_content -}}\r\n              </span>\r\n            </summary>\r\n            <cart-note class=\"cart__note field\">\r\n              <label class=\"visually-hidden\" for=\"CartDrawer-Note\">{{ 'sections.cart.note' | t }}</label>\r\n              <textarea\r\n                id=\"CartDrawer-Note\"\r\n                class=\"text-area text-area--resize-vertical field__input\"\r\n                name=\"note\"\r\n                placeholder=\"{{ 'sections.cart.note' | t }}\"\r\n              >{{ cart.note }}</textarea>\r\n            </cart-note>\r\n          </details>\r\n        {%- endif -%}\r\n\r\n        <!-- Start blocks -->\r\n        <!-- Subtotals -->\r\n\r\n        <div class=\"cart-drawer__footer\" {{ block.shopify_attributes }}>\r\n          <div>\r\n            {%- if cart.cart_level_discount_applications.size > 0 -%}\r\n              <ul class=\"discounts list-unstyled\" role=\"list\" aria-label=\"{{ 'customer.order.discount' | t }}\">\r\n                {%- for discount in cart.cart_level_discount_applications -%}\r\n                  <li class=\"discounts__discount discounts__discount--end\">\r\n                    {{- 'icon-discount.svg' | inline_asset_content -}}\r\n                    {{ discount.title | escape }}\r\n                    (-{{ discount.total_allocated_amount | money }})\r\n                  </li>\r\n                {%- endfor -%}\r\n              </ul>\r\n            {%- endif -%}\r\n          </div>\r\n\r\n          <div class=\"totals\" role=\"status\">\r\n            <h2 class=\"totals__total\">{{ 'sections.cart.estimated_total' | t }}</h2>\r\n            <p class=\"totals__total-value\">{{ cart.total_price | money_with_currency }}</p>\r\n          </div>\r\n\r\n          <small class=\"tax-note caption-large rte\">\r\n            {%- if cart.duties_included and cart.taxes_included -%}\r\n              {%- if shop.shipping_policy.body == blank -%}\r\n                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}\r\n              {%- else -%}\r\n                {{\r\n                  'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'\r\n                  | t: link: shop.shipping_policy.url\r\n                }}\r\n              {%- endif -%}\r\n            {%- elsif cart.duties_included == false and cart.taxes_included -%}\r\n              {%- if shop.shipping_policy.body == blank -%}\r\n                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}\r\n              {%- else -%}\r\n                {{\r\n                  'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'\r\n                  | t: link: shop.shipping_policy.url\r\n                }}\r\n              {%- endif -%}\r\n            {%- elsif cart.duties_included and cart.taxes_included == false -%}\r\n              {%- if shop.shipping_policy.body == blank -%}\r\n                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}\r\n              {%- else -%}\r\n                {{\r\n                  'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'\r\n                  | t: link: shop.shipping_policy.url\r\n                }}\r\n              {%- endif -%}\r\n            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}\r\n              {%- if shop.shipping_policy.body == blank -%}\r\n                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}\r\n              {%- else -%}\r\n                {{\r\n                  'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'\r\n                  | t: link: shop.shipping_policy.url\r\n                }}\r\n              {%- endif -%}\r\n            {%- endif -%}\r\n          </small>\r\n        </div>\r\n\r\n        <!-- CTAs -->\r\n\r\n        <div class=\"cart__ctas\" {{ block.shopify_attributes }}>\r\n          <button\r\n            type=\"submit\"\r\n            id=\"CartDrawer-Checkout\"\r\n            class=\"cart__checkout-button button\"\r\n            name=\"checkout\"\r\n            form=\"CartDrawer-Form\"\r\n            {% if cart == empty %}\r\n              disabled\r\n            {% endif %}\r\n          >\r\n            {{ 'sections.cart.checkout' | t }}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</cart-drawer>\r\n"
    },
    {
      "path": "snippets/meta-tags.liquid",
      "sha256": "ebe74785f747771721b4ab7678f78a1a6e45be3a6c5f600bf04612c01cc2ca52",
      "body": "{%- capture rhino_consumer_route -%}{%- render 'rhino-product-consumer-route', product: product -%}{%- endcapture -%}\r\n{%- assign rhino_legacy_content = false -%}\r\n{%- if rhino_consumer_route == 'replacement_part' or rhino_consumer_route == 'consumable' or rhino_consumer_route == 'accessory' -%}{%- assign rhino_legacy_content = true -%}{%- endif -%}\r\n{%- liquid\r\n  assign og_title = page_title | default: shop.name\r\n  assign og_url = canonical_url | default: request.origin\r\n  assign og_url = og_url | split: '?' | first\r\n  assign og_type = 'website'\r\n  assign og_description = page_description | default: shop.description | default: shop.name\r\n  assign default_social_image_alt = 'Rhino Lapidary brand image with logo on a dark background'\r\n  assign default_social_image_url = 'rhino-og-default.jpg' | asset_url\r\n  assign social_image = nil\r\n  assign social_image_alt = ''\r\n  assign social_image_height = ''\r\n  assign social_image_url = ''\r\n  assign social_image_width = ''\r\n\r\n  if request.page_type == 'product'\r\n    assign og_type = 'product'\r\n    if rhino_legacy_content == false\r\n      assign og_title = product.title\r\n      assign og_description = ''\r\n    endif\r\n    assign product_social_image = product.featured_media.preview_image | default: product.featured_image\r\n    if product_social_image and rhino_legacy_content\r\n      assign social_image = product_social_image\r\n      assign product_social_image_alt = product.featured_media.alt | default: product_social_image.alt\r\n      if product_social_image_alt != blank\r\n        assign social_image_alt = product_social_image_alt\r\n      endif\r\n    endif\r\n  elsif request.page_type == 'article'\r\n    assign og_type = 'article'\r\n    if article.image\r\n      assign social_image = article.image\r\n    endif\r\n  elsif request.page_type == 'collection'\r\n    if collection.image\r\n      assign social_image = collection.image\r\n    endif\r\n  elsif request.page_type == 'password'\r\n    assign og_url = request.origin\r\n  endif\r\n\r\n  if social_image\r\n    assign social_image_width = social_image.width | default: 1200\r\n    assign social_image_height = social_image.height | default: 630\r\n    assign social_image_url = social_image | image_url: width: social_image_width\r\n\r\n    if social_image_alt == blank and social_image.alt != blank\r\n      assign social_image_alt = social_image.alt\r\n    endif\r\n  endif\r\n\r\n  if social_image_alt == blank\r\n    if request.page_type == 'product' and product.title != blank\r\n      assign social_image_alt = product.title\r\n    elsif request.page_type == 'collection' and collection.title != blank\r\n      assign social_image_alt = collection.title\r\n    elsif request.page_type == 'article' and article.title != blank\r\n      assign social_image_alt = article.title\r\n    else\r\n      assign social_image_alt = default_social_image_alt\r\n    endif\r\n  endif\r\n\r\n  if social_image_url == blank\r\n    assign social_image_url = default_social_image_url\r\n    assign social_image_width = 1200\r\n    assign social_image_height = 630\r\n    assign social_image_alt = default_social_image_alt\r\n  endif\r\n\r\n  assign social_image_url_prefix = social_image_url | slice: 0, 2\r\n\r\n  if social_image_url contains 'http://'\r\n    assign social_image_url = social_image_url | replace_first: 'http://', 'https://'\r\n  elsif social_image_url_prefix == '//'\r\n    assign social_image_url = social_image_url | prepend: 'https:'\r\n  elsif social_image_url != blank\r\n    assign social_image_url = social_image_url | prepend: request.origin\r\n  endif\r\n%}\r\n\r\n{% comment %}\r\n  Rhino B-017 social metadata extension. Preserves Trade's core title,\r\n  description, type, price, and Shopify image selection behavior, then adds the\r\n  repository default fallback image, image alt metadata, Twitter image metadata,\r\n  and query-free public URLs for preview-theme compatibility.\r\n{% endcomment %}\r\n\r\n<meta property=\"og:site_name\" content=\"{{ shop.name }}\">\r\n<meta property=\"og:url\" content=\"{{ og_url }}\">\r\n<meta property=\"og:title\" content=\"{{ og_title | escape }}\">\r\n<meta property=\"og:type\" content=\"{{ og_type }}\">\r\n{%- if og_description != blank -%}\r\n<meta property=\"og:description\" content=\"{{ og_description | escape }}\">\r\n{%- endif -%}\r\n\r\n{%- if social_image_url != blank -%}\r\n  <meta property=\"og:image\" content=\"{{ social_image_url }}\">\r\n  <meta property=\"og:image:secure_url\" content=\"{{ social_image_url }}\">\r\n  <meta property=\"og:image:alt\" content=\"{{ social_image_alt | escape }}\">\r\n  {%- if social_image_width != blank -%}\r\n    <meta property=\"og:image:width\" content=\"{{ social_image_width }}\">\r\n  {%- endif -%}\r\n  {%- if social_image_height != blank -%}\r\n    <meta property=\"og:image:height\" content=\"{{ social_image_height }}\">\r\n  {%- endif -%}\r\n{%- endif -%}\r\n\r\n{%- if request.page_type == 'product' -%}\r\n  <meta property=\"og:price:amount\" content=\"{{ product.price | money_without_currency | strip_html }}\">\r\n  <meta property=\"og:price:currency\" content=\"{{ cart.currency.iso_code }}\">\r\n{%- endif -%}\r\n\r\n{%- if settings.social_twitter_link != blank -%}\r\n  <meta name=\"twitter:site\" content=\"{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}\">\r\n{%- endif -%}\r\n<meta name=\"twitter:card\" content=\"summary_large_image\">\r\n<meta name=\"twitter:title\" content=\"{{ og_title | escape }}\">\r\n{%- if og_description != blank -%}\r\n<meta name=\"twitter:description\" content=\"{{ og_description | escape }}\">\r\n{%- endif -%}\r\n{%- if social_image_url != blank -%}\r\n  <meta name=\"twitter:image\" content=\"{{ social_image_url }}\">\r\n  <meta name=\"twitter:image:alt\" content=\"{{ social_image_alt | escape }}\">\r\n{%- endif -%}\r\n"
    },
    {
      "path": "snippets/product-media-modal.liquid",
      "sha256": "97744048cb27bb56e323eaeee7307901331cb9f90c145d24cf2cc3861c3565ef",
      "body": "{%- capture rhino_consumer_route -%}{%- render 'rhino-product-consumer-route', product: product -%}{%- endcapture -%}\r\n{%- assign rhino_legacy_content = false -%}\r\n{%- if rhino_consumer_route == 'replacement_part' or rhino_consumer_route == 'consumable' or rhino_consumer_route == 'accessory' -%}{%- assign rhino_legacy_content = true -%}{%- endif -%}\r\n{%- assign rhino_media = product.media -%}\r\n{%- unless rhino_legacy_content -%}\r\n  {%- assign rhino_media = product.media | where: 'id', '' -%}\r\n  {%- assign rhino_seen_media = '|' -%}\r\n  {%- for media in product.media -%}\r\n    {%- capture rhino_media_eligibility -%}{%- render 'rhino-product-media-eligibility', product: product, media: media -%}{%- endcapture -%}\r\n    {%- assign rhino_media_key = media.id | prepend: '|' | append: '|' -%}\r\n    {%- if rhino_consumer_route == 'machine' and rhino_media_eligibility == 'eligible' -%}\r\n      {%- unless rhino_seen_media contains rhino_media_key -%}\r\n        {%- assign rhino_media_match = product.media | where: 'id', media.id | slice: 0, 1 -%}\r\n        {%- assign rhino_media = rhino_media | concat: rhino_media_match -%}\r\n        {%- assign rhino_seen_media = rhino_seen_media | append: media.id | append: '|' -%}\r\n      {%- endunless -%}\r\n    {%- endif -%}\r\n  {%- endfor -%}\r\n{%- endunless -%}\r\n{%- assign rhino_featured_media = product.selected_or_first_available_variant.featured_media -%}\r\n{%- assign rhino_machine_media = false -%}\r\n{%- unless rhino_legacy_content -%}\r\n  {%- assign rhino_machine_media = true -%}\r\n  {%- assign rhino_featured_media = rhino_media | where: 'id', rhino_featured_media.id | first -%}\r\n  {%- assign rhino_featured_media = rhino_featured_media | default: rhino_media.first -%}\r\n{%- endunless -%}\r\n{%- if rhino_legacy_content or rhino_media.size > 0 -%}\n{% comment %}\r\n  Renders a product media modal. Also see 'product-media-gallery'\r\n\r\n  Accepts:\r\n  - product: {Object} Product liquid object\r\n  - variant_images: {Array} Product images associated with a variant\r\n\r\n  Usage:\r\n  {% render 'product-media-modal' %}\r\n{% endcomment %}\r\n\r\n<product-modal id=\"ProductModal-{{ section.id }}\" class=\"product-media-modal media-modal\">\r\n  <div\r\n    class=\"product-media-modal__dialog color-{{ section.settings.color_scheme }} gradient\"\r\n    role=\"dialog\"\r\n    aria-label=\"{{ 'products.modal.label' | t }}\"\r\n    aria-modal=\"true\"\r\n    tabindex=\"-1\"\r\n  >\r\n    <button\r\n      id=\"ModalClose-{{ section.id }}\"\r\n      type=\"button\"\r\n      class=\"product-media-modal__toggle\"\r\n      aria-label=\"{{ 'accessibility.close' | t }}\"\r\n    >\r\n      {{ 'icon-close.svg' | inline_asset_content }}\r\n    </button>\r\n\r\n    <div\r\n      class=\"product-media-modal__content color-{{ section.settings.color_scheme }} gradient\"\r\n      role=\"document\"\r\n      aria-label=\"{{ 'products.modal.label' | t }}\"\r\n      tabindex=\"0\"\r\n    >\r\n      {%- liquid\r\n        if rhino_featured_media != null\r\n          assign media = rhino_featured_media\r\n          render 'product-media', media: media, rhino_machine_media: rhino_machine_media, loop: section.settings.enable_video_looping, variant_image: section.settings.hide_variants\r\n        endif\r\n      -%}\r\n\r\n      {%- for media in rhino_media -%}\r\n        {%- liquid\r\n          if section.settings.hide_variants and variant_images contains media.src or variant_images contains media.id\r\n            assign variant_image = true\r\n          else\r\n            assign variant_image = false\r\n          endif\r\n\r\n          unless media.id == rhino_featured_media.id\r\n            render 'product-media', media: media, rhino_machine_media: rhino_machine_media, loop: section.settings.enable_video_looping, variant_image: variant_image\r\n          endunless\r\n        -%}\r\n      {%- endfor -%}\r\n    </div>\r\n  </div>\r\n</product-modal>\r\n\r\n{%- endif -%}\r\n"
    },
    {
      "path": "snippets/rhino-machine-contents.liquid",
      "sha256": "daefb3ad5757bf38cbaa0a372a42e8ef0b2283c716387f286c9a9f831d0802fd",
      "body": "{%- if request.host == 'machine.local' and projection.fixture_only -%}\n{%- if projection.contents.size > 0 -%}\n  {{ 'component-card.css' | asset_url | stylesheet_tag }}\n  {{ 'component-price.css' | asset_url | stylesheet_tag }}\n  <section class=\"rhino-machine-facts rhino-machine-contents\" aria-labelledby=\"MachineContents-{{ section.id }}\">\n    <h2 id=\"MachineContents-{{ section.id }}\">{{ 'products.product.machine_facts.contents' | t }}</h2>\n    {% for group in projection.contents %}\n      {% if group.items.size > 0 %}\n        <section aria-labelledby=\"MachineContents-{{ section.id }}-{{ group.meaning }}\">\n          <h3 id=\"MachineContents-{{ section.id }}-{{ group.meaning }}\">{{ group.label_key | t }}</h3>\n          <ul class=\"rhino-machine-contents-list\" role=\"list\">\n            {% for item in group.items %}\n              <li class=\"rhino-machine-component\"{% if item.quantity %} aria-describedby=\"ComponentQuantity-{{ section.id }}-{{ group.meaning }}-{{ forloop.index }}\"{% endif %}>\n                {% if item.product %}\n                  {% assign contents_section_id = section.id | append: '-contents-' | append: group.meaning | append: '-' | append: forloop.index %}\n                  {% render 'card-product', card_product: item.product, section_id: contents_section_id, skip_styles: true, quick_add: 'none', show_vendor: false, show_rating: false, show_secondary_image: false, extend_height: false, rhino_contents_context: true %}\n                {% else %}\n                  <span>{{ item.label | escape }}</span>\n                {% endif %}\n                {% if item.quantity %}<p id=\"ComponentQuantity-{{ section.id }}-{{ group.meaning }}-{{ forloop.index }}\">{{ 'products.product.machine_facts.quantity' | t: count: item.quantity }}</p>{% endif %}\n              </li>\n            {% endfor %}\n          </ul>\n        </section>\n      {% endif %}\n    {% endfor %}\n  </section>\n{%- endif -%}\n{%- endif -%}\n"
    },
    {
      "path": "snippets/rhino-machine-contextual.liquid",
      "sha256": "da07184dd3b1b621d2980b50c2e2aed9d40ce6ec75414d31eb48d0566437fe0b",
      "body": "{%- if request.host == 'machine.local' and projection.fixture_only and projection.contextual.size > 0 -%}\n  {{ 'component-card.css' | asset_url | stylesheet_tag }}\n  <section class=\"rhino-machine-facts rhino-machine-contextual\" aria-labelledby=\"MachineContext-{{ section.id }}\">\n    <h2 id=\"MachineContext-{{ section.id }}\">{{ 'products.product.machine_context.heading' | t }}</h2>\n    <ul class=\"rhino-machine-contents-list\" role=\"list\">\n      {% for item in projection.contextual %}\n        {% assign context_id = section.id | append: '-context-' | append: forloop.index %}\n        <li class=\"rhino-machine-component\" aria-describedby=\"Relationship-{{ context_id }} Scope-{{ context_id }}\">\n          <h3 id=\"Relationship-{{ context_id }}\">{% assign label_key = 'products.product.machine_context.' | append: item.meaning %}{{ label_key | t }}</h3>\n          {% render 'card-product', card_product: item.product, section_id: context_id, skip_styles: true, quick_add: 'none', show_vendor: false, show_rating: false, show_secondary_image: false, extend_height: false, rhino_contents_context: true %}\n          <p id=\"Scope-{{ context_id }}\">{{ item.scope | escape }}</p>\n        </li>\n      {% endfor %}\n    </ul>\n  </section>\n{%- endif -%}\n"
    },
    {
      "path": "snippets/rhino-machine-delivery.liquid",
      "sha256": "1703a28753259ec81943fabafe89d883cf9ef975f12db9c337f66bc926a18ff9",
      "body": "{%- if request.host == 'machine.local' and projection.fixture_only -%}\n  {%- if projection.delivery.size > 0 or projection.policy -%}\n    <section class=\"rhino-machine-facts rhino-machine-delivery\" aria-labelledby=\"MachineDelivery-{{ section.id }}\">\n      <h2 id=\"MachineDelivery-{{ section.id }}\">{{ 'products.product.machine_delivery.heading' | t }}</h2>\n      {% if projection.delivery.size > 0 %}<dl>\n        {% for item in projection.delivery %}\n          <div class=\"rhino-machine-fact-row\">\n            <dt>{% assign label_key = 'products.product.machine_delivery.' | append: item.kind %}{{ label_key | t }}</dt>\n            <dd>{% if item.kind == 'timing' %}\n              {% assign event_key = 'products.product.machine_delivery.' | append: item.value.event %}\n              {% assign unit_key = 'products.product.machine_delivery.' | append: item.value.unit %}\n              {{ event_key | t }}: {{ item.value.min | escape }}–{{ item.value.max | escape }} {{ unit_key | t }}\n            {% else %}\n              {% assign permission_key = 'products.product.machine_delivery.' | append: item.value.permission %}\n              {% assign kind_key = 'products.product.machine_delivery.' | append: item.value.kind %}\n              {% if item.value.kind == 'policy' %}{% assign kind_key = 'products.product.machine_delivery.policy_region' %}{% endif %}\n              {{ kind_key | t }} — {{ permission_key | t }}: {{ item.value.country | escape }}{% if item.value.subdivision %} / {{ item.value.subdivision | escape }}{% endif %}\n            {% endif %}<span class=\"rhino-machine-fact-context\">{{ item.scope | escape }}</span></dd>\n          </div>\n        {% endfor %}\n      </dl>{% endif %}\n      {% if projection.policy %}<a class=\"link underlined-link\" href=\"{{ projection.policy | escape }}\">{{ 'products.product.machine_delivery.policy' | t }}</a>{% endif %}\n    </section>\n  {%- endif -%}\n{%- endif -%}\n"
    },
    {
      "path": "snippets/rhino-machine-resources.liquid",
      "sha256": "0726da0a37eb47db309a4d3f376554b1c3ddf120091393933f1ab244960c7018",
      "body": "{%- if request.host == 'machine.local' and projection.fixture_only and projection.resources.size > 0 -%}\n  <section class=\"rhino-machine-facts rhino-machine-resources\" aria-labelledby=\"MachineResources-{{ section.id }}\">\n    <h2 id=\"MachineResources-{{ section.id }}\">{{ 'products.product.machine_resources.heading' | t }}</h2>\n    <ul class=\"rhino-machine-resource-list\">\n      {% for resource in projection.resources %}\n        {% assign type_key = 'products.product.machine_resources.' | append: resource.type %}\n        <li>\n          <span id=\"ResourceType-{{ section.id }}-{{ forloop.index }}\">{{ type_key | t }}</span>\n          {% if resource.type == 'video' %}\n            <deferred-media class=\"rhino-machine-resource-video\" style=\"aspect-ratio: {{ resource.video.width }} / {{ resource.video.height }};\">\n              <button id=\"Deferred-Poster-resource-{{ section.id }}-{{ forloop.index }}\" class=\"button button--secondary\" type=\"button\" aria-describedby=\"ResourceType-{{ section.id }}-{{ forloop.index }}\">\n                {{ 'products.product.machine_resources.load_video' | t }}: {{ resource.title | escape }}\n              </button>\n              <template>\n                <iframe src=\"{{ resource.video.embed_url | escape }}\" title=\"{{ resource.title | escape }}\" width=\"{{ resource.video.width }}\" height=\"{{ resource.video.height }}\" allowfullscreen></iframe>\n              </template>\n            </deferred-media>\n          {% else %}\n            <a class=\"link underlined-link\" href=\"{{ resource.url | escape }}\" aria-describedby=\"ResourceType-{{ section.id }}-{{ forloop.index }}\">{{ resource.title | escape }}</a>\n          {% endif %}\n        </li>\n      {% endfor %}\n    </ul>\n  </section>\n{%- endif -%}\n"
    },
    {
      "path": "snippets/rhino-machine-specifications.liquid",
      "sha256": "39ed3f9e1968db38d373ebf56c6c96b0ba2c1cefc2a16128a41dcbb0a42f4e74",
      "body": "{%- if request.host == 'machine.local' and projection.fixture_only -%}\n{%- if projection.key_specs.size > 0 -%}\n  <section class=\"rhino-machine-facts\" aria-labelledby=\"MachineKeySpecs-{{ section.id }}\">\n    <h2 id=\"MachineKeySpecs-{{ section.id }}\">{{ 'products.product.machine_facts.key' | t }}</h2>\n    <dl>{% for row in projection.key_specs %}{% render 'rhino-machine-specification-row', row: row %}{% endfor %}</dl>\n  </section>\n{%- endif -%}\n{%- if projection.spec_groups.size > 0 -%}\n  <section class=\"rhino-machine-facts\" aria-labelledby=\"MachineSpecs-{{ section.id }}\">\n    <h2 id=\"MachineSpecs-{{ section.id }}\">{{ 'products.product.machine_facts.details' | t }}</h2>\n    {% for group in projection.spec_groups %}\n      {% if group.rows.size > 0 %}\n        <h3>{{ group.label_key | t }}</h3>\n        <dl>{% for row in group.rows %}{% render 'rhino-machine-specification-row', row: row %}{% endfor %}</dl>\n      {% endif %}\n    {% endfor %}\n  </section>\n{%- endif -%}\n{%- endif -%}\n"
    },
    {
      "path": "snippets/rhino-machine-support.liquid",
      "sha256": "9226eeee5163438988478d985782a25d6facc8354b4cc67a376009989fe24b1f",
      "body": "{%- if request.host == 'machine.local' and projection.fixture_only and projection.warranty.size > 0 -%}\n  <section class=\"rhino-machine-facts rhino-machine-support\" aria-labelledby=\"MachineSupport-{{ section.id }}\">\n    <h2 id=\"MachineSupport-{{ section.id }}\">{{ 'products.product.machine_support.heading' | t }}</h2>\n    {% for warranty in projection.warranty %}\n      <dl>\n        {% for role in warranty.roles %}\n          {% if role[1] %}\n            <div class=\"rhino-machine-fact-row\">\n              {% assign role_key = 'products.product.machine_support.' | append: role[0] %}\n              <dt>{{ role_key | t }}</dt><dd>{{ role[1] | escape }}</dd>\n            </div>\n          {% endif %}\n        {% endfor %}\n        {% if warranty.duration %}\n          <div class=\"rhino-machine-fact-row\">\n            <dt>{{ 'products.product.machine_support.duration' | t }}</dt>\n            {% assign unit_key = 'products.product.machine_support.' | append: warranty.duration.unit %}\n            <dd>{{ warranty.duration.value | escape }} {{ unit_key | t }}</dd>\n          </div>\n        {% endif %}\n        <div class=\"rhino-machine-fact-row\"><dt>{{ 'products.product.machine_support.trigger' | t }}</dt><dd>{{ warranty.trigger | escape }}</dd></div>\n        {% if warranty.exclusions.size > 0 %}\n          <div class=\"rhino-machine-fact-row\"><dt>{{ 'products.product.machine_support.exclusions' | t }}</dt><dd><ul>{% for line in warranty.exclusions %}<li>{{ line | escape }}</li>{% endfor %}</ul></dd></div>\n        {% endif %}\n        {% if warranty.exceptions.size > 0 %}\n          <div class=\"rhino-machine-fact-row\"><dt>{{ 'products.product.machine_support.exceptions' | t }}</dt><dd><ul>{% for line in warranty.exceptions %}<li>{{ line | escape }}</li>{% endfor %}</ul></dd></div>\n        {% endif %}\n      </dl>\n      {% if warranty.destination %}<a class=\"link underlined-link\" href=\"{{ warranty.destination | escape }}\">{{ 'products.product.machine_support.destination' | t }}</a>{% endif %}\n    {% endfor %}\n  </section>\n{%- endif -%}\n"
    },
