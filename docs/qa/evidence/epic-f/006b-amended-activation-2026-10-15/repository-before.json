    {
      "path": "snippets/rhino-product-structured-data.liquid",
      "sha256": "2ea5c3cc0f467b4ca9e14a4802622adb035b782b4c9a4e2fbc723e8864dcad5c",
      "body": "{%- comment -%}\n  F1: native commerce identity only for contained Products. No description,\n  Vendor-derived responsibility, technical values or unreviewed media.\n  The calling section owns the single script element.\n{%- endcomment -%}\n{%- capture consumer_route -%}{%- render 'rhino-product-consumer-route', product: product -%}{%- endcapture -%}\n{%- if consumer_route == 'replacement_part' or consumer_route == 'consumable' or consumer_route == 'accessory' -%}\n  {{ product | structured_data }}\n{%- else -%}\n  {%- assign product_url = product.url | prepend: request.origin -%}\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Product\",\n    \"@id\": {{ product_url | append: '#product' | json | replace: '<', '\\u003c' }},\n    \"productID\": {{ product.id | prepend: 'gid://shopify/Product/' | json }},\n    \"name\": {{ product.title | json | replace: '<', '\\u003c' }},\n    \"url\": {{ product_url | json | replace: '<', '\\u003c' }},\n    \"offers\": [\n      {%- for variant in product.variants -%}\n        {%- assign variant_url = variant.url | prepend: request.origin -%}\n        {\n          \"@type\": \"Offer\",\n          \"@id\": {{ variant_url | append: '#offer' | json | replace: '<', '\\u003c' }},\n          \"url\": {{ variant_url | json | replace: '<', '\\u003c' }},\n          \"identifier\": {{ variant.id | prepend: 'gid://shopify/ProductVariant/' | json }},\n          \"price\": {{ variant.price | divided_by: 100.0 | json }},\n          \"priceCurrency\": {{ cart.currency.iso_code | json }},\n          \"availability\": \"https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}\"\n        }{% unless forloop.last %},{% endunless %}\n      {%- endfor -%}\n    ]\n  }\n{%- endif -%}\n"
    },
    {
      "path": "snippets/rhino-product-support-resources-projection.liquid",
