    {
      "path": "schemas/epic-e-completed-owner-responses.schema.json",
      "sha256": "56237924bf163b521ff33e7f102d0aa05c1e8d2f8e67c3919d63fba20acd72d0",
      "body": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Bounded completed team worksheet responses owned by Epic E\",\n  \"type\": \"object\",\n  \"required\": [\"schemaVersion\", \"authority\", \"source\", \"approvalMode\", \"rows\", \"holds\", \"contents\", \"resolvedCompatibilityEdges\", \"resourceOwnerEvidence\", \"gritHandoff\"],\n  \"properties\": {\n    \"schemaVersion\": {\"const\": 1},\n    \"authority\": {\"const\": \"COMPLETED_TEAM_WORKSHEET_ACCEPTED_IN_AUTHORIZED_DEVELOPMENT_TASK\"},\n    \"approvalMode\": {\"const\": \"delegated_development_override\"},\n    \"source\": {\"type\": \"object\", \"required\": [\"path\", \"sha256\"], \"properties\": {\"path\": {\"const\": \"docs/project/completed-worksheet-decisions-transcribed.md\"}, \"sha256\": {\"type\": \"string\", \"pattern\": \"^[a-f0-9]{64}$\"}}},\n    \"rows\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"rowId\", \"kind\", \"targetGid\", \"domain\", \"planId\", \"field\", \"type\", \"desired\", \"valueState\", \"approvalDecisionId\", \"conflictIds\", \"sourceExcerpt\"],\n        \"properties\": {\n          \"kind\": {\"const\": \"value\"},\n          \"targetGid\": {\"type\": \"string\", \"pattern\": \"^gid://shopify/Product/[0-9]+$\"},\n          \"domain\": {\"enum\": [\"electrical\", \"motor_speed\", \"tool_mount\", \"water_fluid\", \"durable_measurements\", \"crate_measurements\", \"compatibility\", \"included_components\", \"optional_components\"]},\n          \"planId\": {\"type\": \"string\", \"pattern\": \"^E-MUT-0(2[6-9]|3[01456])$\"},\n          \"field\": {\"type\": \"string\", \"pattern\": \"^PRODUCT\\\\.metafields\\\\.rhino\\\\.[a-z_]+$\"},\n          \"valueState\": {\"const\": \"approved\"},\n          \"approvalDecisionId\": {\"type\": \"string\", \"pattern\": \"^TEAM-WORKSHEET:[a-f0-9]{64}$\"},\n          \"conflictIds\": {\"type\": \"array\", \"maxItems\": 0},\n          \"sourceExcerpt\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"holds\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"productGid\", \"field\", \"reason\"]}},\n    \"resourceOwnerEvidence\": {\"type\": \"object\", \"properties\": {\"publicationApproved\": {\"const\": false}, \"languageApproved\": {\"const\": false}, \"currentVersionApproved\": {\"const\": false}, \"customerActivation\": {\"const\": false}}},\n    \"gritHandoff\": {\"type\": \"object\", \"properties\": {\"valueExecution\": {\"const\": false}}}\n  }\n}\n"
