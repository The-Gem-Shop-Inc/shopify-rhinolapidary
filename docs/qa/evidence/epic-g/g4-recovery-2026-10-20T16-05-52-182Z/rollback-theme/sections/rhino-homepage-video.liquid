{%- comment -%}
  Rhino section pattern: video

  Homepage-only click-to-load external video. The Shopify-hosted poster is
  the only media eligible to load before deliberate activation. The iframe
  remains inert inside a template until the existing deferred-media custom
  element clones it after a button activation.
{%- endcomment -%}

{%- liquid
  assign video_id = section.settings.video_url.id
  assign poster = section.settings.cover_image
-%}

{%- style -%}
  #RhinoHomepageVideo-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__heading {
    margin: 0 0 1.6rem;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__text {
    max-width: 68rem;
    margin-bottom: 2.4rem;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__media {
    position: relative;
    display: block;
    width: 100%;
    max-width: 96rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgb(var(--color-foreground), 0.04);
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__poster,
  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__poster {
    display: block;
    padding: 0;
    cursor: pointer;
    background: transparent;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__poster-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 6.4rem;
    height: 6.4rem;
    place-items: center;
    color: rgb(var(--color-button-text));
    background: rgb(var(--color-button));
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__play .svg-wrapper {
    width: 2.4rem;
    height: 2.4rem;
  }

  #RhinoHomepageVideo-{{ section.id }} .rhino-homepage-video__privacy {
    margin: 1.2rem 0 0;
    font-size: 1.3rem;
  }

  #RhinoHomepageVideo-{{ section.id }} deferred-media[loaded] .rhino-homepage-video__poster {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #RhinoHomepageVideo-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="RhinoHomepageVideo-{{ section.id }}"
  class="rhino-section rhino-homepage-video color-{{ section.settings.color_scheme }} gradient"
  data-homepage-module-id="homepage-video-demo"
  data-rhino-pattern-id="video"
  data-rhino-section-pattern="video"
  data-video-id="{{ video_id | escape }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="rhino-homepage-video__heading h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.supporting_text != blank -%}
      <div class="rhino-homepage-video__text rte">{{ section.settings.supporting_text }}</div>
    {%- endif -%}

    {%- if video_id != blank and poster != blank -%}
      <deferred-media class="rhino-homepage-video__media" data-media-id="{{ video_id | escape }}">
        <button
          id="Deferred-Poster-Homepage-{{ section.id }}"
          class="rhino-homepage-video__poster"
          type="button"
          aria-label="{{ section.settings.play_label | escape }}"
        >
          <img
            class="rhino-homepage-video__poster-image"
            data-rhino-video-poster
            data-src="{{ poster | image_url: width: 1280 }}"
            data-srcset="{{ poster | image_url: width: 375 }} 375w, {{ poster | image_url: width: 550 }} 550w, {{ poster | image_url: width: 750 }} 750w, {{ poster | image_url: width: 960 }} 960w, {{ poster | image_url: width: 1280 }} 1280w"
            sizes="(min-width: 990px) 960px, calc(100vw - 3rem)"
            width="{{ poster.width }}"
            height="{{ poster.height }}"
            alt=""
            loading="lazy"
          >
          <span class="rhino-homepage-video__play motion-reduce" aria-hidden="true">
            <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
          </span>
        </button>
        <template>
          <iframe
            src="https://www.youtube-nocookie.com/embed/{{ video_id }}?rel=0"
            title="{{ section.settings.video_title | escape }}"
            allow="encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </template>
      </deferred-media>
      {%- if section.settings.privacy_notice != blank -%}
        <p class="rhino-homepage-video__privacy">{{ section.settings.privacy_notice | escape }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.video.name",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "t:sections.rhino_homepage_links.settings.supporting_text.label"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube"],
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "t:sections.video.settings.description.label"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "t:sections.video.settings.description.info"
    },
    {
      "type": "text",
      "id": "privacy_notice",
      "label": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [{ "name": "t:sections.video.presets.name" }]
}
{% endschema %}
