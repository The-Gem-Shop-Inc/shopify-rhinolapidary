{%- comment -%}
  Rhino section pattern: homepage-link-group

  Lightweight homepage-only link group.
  Used when stock Trade sections add unnecessary request overhead for
  simple governed headings and destination links.

  This section never owns the page h1.
{%- endcomment -%}

{%- style -%}
    #RhinoHomepageLinks-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__heading {
    margin: 0 0 2.4rem;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__text {
    max-width: 68rem;
    margin-bottom: 2.4rem;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__item {
    min-width: 0;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__item-heading {
    margin: 0 0 0.8rem;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__item-text {
    margin-bottom: 1rem;
    }

    @media screen and (min-width: 750px) {
    #RhinoHomepageLinks-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #RhinoHomepageLinks-{{ section.id }} .rhino-homepage-links__list {
    grid-template-columns: repeat(
    {{ section.settings.columns_desktop }},
    minmax(0, 1fr)
    );
    }
    }
{%- endstyle -%}

<section
        id="RhinoHomepageLinks-{{ section.id }}"
        class="rhino-section rhino-homepage-links color-{{ section.settings.color_scheme }} gradient"
        {% if section.settings.module_id != blank %}
            data-homepage-module-id="{{ section.settings.module_id | escape }}"
        {% endif %}
        data-rhino-pattern-id="homepage-link-group"
        data-rhino-section-pattern="homepage-link-group"
>
    <div class="page-width">
        {%- if section.settings.heading != blank -%}
            <h2 class="rhino-homepage-links__heading h2">
                {{ section.settings.heading }}
            </h2>
        {%- endif -%}

        {%- if section.settings.supporting_text != blank -%}
            <div class="rhino-homepage-links__text rte">
                {{ section.settings.supporting_text }}
            </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
            <ul class="rhino-homepage-links__list" role="list">
                {%- for block in section.blocks -%}
                    <li
                            class="rhino-homepage-links__item"
                            {{ block.shopify_attributes }}
                    >
                        {%- if block.settings.title != blank -%}
                            <h3 class="rhino-homepage-links__item-heading h3">
                                {{ block.settings.title }}
                            </h3>
                        {%- endif -%}

                        {%- if block.settings.text != blank -%}
                            <div class="rhino-homepage-links__item-text rte">
                                {{ block.settings.text }}
                            </div>
                        {%- endif -%}

                        {%- if block.settings.link_label != blank -%}
                            <a
                                    {% if block.settings.link == blank %}
                                        role="link"
                                        aria-disabled="true"
                                    {% else %}
                                        href="{{ block.settings.link }}"
                                    {% endif %}
                                    class="link animate-arrow"
                            >
                                {{ block.settings.link_label | escape }}
                                {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </a>
                        {%- endif -%}
                    </li>
                {%- endfor -%}
            </ul>
        {%- endif -%}
    </div>
</section>

{% schema %}
{
  "name": "t:sections.rhino_homepage_links.name",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "module_id",
      "label": "t:sections.rhino_homepage_links.settings.module_id.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.rhino_homepage_links.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "t:sections.rhino_homepage_links.settings.supporting_text.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.rhino_homepage_links.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.rhino_homepage_links.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.rhino_homepage_links.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.rhino_homepage_links.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:sections.rhino_homepage_links.blocks.link.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.rhino_homepage_links.blocks.link.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.rhino_homepage_links.blocks.link.settings.text.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.rhino_homepage_links.blocks.link.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.rhino_homepage_links.blocks.link.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rhino_homepage_links.presets.name"
    }
  ]
}
{% endschema %}