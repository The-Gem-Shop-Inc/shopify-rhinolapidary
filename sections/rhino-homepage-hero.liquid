{%- comment -%}
  Rhino section pattern: homepage-hero

  Homepage-only first-screen gateway.
  Restricted to the index template by schema.enabled_on.
  This section intentionally owns the page's single semantic h1.

  Copy, media, and routes are governed by the Epic D homepage registers.
{%- endcomment -%}

{%- style -%}
    #RhinoHomepageHero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.4rem, 5vw, 6rem);
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__content {
    min-width: 0;
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__heading {
    margin-top: 0;
    margin-bottom: 1.6rem;
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__text {
    max-width: 68rem;
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__media {
    display: flex;
    justify-content: center;
    min-width: 0;
    }

    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__image {
    display: block;
    width: 100%;
    max-width: 55rem;
    height: auto;
    object-fit: contain;
    }

    @media screen and (min-width: 750px) {
    #RhinoHomepageHero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    }

    @media screen and (min-width: 990px) {
    #RhinoHomepageHero-{{ section.id }} .rhino-homepage-hero__grid {
    grid-template-columns: minmax(0, 1fr) minmax(28rem, 55rem);
    }
    }
{%- endstyle -%}

<section
        id="RhinoHomepageHero-{{ section.id }}"
        class="rhino-section rhino-homepage-hero color-{{ section.settings.color_scheme }} gradient"
        data-homepage-module-id="homepage-first-screen-gateway"
        data-rhino-pattern-id="homepage-hero"
        data-rhino-section-pattern="homepage-hero"
>
    <div class="page-width">
        <div class="rhino-homepage-hero__grid">
            <div class="rhino-homepage-hero__content">
                {%- if section.settings.heading != blank -%}
                    <h1 class="rhino-homepage-hero__heading h1">
                        {{ section.settings.heading }}
                    </h1>
                {%- endif -%}

                {%- if section.settings.text != blank -%}
                    <div class="rhino-homepage-hero__text rte">
                        {{ section.settings.text }}
                    </div>
                {%- endif -%}

                {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
                    <div class="rhino-homepage-hero__actions">
                        {%- if section.settings.primary_label != blank -%}
                            <a
                                    class="button button--primary"
                                    {% if section.settings.primary_link == blank %}
                                        role="link"
                                        aria-disabled="true"
                                    {% else %}
                                        href="{{ section.settings.primary_link }}"
                                    {% endif %}
                            >
                                {{ section.settings.primary_label | escape }}
                            </a>
                        {%- endif -%}

                        {%- if section.settings.secondary_label != blank -%}
                            <a
                                    class="button button--secondary"
                                    {% if section.settings.secondary_link == blank %}
                                        role="link"
                                        aria-disabled="true"
                                    {% else %}
                                        href="{{ section.settings.secondary_link }}"
                                    {% endif %}
                            >
                                {{ section.settings.secondary_label | escape }}
                            </a>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            </div>

            {%- if section.settings.image != blank -%}
                {%- assign hero_alt = section.settings.image_alt | default: section.settings.image.alt -%}
                <div class="rhino-homepage-hero__media">
                    {{
                    section.settings.image
                    | image_url: width: 550
                    | image_tag:
                    widths: '375, 550',
                    sizes: '(min-width: 990px) 550px, calc(100vw - 3rem)',
                    width: section.settings.image.width,
                    height: section.settings.image.height,
                    alt: hero_alt,
                    loading: 'eager',
                    fetchpriority: 'high',
                    class: 'rhino-homepage-hero__image'
                    }}
                </div>
            {%- endif -%}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "t:sections.rhino_homepage_hero.name",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.rhino_homepage_hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.rhino_homepage_hero.settings.image_alt.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.rhino_homepage_hero.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.rhino_homepage_hero.settings.text.label"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.rhino_homepage_hero.settings.primary_label.label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.rhino_homepage_hero.settings.primary_link.label"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.rhino_homepage_hero.settings.secondary_label.label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.rhino_homepage_hero.settings.secondary_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.rhino_homepage_hero.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.rhino_homepage_hero.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.rhino_homepage_hero.settings.padding_bottom.label",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.rhino_homepage_hero.presets.name"
    }
  ]
}
{% endschema %}